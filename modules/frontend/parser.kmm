module km_compiler

class Parser
public
    constructor(tokens: [Token])
        m_tokens = tokens

    // "LINE:COL" of the token the parser is looking at — where a parse
    // error is reported.
    mut position(): string
        let t = peek()
        return string(t.line) + ":" + string(t.column)
    
    mut parseProgram(): Program
        skipNewlines()
        let prog = new Program()
        while true do
            skipNewlines()
            // a `public` / `private` section label at module top level —
            // its visibility applies to the following declarations until
            // the next label, the next `module` line, or a closing dedent.
            if at(TokenType::IDENT) and (peek().lexeme == "public" or peek().lexeme == "private") then
                m_curVis = peek().lexeme
                eat()
                skipNewlines()
                if at(TokenType::INDENT) then
                    eat()
                    m_secIndent = true
                continue
            if m_secIndent and at(TokenType::DEDENT) then
                eat()
                m_secIndent = false
                m_curVis = "public"
                continue
            if at(TokenType::EOF) then
                break
            if at(TokenType::EXTERN) then
                parseExternInto(prog)
            else if at(TokenType::IDENT) and peek().lexeme == "export" and (peekAt(1).type == TokenType::FN or peekAt(1).type == TokenType::MUT or peekAt(1).type == TokenType::VOID) then
                // `export fn name(...)` — a Komodo function also callable
                // from C / C++.  `export` is a contextual keyword (an
                // ordinary identifier everywhere else).
                eat()               // export
                let xdecl = parseFunction()
                if xdecl.isPrototype or xdecl.ownerClass != null then
                    throw ("`export` needs a free function with a body: '" + xdecl.name + "'")
                xdecl.isExport = true
                stampDecl(xdecl)
                prog.functions += [xdecl]
            else if at(TokenType::FN) or at(TokenType::MUT) or at(TokenType::VOID) then
                let fdecl = parseFunction()
                stampDecl(fdecl)
                if fdecl.ownerClass == null then
                    prog.functions += [fdecl]
                else
                    // `void Class::method(...)` written outside the class
                    m_pendingMethods += [fdecl]
            else if at(TokenType::STRUCT) then
                let sd0 = parseStruct()
                stampDecl(sd0)
                prog.structs += [sd0]
            else if at(TokenType::CLASS) then
                let cd0 = parseClass()
                stampDecl(cd0)
                prog.classes += [cd0]
            else if at(TokenType::ENUM) then
                let ed0 = parseEnum()
                stampDecl(ed0)
                prog.enums += [ed0]
            else if at(TokenType::IDENT) and isTypeModifier(peek().lexeme) then
                // leading type modifiers: `abstract` / `shared` / `unique`
                // before `struct` / `class`.  `shared` is parsed and
                // ignored — ordinary aliasing is the default.  `unique`
                // marks single-owner move semantics (structs only; on a
                // class it is accepted and ignored).
                let isAbs = false
                let isUniq = false
                while at(TokenType::IDENT) and isTypeModifier(peek().lexeme) do
                    if peek().lexeme == "abstract" then
                        isAbs = true
                    else if peek().lexeme == "unique" then
                        isUniq = true
                    eat()
                if at(TokenType::STRUCT) then
                    let sd = parseStruct()
                    sd.isAbstract = isAbs
                    sd.isUnique = isUniq
                    stampDecl(sd)
                    prog.structs += [sd]
                else if at(TokenType::CLASS) then
                    let cd = parseClass()
                    cd.isAbstract = isAbs
                    stampDecl(cd)
                    prog.classes += [cd]
                else
                    throw ("expected `struct` or `class` after type modifier")
            else if at(TokenType::LET) then
                // `let NAME be EXPR` — a compile-time macro; `let NAME
                // [: T] = EXPR` (or a bare `let NAME : T`) — a top-level
                // variable with its own storage.
                let vd = parseVarDecl()
                vd.visMod = m_curVis
                vd.modOwner = m_curModule
                if vd.immutable then
                    prog.macros += [vd]
                else
                    prog.globals += [vd]
            else if at(TokenType::IMPORT) then
                eat()
                eat()
                continue
            else if at(TokenType::MODULE) then
                // `module <name>` — namespaces are flat after the driver
                // merges the imported files; record the name so each
                // declaration below can be attributed to its module.
                eat()
                m_inModule = true
                m_curVis = "public"
                m_secIndent = false
                if not at(TokenType::NEWLINE) and not at(TokenType::EOF) then
                    prog.moduleName = peek().lexeme
                    m_curModule = peek().lexeme
                    eat()
                continue
            else if at(TokenType::LINK) then
                prog.links += [parseLink()]
                continue
            else
                throw ("Unexpected top-level token: " + string(peek().lexeme))
            skipNewlines()

        // Re-attach every `Class::method` body to its class, so the rest
        // of the pipeline sees it exactly as an in-body method.
        for m in m_pendingMethods do
            let cls = findClass(prog, m.ownerClass)
            if cls == null then
                throw ("method defined for unknown class '" + string(m.ownerClass) + "'")
            m.ownerClass = null
            cls.methods += [m]
        return prog

    // Attribute a top-level declaration to the module it was parsed in
    // and the visibility section it sat under.
    mut stampDecl(d: Declaration)
        d.moduleOwner = m_curModule
        d.visibility = m_curVis

    mut findClass(prog: Program, name: string?): ClassDecl?
        for c in prog.classes do
            if c.name == name then
                return c
        return null

    // A bare identifier that may lead a `struct` / `class` declaration.
    fn isTypeModifier(lexeme: string): bool
        return lexeme == "abstract" or lexeme == "shared" or lexeme == "unique"
private
    m_tokens: [Token]
    m_pos: int = 0
    // `Class::method` bodies collected during the top-level sweep and
    // re-attached to their classes once parsing finishes.
    m_pendingMethods: [FunctionDecl] = []
    // true from the first `module <name>` line seen onward — `link` is
    // only legal in a module, and files are concatenated whole (each
    // one's own lines stay in order), so this is correct per file even
    // though the parser runs over the merged token stream.
    m_inModule: bool = false
    // module name + visibility section currently in effect during the
    // top-level sweep (see `stampDecl`).
    m_curModule: string = ""
    m_curVis: string = "public"
    m_secIndent: bool = false
            
    mut peek(): Token
        if m_pos >= #m_tokens then
            return m_tokens[#m_tokens - 1]
        return m_tokens[m_pos]

    // `n` tokens ahead of the cursor, clamped to the trailing EOF token.
    mut peekAt(n: int): Token
        let i = m_pos + n
        if i >= #m_tokens then
            return m_tokens[#m_tokens - 1]
        return m_tokens[i]

    // First character of `s` is an ASCII uppercase letter (the naming
    // convention for every struct / class / enum type).
    mut startsUpper(s: string): bool
        if #s == 0 then
            return false
        let up = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        let c = s[0]
        let i = 0
        while i < #up do
            if up[i] == c then
                return true
            i += 1
        return false

    mut eat(): Token
        let t = peek()
        if m_pos < #m_tokens - 1 then
            m_pos += 1
        return t

    mut at(type: TokenType): bool
        return peek().type == type

    mut void skipNewlines()
        while at(TokenType::NEWLINE) do
            eat()

    mut parseParams(): [Param]
        let params: [Param] = []
        while not at(TokenType::CLOSE_PAREN) and not at(TokenType::EOF) do
            // `...` — a variadic marker (three DOT tokens), recorded as a
            // pseudo-parameter named "..." and stripped by the caller.
            if at(TokenType::DOT) then
                while at(TokenType::DOT) do
                    eat()
                params += [new Param("...", null)]
                if at(TokenType::COMMA) then
                    eat()
                continue
            let pname = peek().lexeme
            eat()
            let ptype: string? = null
            if at(TokenType::COLON) then
                eat()
                ptype = parseType()
            // `name: T = default` — the default is an expression, checked
            // by the analyser (a literal, trailing parameters only).
            let pdefault: Expression? = null
            if at(TokenType::EQUALS) then
                eat()
                pdefault = parseExpression()
            let param = new Param(pname, ptype)
            param.defaultValue = pdefault
            params += [param]
            if at(TokenType::COMMA) then
                eat()
        return params

    // A declared type is carried as a string: "int", "[Token]", and now
    // "int?" / "[Token]?" — a trailing "?" marks the type nullable and is
    // kept so the semantic analyser can enforce null-safety.  Codegen
    // strips it (see `stripOpt` in types.kmm) since its lowering never
    // depended on nullability.
    mut parseType(): string
        if at(TokenType::OPEN_BRACKET) then
            eat()
            let inner = parseType()
            if at(TokenType::CLOSE_BRACKET) then
                eat()
            let arr = "[" + inner + "]"
            if at(TokenType::QUESTION) then
                eat()
                arr = arr + "?"
            return arr
        let name = peek().lexeme
        eat()
        if at(TokenType::QUESTION) then
            eat()
            name = name + "?"
        return name

    // Foreign declarations.  Three forms:
    //
    //   extern fn name(params): T          — a single C prototype
    //   extern void name(params)
    //   extern type Name                   — an opaque pointer-sized handle
    //
    //   extern "SDL2"                       — a block: one library, many
    //       type SDL_Window                   declarations, no repeated
    //       fn SDL_CreateWindow(...): SDL_Window   `extern` / `fn` noise.
    //       void SDL_DestroyWindow(w: SDL_Window)
    //
    // The block header string names what to link: a bare library (`"SDL2"`
    // → `-lSDL2`) or a companion path (`"vendor/foo.c"`, kept as-is).  It
    // is recorded as a `LinkDecl` so the driver links it automatically —
    // and, unlike the `link` keyword, a block `extern` needs no enclosing
    // `module`, so a one-off program can bind a C library inline.
    mut parseExternInto(prog: Program)
        eat()                       // extern
        if at(TokenType::STRING) then
            let lexeme = peek().lexeme
            eat()
            let target = lexeme[1 to (lexeme.length - 1)]
            prog.links += [new LinkDecl(target, externLibIsPath(target))]
            skipNewlines()
            if at(TokenType::INDENT) then
                eat()
                while not at(TokenType::DEDENT) and not at(TokenType::EOF) do
                    skipNewlines()
                    if at(TokenType::DEDENT) or at(TokenType::EOF) then
                        break
                    parseExternMemberInto(prog)
                    skipNewlines()
                if at(TokenType::DEDENT) then
                    eat()
            return
        parseExternMemberInto(prog)

    // One foreign declaration — `fn` / `void` prototype or `type` handle —
    // with the leading `extern` (or block indent) already consumed.
    mut parseExternMemberInto(prog: Program)
        if at(TokenType::LET) then
            // `extern let name: T [= "sym"]` — a C global variable
            eat()                   // let
            let vname = peek().lexeme
            eat()
            if not at(TokenType::COLON) then
                throw ("extern variable '" + vname + "' needs a type: `extern let " + vname + ": int`")
            eat()
            let vtype = parseType()
            let vsym: string? = null
            if at(TokenType::EQUALS) then
                eat()
                if not at(TokenType::STRING) then
                    throw ("expected a string literal after `=` (the C symbol name) in extern variable '" + vname + "'")
                let vsl = peek().lexeme
                eat()
                vsym = vsl[1 to (vsl.length - 1)]
                if #(vsym or "") == 0 then
                    throw ("extern variable '" + vname + "': the C symbol name after `=` is empty")
            skipNewlines()
            let vd = new VarDecl(vname)
            vd.declaredType = vtype
            vd.isExtern = true
            vd.symbol = vsym
            prog.globals += [vd]
            return
        if at(TokenType::IDENT) and peek().lexeme == "type" then
            eat()                   // type
            let name = peek().lexeme
            eat()
            if at(TokenType::COLON) then
                // `extern type Fd : int` — an explicit base is accepted and
                // ignored; every handle is one pointer-sized machine word.
                eat()
                parseType()
            skipNewlines()
            let sd = new StructDecl(name)
            sd.isExtern = true
            prog.structs += [sd]
            return
        let isVoid = at(TokenType::VOID)
        eat()                       // fn | void
        let name = peek().lexeme
        eat()
        eat()                       // (
        let params = parseParams()
        eat()                       // )
        let returnType: string? = null
        if at(TokenType::COLON) then
            eat()
            returnType = parseType()
        // `= "sym"` — bind a C symbol whose name differs from `name`
        let symbol: string? = null
        if at(TokenType::EQUALS) then
            eat()
            if not at(TokenType::STRING) then
                throw ("expected a string literal after `=` (the C symbol name) in extern '" + name + "'")
            let sl = peek().lexeme
            eat()
            symbol = sl[1 to (sl.length - 1)]
            if #(symbol or "") == 0 then
                throw ("extern '" + name + "': the C symbol name after `=` is empty")
        skipNewlines()
        let decl = new FunctionDecl(name)
        decl.params = trimVariadic(params)
        decl.variadic = paramsAreVariadic(params)
        decl.returnType = returnType
        decl.isVoid = isVoid
        decl.symbol = symbol
        decl.isExtern = true
        prog.functions += [decl]

    // How a block-`extern` header string should reach the linker: a path /
    // flag is passed through as-is (`isPath`), a bare name becomes `-lname`.
    fn externLibIsPath(s: string): bool
        if #s == 0 then
            return false
        if s[0] == "-" or s[0] == "/" or s[0] == "." then
            return true
        let i = 0
        while i < #s do
            if s[i] == "/" or s[i] == "." then
                return true
            i += 1
        return false

    mut parseFunction(): FunctionDecl
        let fnLine = peek().line
        let fnCol = peek().column
        // one or two leading keywords: `fn` / `void` / `mut`, and the
        // combination `mut void` (a mutating procedure).
        let isVoid = false
        let isMut = false
        while at(TokenType::FN) or at(TokenType::VOID) or at(TokenType::MUT) do
            if at(TokenType::VOID) then
                isVoid = true
            if at(TokenType::MUT) then
                isMut = true
            eat()

        let name = peek().lexeme
        eat()

        // `void Codegen::genExpr(e)` — a method body written outside its
        // class.  The name before `::` is the owning class; `parseProgram`
        // re-attaches the decl to that class.
        let owner: string? = null
        if at(TokenType::SCOPE) then
            eat()
            owner = name
            name = peek().lexeme
            eat()

        eat()                       // (

        let params = parseParams()

        eat()                       // )

        let returnType: string? = null
        if at(TokenType::COLON) then
            eat()
            returnType = parseType()

        skipNewlines()

        // A body-less `fn name(params): T` is a prototype — the signature
        // is declared here, the definition is linked in (this is how the
        // standard-library modules declare themselves).
        let body: [Statement] = []
        let isProto = true
        if at(TokenType::INDENT) then
            eat()
            isProto = false
            body = parseStatements()
            skipNewlines()
            if at(TokenType::DEDENT) then
                eat()

        let decl = new FunctionDecl(name)
        decl.line = fnLine
        decl.column = fnCol
        decl.params = trimVariadic(params)
        decl.variadic = paramsAreVariadic(params)
        decl.body = body
        decl.isVoid = isVoid
        decl.isMut = isMut
        decl.isPrototype = isProto and owner == null
        decl.returnType = returnType
        decl.ownerClass = owner
        return decl

    // A `...` in the parameter list makes the function variadic; it is
    // not itself a real parameter.
    mut paramsAreVariadic(params: [Param]): bool
        for p in params do
            if p.name == "..." then
                return true
        return false

    mut trimVariadic(params: [Param]): [Param]
        let out: [Param] = []
        for p in params do
            if p.name != "..." then
                out += [p]
        return out

    mut parseStruct(): StructDecl
        eat()
        let name = peek().lexeme
        eat()
        let parent: string? = null
        if at(TokenType::COLON) then
            eat()
            parent = peek().lexeme
            eat()
        skipNewlines()

        // An `abstract` base can have an empty body (no members) — then no
        // INDENT follows and the member loop must be skipped entirely.
        let members: [StructMember] = []
        if at(TokenType::INDENT) then
            eat()
            while not at(TokenType::DEDENT) and not at(TokenType::EOF) do
                skipNewlines()
                if at(TokenType::DEDENT) or at(TokenType::EOF) then
                    break
                if at(TokenType::FN) or at(TokenType::MUT) or at(TokenType::VOID) or at(TokenType::CONSTRUCTOR) then
                    throw "struct bodies hold fields only; use a class for methods"
                let memberName = peek().lexeme
                eat()
                if at(TokenType::COLON) then
                    eat()
                let memberType = parseType()
                let mdefault: Expression? = null
                if at(TokenType::EQUALS) then
                    eat()
                    mdefault = parseExpression()
                let sm = new StructMember(memberName, memberType)
                sm.defaultValue = mdefault
                members += [sm]
                skipNewlines()
            if at(TokenType::DEDENT) then
                eat()

        let decl = new StructDecl(name)
        decl.members = members
        decl.parent = parent
        return decl

    // `enum Name` then an indented list of bare variant names.
    mut parseEnum(): EnumDecl
        eat()                       // enum
        let name = peek().lexeme
        eat()
        skipNewlines()
        let variants: [string] = []
        if at(TokenType::INDENT) then
            eat()
            while not at(TokenType::DEDENT) and not at(TokenType::EOF) do
                skipNewlines()
                if at(TokenType::DEDENT) or at(TokenType::EOF) then
                    break
                variants += [peek().lexeme]
                eat()
                skipNewlines()
            if at(TokenType::DEDENT) then
                eat()
        let decl = new EnumDecl(name)
        decl.variants = variants
        return decl

    // `link name` (a bare identifier → `-lname`) or `link "path.c"` (a
    // quoted path, linked as-is) — only inside a module.
    mut parseLink(): LinkDecl
        eat()                       // link
        if not m_inModule then
            throw "`link` may only be used inside a module (a file starting with `module <name>`)"
        if at(TokenType::STRING) then
            let lexeme = peek().lexeme
            eat()
            let path = lexeme[1 to (lexeme.length - 1)]
            return new LinkDecl(path, true)
        let name = peek().lexeme
        eat()
        return new LinkDecl(name, false)

    // `match subject` then `case <expr>` / `else` arms, each with an
    // indented body.
    mut parseMatch(): MatchStmt
        eat()                       // match
        let subject = parseExpression()
        skipNewlines()
        let cases: [MatchCase] = []
        if at(TokenType::INDENT) then
            eat()
            while not at(TokenType::DEDENT) and not at(TokenType::EOF) do
                skipNewlines()
                if at(TokenType::DEDENT) or at(TokenType::EOF) then
                    break
                let mc = new MatchCase()
                if at(TokenType::CASE) then
                    eat()
                    mc.pattern = parseCasePattern()
                else if at(TokenType::ELSE) then
                    eat()
                    mc.isDefault = true
                else
                    throw ("expected `case` or `else` in match, got " + string(peek().lexeme))
                skipNewlines()
                if at(TokenType::INDENT) then
                    eat()
                    mc.body = parseStatements()
                    skipNewlines()
                    if at(TokenType::DEDENT) then
                        eat()
                cases += [mc]
                skipNewlines()
            if at(TokenType::DEDENT) then
                eat()
        let stmt = new MatchStmt()
        stmt.subject = subject
        stmt.cases = cases
        return stmt

    // A `case` pattern: a struct-destructuring pattern when it is a
    // capitalised type name immediately followed by `(`, otherwise an
    // ordinary value expression (`case 3`, `case "x"`, `case VARIANT`).
    mut parseCasePattern(): Expression?
        if at(TokenType::IDENT) and startsUpper(peek().lexeme) and peekAt(1).type == TokenType::OPEN_PAREN then
            return parseStructPattern()
        return parseExpression()

    // `Type(field: <lit>, field: bindIdent, shorthandBind, …)`
    mut parseStructPattern(): Expression?
        let sp = new StructPattern()
        sp.typeName = peek().lexeme
        eat()                           // Type
        eat()                           // (
        while not at(TokenType::CLOSE_PAREN) and not at(TokenType::EOF) do
            let fp = new FieldPattern()
            fp.field = peek().lexeme
            eat()                       // field name (or shorthand binding)
            if at(TokenType::COLON) then
                eat()
                // a lone identifier before `,` / `)` is a binding target;
                // anything else is a literal sub-pattern to compare
                if at(TokenType::IDENT) and (peekAt(1).type == TokenType::COMMA or peekAt(1).type == TokenType::CLOSE_PAREN) then
                    fp.bind = peek().lexeme
                    eat()
                else
                    fp.lit = parseExpression()
            else
                // `case Type(name)` — shorthand for `name: name`
                fp.bind = fp.field
            sp.fields += [fp]
            if at(TokenType::COMMA) then
                eat()
        if at(TokenType::CLOSE_PAREN) then
            eat()
        return sp

    // `constructor(params)` + body — lowered like a void method.
    mut parseCtor(): FunctionDecl
        eat()                       // constructor
        eat()                       // (
        let params = parseParams()
        eat()                       // )
        skipNewlines()
        if at(TokenType::INDENT) then
            eat()
        let body = parseStatements()
        skipNewlines()
        if at(TokenType::DEDENT) then
            eat()
        let decl = new FunctionDecl("constructor")
        decl.params = params
        decl.body = body
        decl.isVoid = true
        decl.isConstructor = true
        return decl

    // class body.  Two layouts are accepted:
    //   • members indented straight under `class X` (labels, if any, sit
    //     at the same indent as the members)
    //   • a `public` / `private` label at the class's own column, with
    //     that section's members indented under it (repeated per section)
    mut parseClass(): ClassDecl
        eat()
        let name = peek().lexeme
        eat()
        let decl = new ClassDecl(name)
        if at(TokenType::COLON) then
            eat()
            decl.parent = peek().lexeme
            eat()
        skipNewlines()

        let guard = 0
        let vis = "public"
        while true do
            skipNewlines()
            // a section label sitting at the class column (no indent)
            if at(TokenType::IDENT) and (peek().lexeme == "public" or peek().lexeme == "private") then
                vis = peek().lexeme
                eat()
                skipNewlines()
            if not at(TokenType::INDENT) then
                break
            eat()
            parseClassMembers(decl, vis)
            if at(TokenType::DEDENT) then
                eat()
            guard += 1
            if guard > 1000 then
                break
        return decl

    void parseClassMembers(decl: ClassDecl, startVis: string)
        let vis = startVis
        while not at(TokenType::DEDENT) and not at(TokenType::EOF) do
            skipNewlines()
            if at(TokenType::DEDENT) or at(TokenType::EOF) then
                break

            if at(TokenType::IDENT) and (peek().lexeme == "public" or peek().lexeme == "private") then
                vis = peek().lexeme
                eat()
                skipNewlines()
                continue

            if at(TokenType::CONSTRUCTOR) then
                decl.methods += [parseCtor()]
                skipNewlines()
                continue

            if at(TokenType::FN) or at(TokenType::MUT) or at(TokenType::VOID) then
                let fm = parseFunction()
                fm.visibility = vis
                decl.methods += [fm]
                skipNewlines()
                continue

            // otherwise: a field declaration  `name: type [= default]`
            let fname = peek().lexeme
            eat()
            if at(TokenType::COLON) then
                eat()
            let ftype = parseType()
            let fdefault: Expression? = null
            if at(TokenType::EQUALS) then
                eat()
                fdefault = parseExpression()
            let cf = new ClassField(fname, ftype)
            cf.defaultValue = fdefault
            cf.visibility = vis
            decl.fields += [cf]
            skipNewlines()


    mut parseStatements(): [Statement]
        let stmts: [Statement] = []
        while not at(TokenType::DEDENT) and not at(TokenType::EOF) do
            skipNewlines()
            if at(TokenType::DEDENT) or at(TokenType::EOF) then
                break
            let before = m_pos
            let stmt = parseStatement()
            if stmt != null then
                stmts += [stmt]
            skipNewlines()
            if m_pos == before then
                if at(TokenType::TO) or at(TokenType::UNTIL) then
                    throw "a range `a to b` is only valid in a `for` loop or a slice, not as a value"
                if at(TokenType::ELSE) then
                    throw "unexpected 'else': a one-line `if c then X else Y` is not supported; write the branches on separate indented lines"
                throw ("unexpected '" + string(peek().lexeme) + "'")
        return stmts

    mut parseStatement(): Statement?
        let ln = peek().line
        let col = peek().column
        let st = parseStatementInner()
        if st != null and st.line == 0 then
            st.line = ln
            st.column = col
        return st

    mut parseStatementInner(): Statement?
        if at(TokenType::LET) then
            return parseVarDecl()
        if at(TokenType::RETURN) then
            return parseReturn()
        if at(TokenType::IF) then
            return parseIf()
        if at(TokenType::WHILE) then
            return parseWhile()
        if at(TokenType::FOR) then
            return parseFor()
        if at(TokenType::BREAK) then
            eat()
            return new BreakStmt()
        if at(TokenType::CONTINUE) then
            eat()
            return new ContinueStmt()
        if at(TokenType::THROW) then
            eat()
            let msg = parseExpression()
            return new ThrowStmt(msg)
        if at(TokenType::MATCH) then
            return parseMatch()

        let expr = parseExpression()
        if expr == null then
            return null

        if at(TokenType::EQUALS) or at(TokenType::PLUS_EQ) or at(TokenType::MINUS_EQ) or at(TokenType::STAR_EQ) or at(TokenType::SLASH_EQ) or at(TokenType::PERCENT_EQ) then
            let op = peek().lexeme
            eat()
            let value = parseExpression()
            if expr is Identifier then
                return new AssignStmt(expr.name, op, value)
            if expr is MemberExpr then
                return new FieldAssignStmt(expr.object, expr.member, op, value)
            if expr is IndexExpr then
                return new IndexAssignStmt(expr.object, expr.index, op, value)

        return new ExprStmt(expr)

    mut parseVarDecl(): VarDecl
        eat()
        let name = peek().lexeme
        eat()
        let vtype: string? = null
        if at(TokenType::COLON) then
            eat()
            vtype = parseType()
        // `let x be ...` binds an immutable variable; `let x = ...` is
        // reassignable.
        let immutable = at(TokenType::BE)
        let init: Expression? = null
        if at(TokenType::EQUALS) or at(TokenType::BE) then
            eat()
            init = parseExpression()
        let decl = new VarDecl(name)
        decl.declaredType = vtype
        decl.init = init
        decl.immutable = immutable
        return decl

    mut parseReturn(): ReturnStmt
        eat()
        let value: Expression? = null
        if not at(TokenType::NEWLINE) and not at(TokenType::DEDENT) and not at(TokenType::EOF) then
            value = parseExpression()
        let stmt = new ReturnStmt()
        stmt.value = value
        return stmt

    mut parseIf(): IfStmt
        eat()
        let cond = parseExpression()
        let hadThen = at(TokenType::DO)
        if at(TokenType::DO) then
            eat()

        // one-liner:  if cond then <stmt>
        if hadThen and not at(TokenType::NEWLINE) and not at(TokenType::EOF) then
            let single = parseStatement()
            let one = new IfStmt()
            one.cond = cond
            if single != null then
                one.thenBody = [single]
            return one

        skipNewlines()
        if at(TokenType::INDENT) then
            eat()
        let thenBody = parseStatements()
        skipNewlines()
        if at(TokenType::DEDENT) then
            eat()

        // A blank or comment-only line between the `then` block and
        // `else` shows up as stray newlines here — skip them so the
        // `else` still binds.
        skipNewlines()

        let elseBody: [Statement] = []
        if at(TokenType::ELSE) then
            eat()
            // `else if …` — the else-branch is a single nested `if`, with
            // no indented block of its own.
            if at(TokenType::IF) then
                elseBody = [parseIf()]
            else
                skipNewlines()
                if at(TokenType::INDENT) then
                    eat()
                elseBody = parseStatements()
                skipNewlines()
                if at(TokenType::DEDENT) then
                    eat()

        let stmt = new IfStmt()
        stmt.cond = cond
        stmt.thenBody = thenBody
        stmt.elseBody = elseBody
        return stmt

    mut parseWhile(): WhileStmt
        eat()
        let cond = parseExpression()
        if at(TokenType::DO) then
            eat()
        skipNewlines()
        if at(TokenType::INDENT) then
            eat()
        let body = parseStatements()
        skipNewlines()
        if at(TokenType::DEDENT) then
            eat()
        let stmt = new WhileStmt()
        stmt.cond = cond
        stmt.body = body
        return stmt

    mut parseFor(): Statement
        eat()                       // for
        let varName = peek().lexeme
        eat()                       // loop variable

        // for-each:  for x in iterable
        if at(TokenType::IN) then
            eat()
            let iterable = parseExpression()
            if at(TokenType::DO) then
                eat()
            skipNewlines()
            if at(TokenType::INDENT) then
                eat()
            let feBody = parseStatements()
            skipNewlines()
            if at(TokenType::DEDENT) then
                eat()
            let fe = new ForInStmt(varName)
            fe.iterable = iterable
            fe.body = feBody
            return fe

        // range:  for i = a to b   /   for i = a down to b   /  ... until b
        eat()                       // =
        let start = parseExpression()
        let descending = false
        if at(TokenType::DOWN) then
            descending = true
            eat()
        let inclusive = true
        if at(TokenType::TO) then
            eat()
        else if at(TokenType::UNTIL) then
            inclusive = false
            eat()
        let end = parseExpression()
        if at(TokenType::DO) then
            eat()
        skipNewlines()
        if at(TokenType::INDENT) then
            eat()
        let body = parseStatements()
        skipNewlines()
        if at(TokenType::DEDENT) then
            eat()
        let stmt = new ForStmt(varName)
        stmt.start = start
        stmt.end = end
        stmt.body = body
        stmt.inclusive = inclusive
        stmt.descending = descending
        return stmt
