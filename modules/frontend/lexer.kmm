module km_compiler

enum TokenType
    EOF
    NEWLINE
    INDENT
    DEDENT
    IDENT
    INT
    FLOAT
    STRING
    CHAR
    TRUE
    FALSE
    NULL
    IF
    ELSE
    WHILE
    FOR
    TO
    UNTIL
    DO
    FN
    MUT
    EXTERN
    MODULE
    IMPORT
    LINK
    CONSTRUCTOR
    VOID
    RETURN
    THROW
    BREAK
    CONTINUE
    STRUCT
    CLASS
    ENUM
    MATCH
    CASE
    NEW
    LET
    OPEN_PAREN
    CLOSE_PAREN
    OPEN_BRACKET
    CLOSE_BRACKET
    OPEN_BRACE
    CLOSE_BRACE
    COMMA
    COLON
    COLON_EQ
    DOT
    SEMICOLON
    EQUALS
    PLUS
    MINUS
    STAR
    SLASH
    PERCENT
    CARET
    AND
    OR
    NOT
    EQ
    NEQ
    LT
    LTE
    GT
    GTE
    ARROW
    PLUS_EQ
    MINUS_EQ
    STAR_EQ
    SLASH_EQ
    PERCENT_EQ
    HASH
    BE
    DOWN
    IN
    IS
    AMP
    PIPE
    SHL
    SHR
    SCOPE
    QUESTION

struct Token
    type: TokenType
    lexeme: string
    line: int
    column: int

// Bounded substring: `s[start to end]` given `n == #s` (stdlib/runtime.c).
extern fn km_str_sub(s: string, n: int, start: int, end: int): string

// The lexer's state lives on the class; every operation on it is
// declared within the class body with public/private sections.
extern fn km_ch_alpha(c: char?): int
extern fn km_ch_digit(c: char?): int

class Lexer
public
    constructor(src: string)
        m_src = src
        // `.length` of a string is a strlen — O(n).  Every peek() checks
        // the bound, so re-measuring the whole source each time made
        // lexing quadratic; the source never changes, so measure once.
        m_len = src.length

    mut tokenize(): [Token]
        while m_pos < m_len do
            skipWhitespace()

            if m_pos >= m_len then
                break

            let c = peek()

            handleLineStart(c)

            // where this token starts — tokens are built after their text
            // is consumed, so stamp the start position on afterwards
            let firstTok = #m_tokens
            let startLine = m_line
            let startCol = m_col

            if c == "\n" then
                m_tokens += [new Token(TokenType::NEWLINE, "\n", m_line, m_col)]
                eat()
                m_line_start = true
            else if isDigit(c) then
                m_tokens += [readNumber()]
            else if isAlpha(c) then
                m_tokens += [readIdentifier()]
            else if c == "\"" then
                m_tokens += [readString()]
            else if c == "`" then
                // interpolated string: `text {expr} more` desugars, right
                // here, to  ( "text " + string(expr) + " more" )  — a
                // token stream the ordinary parser already understands.
                for t in readInterpString() do
                    m_tokens += [t]
            else if c == "'" then
                m_tokens += [readChar()]
            else
                readOperator(c)

            if c != "\n" then
                let ti = firstTok
                while ti < #m_tokens do
                    let tok = m_tokens[ti]
                    if tok.type != TokenType::INDENT and tok.type != TokenType::DEDENT then
                        tok.line = startLine
                        tok.column = startCol
                    ti += 1

        while #m_indents > 1 do
            m_indents = m_indents[0 to (#m_indents - 1)]
            m_tokens += [new Token(TokenType::DEDENT, "", m_line, m_col)]

        m_tokens += [new Token(TokenType::EOF, "", m_line, m_col)]
        return m_tokens

    // Deprecation warnings found while lexing, as "LINE:COL: warning: ...".
    // The driver prints them; the deprecated forms still compile.
    mut warnings(): [string]
        return m_warnings

private
    m_src: string
    m_warnings: [string] = []
    m_len: int = 0
    m_keywords: StrIndex? = null   // built on first use (see isKeyword)
    m_pos: int = 0
    m_line: int = 1
    m_col: int = 1
    m_tokens: [Token] = []
    m_indents: [int] = [0]
    m_line_start: bool = true

    mut deprecated(msg: string)
        m_warnings += [string(m_line) + ":" + string(m_col) + ": warning: " + msg]

    mut isDigit(c: char?): bool
        return km_ch_digit(c) == 1

    mut isAlpha(c: char?): bool
        return km_ch_alpha(c) == 1

    mut isAlphaNum(c: char?): bool
        return isAlpha(c) or isDigit(c)

    mut isHexDigit(c: char?): bool
        if c == null then
            return false
        return (c >= "0" and c <= "9") or (c >= "a" and c <= "f") or (c >= "A" and c <= "F")

    mut peek(): char?
        if m_pos >= m_len then
            return null
        return m_src[m_pos]

    mut peekNext(): char?
        if m_pos + 1 >= m_len then
            return null
        return m_src[m_pos + 1]

    mut eat(): char?
        let c = peek()
        if c != null then
            m_pos += 1
            if c == "\n" then
                m_line += 1
                m_col = 1
            else
                m_col += 1
        return c

    void skipWhitespace()
        while peek() == " " or peek() == "\t" or peek() == "\r" do
            eat()

    // `_` digit separators: an underscore is part of the literal only when
    // a digit of the same kind follows it (`1_000`, `0xFF_FF`, `0b1010_0001`).
    mut isBinDigit(c: char?): bool
        return c == "0" or c == "1"

    // The literal's text with its `_` separators removed.
    fn stripUnderscores(s: string): string
        let out = ""
        let i = 0
        while i < s.length do
            if s[i] != "_" then
                out = out + string(s[i])
            i += 1
        return out

    mut readNumber(): Token
        let start = m_pos

        // Binary literal (0b / 0B followed by 0/1 digits) — lowered to its
        // decimal text so every backend sees an ordinary integer literal.
        if peek() == "0" and (peekNext() == "b" or peekNext() == "B") and m_pos + 2 < m_len and isBinDigit(m_src[m_pos + 2]) then
            eat()  // consume '0'
            eat()  // consume 'b' or 'B'
            let bits = 0
            while isBinDigit(peek()) or (peek() == "_" and isBinDigit(peekNext())) do
                let d = eat()
                if d != "_" then
                    bits = bits * 2
                    if d == "1" then
                        bits = bits + 1
            return new Token(TokenType::INT, string(bits), m_line, m_col)

        // Check for hex literal (0x or 0X followed by hex digits)
        if peek() == "0" and (peekNext() == "x" or peekNext() == "X") then
            eat()  // consume '0'
            eat()  // consume 'x' or 'X'

            // Read hex digits
            while isHexDigit(peek()) or (peek() == "_" and isHexDigit(peekNext())) do
                eat()

            let text = stripUnderscores(km_str_sub(m_src, m_len, start, m_pos))
            return new Token(TokenType::INT, text, m_line, m_col)

        // Decimal number parsing
        while isDigit(peek()) or (peek() == "_" and isDigit(peekNext())) do
            eat()

        let isFloat = false
        if peek() == "." and isDigit(peekNext()) then
            isFloat = true
            eat()
            while isDigit(peek()) or (peek() == "_" and isDigit(peekNext())) do
                eat()

        let text = stripUnderscores(km_str_sub(m_src, m_len, start, m_pos))

        // Optional `f` suffix (`2.0f`, `2f`) marks a float literal.
        if peek() == "f" then
            eat()
            // `2f` means `2.0f`: give the float token a decimal point
            if not isFloat then
                text = text + ".0"
            isFloat = true

        if isFloat then
            return new Token(TokenType::FLOAT, text, m_line, m_col)

        return new Token(TokenType::INT, text, m_line, m_col)

    mut readIdentifier(): Token
        let start = m_pos
        while isAlphaNum(peek()) do
            eat()
        let text = km_str_sub(m_src, m_len, start, m_pos)

        let type = TokenType::IDENT
        let lexeme = text
        // most identifiers are not keywords — one hash probe skips the
        // whole chain of string compares below for them
        if not isKeyword(text) then
            return new Token(type, lexeme, m_line, m_col)
        match text
            case "true"
                type = TokenType::TRUE
            case "false"
                type = TokenType::FALSE
            case "null"
                type = TokenType::NULL
            case "if"
                type = TokenType::IF
            case "else"
                type = TokenType::ELSE
            case "while"
                type = TokenType::WHILE
            case "for"
                type = TokenType::FOR
            case "to"
                type = TokenType::TO
            case "until"
                type = TokenType::UNTIL
            case "do"
                type = TokenType::DO
            case "then"
                type = TokenType::DO
            case "fn"
                type = TokenType::FN
            case "void"
                type = TokenType::VOID
            case "return"
                type = TokenType::RETURN
            case "throw"
                type = TokenType::THROW
            case "break"
                type = TokenType::BREAK
            case "continue"
                type = TokenType::CONTINUE
            case "struct"
                type = TokenType::STRUCT
            case "class"
                type = TokenType::CLASS
            case "enum"
                type = TokenType::ENUM
            case "match"
                type = TokenType::MATCH
            case "case"
                type = TokenType::CASE
            case "new"
                type = TokenType::NEW
            case "let"
                type = TokenType::LET
            case "and"
                type = TokenType::AND
            case "or"
                type = TokenType::OR
            case "not"
                type = TokenType::NOT
            case "import"
                type = TokenType::IMPORT
            case "link"
                type = TokenType::LINK
            case "mut"
                type = TokenType::MUT
            case "extern"
                type = TokenType::EXTERN
            case "module"
                type = TokenType::MODULE
            case "constructor"
                type = TokenType::CONSTRUCTOR
            case "be"
                type = TokenType::BE
            case "down"
                type = TokenType::DOWN
            case "in"
                type = TokenType::IN
            case "is"
                type = TokenType::IS
            case "xor"
                type = TokenType::CARET

        return new Token(type, lexeme, m_line, m_col)

    mut isKeyword(text: string): bool
        if m_keywords == null then
            let ix = new StrIndex()
            for k in ["true", "false", "null", "if", "else", "while", "for", "to", "until", "do", "then", "fn", "void", "return", "throw", "break", "continue", "struct", "class", "enum", "match", "case", "new", "let", "and", "or", "not", "import", "link", "mut", "extern", "module", "constructor", "be", "down", "in", "is", "xor"] do
                ix.add(k, 0)
            m_keywords = ix
        let kw = m_keywords
        if kw == null then
            return true
        return kw.has(text)

    mut readString(): Token
        let start = m_pos
        eat()
        while peek() != "\"" and peek() != null do
            if peek() == "\\" then
                eat()
                eat()
            else
                eat()
        eat()
        return new Token(TokenType::STRING, km_str_sub(m_src, m_len, start, m_pos), m_line, m_col)

    // `` `lit0 {e0} lit1 {e1} lit2` `` → the token stream for
    //   ( "lit0" + string( e0 ) + "lit1" + string( e1 ) + "lit2" )
    // Each `{ … }` body is a full Komodo expression, lexed by a nested
    // Lexer and spliced in. Backslash escapes inside the literal text:
    // \n \t \\ \` \{ \}  (and \" is kept as-is for the emitted literal).
    mut readInterpString(): [Token]
        let ln = m_line
        let cl = m_col
        eat()                          // opening backtick
        let out: [Token] = []
        out += [new Token(TokenType::OPEN_PAREN, "(", ln, cl)]
        let chunk = ""                 // literal text so far, "-escaped
        let havePiece = false          // has anything been emitted after `(` ?

        while peek() != "`" and peek() != null do
            let c = peek()
            if c == null then
                break
            if c == "\\" then
                eat()
                let e = eat()
                if e == "n" then
                    chunk = chunk + "\\n"
                else if e == "t" then
                    chunk = chunk + "\\t"
                else if e == "\\" then
                    chunk = chunk + "\\\\"
                else if e == "`" then
                    chunk = chunk + "`"
                else if e == "{" then
                    chunk = chunk + "{"
                else if e == "}" then
                    chunk = chunk + "}"
                else if e == "\"" then
                    chunk = chunk + "\\\""
                else if e != null then
                    chunk = chunk + "\\" + e
            else if c == "\"" then
                eat()
                chunk = chunk + "\\\""     // keep the emitted literal well-formed
            else if c == "{" then
                eat()
                // flush the literal chunk gathered so far
                if havePiece then
                    out += [new Token(TokenType::PLUS, "+", m_line, m_col)]
                out += [new Token(TokenType::STRING, "\"" + chunk + "\"", m_line, m_col)]
                havePiece = true
                chunk = ""
                // + string( <embedded expression tokens> )
                out += [new Token(TokenType::PLUS, "+", m_line, m_col)]
                out += [new Token(TokenType::IDENT, "string", m_line, m_col)]
                out += [new Token(TokenType::OPEN_PAREN, "(", m_line, m_col)]
                let sub = new Lexer(readInterpExpr())
                let subToks = sub.tokenize()
                for w in sub.warnings() do
                    m_warnings += [w]
                for t in subToks do
                    if t.type != TokenType::EOF and t.type != TokenType::NEWLINE and t.type != TokenType::INDENT and t.type != TokenType::DEDENT then
                        out += [t]
                out += [new Token(TokenType::CLOSE_PAREN, ")", m_line, m_col)]
            else
                eat()
                chunk = chunk + c
        eat()                          // closing backtick (or EOF)

        if havePiece then
            out += [new Token(TokenType::PLUS, "+", m_line, m_col)]
        out += [new Token(TokenType::STRING, "\"" + chunk + "\"", m_line, m_col)]
        out += [new Token(TokenType::CLOSE_PAREN, ")", m_line, m_col)]
        return out

    // From just past a `{`, return the raw source of the embedded
    // expression and consume through its matching `}`. Tracks brace
    // nesting and skips over `"…"` string literals so a brace inside a
    // string doesn't end the interpolation.
    mut readInterpExpr(): string
        let start = m_pos
        let depth = 1
        while peek() != null and depth > 0 do
            let c = peek()
            if c == "\"" then
                eat()
                while peek() != "\"" and peek() != null do
                    if peek() == "\\" then
                        eat()
                    eat()
                eat()
            else if c == "{" then
                depth += 1
                eat()
            else if c == "}" then
                depth -= 1
                if depth == 0 then
                    break
                eat()
            else
                eat()
        let src = km_str_sub(m_src, m_len, start, m_pos)
        eat()                          // the closing `}`
        return src

    mut readChar(): Token
        let start = m_pos
        eat()
        while peek() != "'" and peek() != null do
            if peek() == "\\" then
                eat()
                eat()
            else
                eat()
        eat()
        return new Token(TokenType::CHAR, km_str_sub(m_src, m_len, start, m_pos), m_line, m_col)

    void handleLineStart(c: char?)
        if not m_line_start or c == "\n" or c == null then
            return
        let indent = m_col - 1
        if indent > m_indents[#m_indents - 1] then
            m_indents += [indent]
            m_tokens += [new Token(TokenType::INDENT, "", m_line, m_col)]
        else if indent < m_indents[#m_indents - 1] then
            while m_indents[#m_indents - 1] > indent do
                m_indents = m_indents[0 to (#m_indents - 1)]
                m_tokens += [new Token(TokenType::DEDENT, "", m_line, m_col)]
        m_line_start = false

    void readOperator(c: char?)
        match c
            case "("
                m_tokens += [new Token(TokenType::OPEN_PAREN, "(", m_line, m_col)]
                eat()
            case ")"
                m_tokens += [new Token(TokenType::CLOSE_PAREN, ")", m_line, m_col)]
                eat()
            case "["
                m_tokens += [new Token(TokenType::OPEN_BRACKET, "[", m_line, m_col)]
                eat()
            case "]"
                m_tokens += [new Token(TokenType::CLOSE_BRACKET, "]", m_line, m_col)]
                eat()
            case "{{"
                m_tokens += [new Token(TokenType::OPEN_BRACE, "{{", m_line, m_col)]
                eat()
            case "}}"
                m_tokens += [new Token(TokenType::CLOSE_BRACE, "}}", m_line, m_col)]
                eat()
            case ","
                m_tokens += [new Token(TokenType::COMMA, ",", m_line, m_col)]
                eat()
            case ":"
                eat()
                if peek() == ":" then
                    eat()
                    m_tokens += [new Token(TokenType::SCOPE, "::", m_line, m_col)]
                else if peek() == "=" then
                    eat()
                    m_tokens += [new Token(TokenType::COLON_EQ, ":=", m_line, m_col)]
                else
                    m_tokens += [new Token(TokenType::COLON, ":", m_line, m_col)]
            case "."
                m_tokens += [new Token(TokenType::DOT, ".", m_line, m_col)]
                eat()
            case ";"
                m_tokens += [new Token(TokenType::SEMICOLON, ";", m_line, m_col)]
                eat()
            case "*"
                eat()
                if peek() == "=" then
                    eat()
                    m_tokens += [new Token(TokenType::STAR_EQ, "*=", m_line, m_col)]
                else
                    m_tokens += [new Token(TokenType::STAR, "*", m_line, m_col)]
            case "%"
                eat()
                if peek() == "=" then
                    eat()
                    m_tokens += [new Token(TokenType::PERCENT_EQ, "%=", m_line, m_col)]
                else
                    m_tokens += [new Token(TokenType::PERCENT, "%", m_line, m_col)]
            case "^"
                eat()
                m_tokens += [new Token(TokenType::CARET, "^", m_line, m_col)]
            case "&"
                eat()
                if peek() == "&" then
                    deprecated("'&&' is deprecated: use 'and' (on numbers, '&&' is bitwise and)")
                m_tokens += [new Token(TokenType::AMP, "&", m_line, m_col)]
            case "|"
                eat()
                if peek() == "|" then
                    deprecated("'||' is deprecated: use 'or'")
                m_tokens += [new Token(TokenType::PIPE, "|", m_line, m_col)]
            case "="
                eat()
                if peek() == "=" then
                    eat()
                    m_tokens += [new Token(TokenType::EQ, "==", m_line, m_col)]
                else
                    m_tokens += [new Token(TokenType::EQUALS, "=", m_line, m_col)]
            case "+"
                eat()
                if peek() == "=" then
                    eat()
                    m_tokens += [new Token(TokenType::PLUS_EQ, "+=", m_line, m_col)]
                else
                    m_tokens += [new Token(TokenType::PLUS, "+", m_line, m_col)]
            case "-"
                eat()
                if peek() == "=" then
                    eat()
                    m_tokens += [new Token(TokenType::MINUS_EQ, "-=", m_line, m_col)]
                else if peek() == ">" then
                    eat()
                    m_tokens += [new Token(TokenType::ARROW, "->", m_line, m_col)]
                else
                    m_tokens += [new Token(TokenType::MINUS, "-", m_line, m_col)]
            case "#"
                eat()
                m_tokens += [new Token(TokenType::HASH, "#", m_line, m_col)]
            case "?"
                eat()
                m_tokens += [new Token(TokenType::QUESTION, "?", m_line, m_col)]
            case "/"
                eat()
                if peek() == "/" then
                    while peek() != "\n" and peek() != null do
                        eat()
                else if peek() == "*" then
                    eat()
                    while peek() != null do
                        if peek() == "*" and peekNext() == "/" then
                            eat()
                            eat()
                            break
                        eat()
                else if peek() == "=" then
                    eat()
                    m_tokens += [new Token(TokenType::SLASH_EQ, "/=", m_line, m_col)]
                else
                    m_tokens += [new Token(TokenType::SLASH, "/", m_line, m_col)]
            case "<"
                eat()
                if peek() == "=" then
                    eat()
                    m_tokens += [new Token(TokenType::LTE, "<=", m_line, m_col)]
                else if peek() == "<" then
                    eat()
                    m_tokens += [new Token(TokenType::SHL, "<<", m_line, m_col)]
                else
                    m_tokens += [new Token(TokenType::LT, "<", m_line, m_col)]
            case ">"
                eat()
                if peek() == "=" then
                    eat()
                    m_tokens += [new Token(TokenType::GTE, ">=", m_line, m_col)]
                else if peek() == ">" then
                    eat()
                    m_tokens += [new Token(TokenType::SHR, ">>", m_line, m_col)]
                else
                    m_tokens += [new Token(TokenType::GT, ">", m_line, m_col)]
            case "!"
                eat()
                if peek() == "=" then
                    eat()
                    m_tokens += [new Token(TokenType::NEQ, "!=", m_line, m_col)]
                else
                    deprecated("'!' is deprecated: use 'not'")
                    m_tokens += [new Token(TokenType::NOT, "!", m_line, m_col)]
            else
                eat()
