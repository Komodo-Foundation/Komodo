module km_compiler

// ═══════════════════════════════════════════════════════════════════════
//  Komodo AST
//
//  Every node descends from `ASTNode`, so any node carries source
//  position. `Expression`, `Statement` and `Declaration` are abstract
//  bases - you never instantiate them, only their concrete subtypes -
//  which lets a field typed `Expression?` hold any expression node (or
//  null) while still being a real, checked type rather than a marker.
//
//  Inheritance rule (interpreter + self-hosted): a subtype's fields are
//  the parent's fields followed by its own; instantiating an `abstract`
//  type is an error.
// ═══════════════════════════════════════════════════════════════════════

abstract shared struct ASTNode
    line: int = 0
    column: int = 0

// ─── Expressions ──────────────────────────────────────────────────────

abstract struct Expression : ASTNode
    // Coarse static type filled in by the semantic analyser (sema*.kmm):
    // one of "int" / "float" / "string" / "[T]" / an object-type name.
    // Codegen reads this instead of re-deriving it; null on nodes the
    // analyser never saw (e.g. macro expansions synthesised at codegen).
    resolvedType: string? = null

abstract struct Literal : Expression

struct IntLiteral : Literal
    value: string

struct FloatLiteral : Literal
    value: string

struct BoolLiteral : Literal
    value: bool = false

struct StringLiteral : Literal
    value: string

struct CharLiteral : Literal
    value: string

struct NullLiteral : Literal

struct Identifier : Expression
    name: string
    // For `ns::member` the namespace before the final `::` (flat after
    // merge, so only used for module-privacy diagnostics). "" otherwise.
    qualifier: string = ""

// Binary arithmetic / comparison / logical (`and`, `or`) - `op` is the
// source operator text.
struct BinaryOp : Expression
    op: string
    left: Expression? = null
    right: Expression? = null

struct UnaryOp : Expression
    op: string
    operand: Expression? = null

// Bare `name(args)` call (free function or in-scope method).
struct CallExpr : Expression
    name: string
    args: [Expression] = []
    // `ns::member(args)` — the namespace before the final `::` (kept only
    // for module-privacy diagnostics; the call still targets `name`).
    qualifier: string = ""
    // `expr.method(args)` where `expr` is not a plain name (a field, an
    // index, another call): the receiver expression; `name` is ".method".
    receiver: Expression? = null
    // `name(args)?` — a protected call: yields null instead of
    // propagating a thrown error out of the callee.
    protected: bool = false
    // Filled in by the semantic analyser: the resolved, owner-qualified
    // target symbol for a method call (e.g. `Shape__area`), so codegen
    // does not re-run method-owner resolution.  null for a plain call.
    resolvedSym: string? = null
    isMethod: bool = false
    // For the built-in `assert`: the `file:line: ` prefix of its failure
    // message, filled in by the semantic analyser (codegen has no file map).
    site: string = ""

// `receiver.method(args)`
struct MethodCallExpr : Expression
    receiver: Expression? = null
    method: string
    args: [Expression] = []

// `namespace::name` (module member access, e.g. `file::read_all`).
struct ScopeExpr : Expression
    namespace: string
    name: string

struct IndexExpr : Expression
    object: Expression? = null
    index: Expression? = null

// `object[start to end]` / `object[start :]` etc.
struct SliceExpr : Expression
    object: Expression? = null
    start: Expression? = null
    end: Expression? = null
    inclusive: bool = false

struct MemberExpr : Expression
    object: Expression? = null
    // defaulted so positional `new MemberExpr(obj, name)` keeps field
    // order (the interpreter floats required fields ahead of optional
    // ones otherwise).
    member: string = ""

struct ArrayExpr : Expression
    elements: [Expression] = []

// `a to b` used as a value (range).
struct RangeExpr : Expression
    start: Expression? = null
    end: Expression? = null
    inclusive: bool = false

struct NewExpr : Expression
    typeName: string
    args: [Expression] = []
    // `new Type(args)?` — protected construction: yields null instead of
    // propagating a thrown error out of the constructor.
    protected: bool = false

// `expr or throw "msg"` / `throw "msg"` used in expression position.
struct ThrowExpr : Expression
    message: Expression? = null

// ─── Statements ───────────────────────────────────────────────────────

abstract struct Statement : ASTNode

struct VarDecl : Statement
    name: string
    declaredType: string? = null
    init: Expression? = null
    immutable: bool = false
    // The analyser's inferred/declared type for this binding (coarse
    // string form), so frame layout does not re-infer it.
    resolvedType: string? = null
    // For a top-level `let` (global / macro): its module + `public` /
    // `private` section, mirroring `Declaration`.
    modOwner: string = ""
    visMod: string = "public"
    // `extern let name: T [= "sym"]` — a C global variable: no storage of
    // our own, reads / writes go straight to the C symbol.
    isExtern: bool = false
    symbol: string? = null

struct AssignStmt : Statement
    name: string
    op: string = "="
    value: Expression? = null

struct FieldAssignStmt : Statement
    object: Expression? = null
    field: string = ""             // defaulted to keep positional field order
    op: string = "="
    value: Expression? = null

struct IndexAssignStmt : Statement
    object: Expression? = null
    index: Expression? = null
    op: string = "="
    value: Expression? = null

struct ExprStmt : Statement
    expr: Expression? = null

struct ReturnStmt : Statement
    value: Expression? = null

struct IfStmt : Statement
    cond: Expression? = null
    thenBody: [Statement] = []
    elseBody: [Statement] = []

struct WhileStmt : Statement
    cond: Expression? = null
    body: [Statement] = []

// Numeric `for i = start to end do`  /  `for i = start down to end`
struct ForStmt : Statement
    varName: string
    start: Expression? = null
    end: Expression? = null
    body: [Statement] = []
    inclusive: bool = false
    descending: bool = false

// `for item in iterable do`
struct ForInStmt : Statement
    varName: string
    iterable: Expression? = null
    body: [Statement] = []

// One field slot of a struct pattern (`case Type(field: <sub>, …)`).
// Exactly one of `lit` / `bind` is set:
//   • `lit != null`  — match iff `subject.field == lit` (a literal).
//   • `bind != ""`   — bind `subject.field` to a fresh local `bind`.
struct FieldPattern
    field: string
    lit: Expression? = null
    bind: string = ""

// A destructuring pattern in a `case`: `Type(field: pat, shorthand, …)`.
// Matches when the subject's runtime type is `typeName` (or a subtype)
// and every field sub-pattern matches.  Parsed only for a capitalised
// name immediately followed by `(`, so ordinary value patterns are
// unaffected.
struct StructPattern : Expression
    typeName: string
    fields: [FieldPattern] = []

struct MatchCase
    pattern: Expression? = null
    body: [Statement] = []
    isDefault: bool = false

struct MatchStmt : Statement
    subject: Expression? = null
    cases: [MatchCase] = []
    // codegen: name of the hidden local holding the evaluated subject
    // (assigned by `collectLocals`).
    tmpName: string = ""
    // sema: true when the arms are provably exhaustive.
    exhaustive: bool = false

struct ThrowStmt : Statement
    message: Expression? = null

struct BreakStmt : Statement

struct ContinueStmt : Statement

// ─── Declarations ─────────────────────────────────────────────────────

abstract struct Declaration : ASTNode
    // `module NAME` a file's declarations belong to (flat after merge),
    // and whether a `public` / `private` section marked it. Enforcement
    // is best-effort — a `private` member is rejected only when reached
    // through its module name from a different module.
    moduleOwner: string = ""
    visibility: string = "public"

// A function / method parameter. `modifier` is `public` / `private` for
// constructor-parameter fields, else null.
struct Param
    name: string
    declaredType: string? = null
    defaultValue: Expression? = null
    modifier: string? = null

struct FunctionDecl : Declaration
    name: string
    params: [Param] = []
    returnType: string? = null
    body: [Statement] = []
    isVoid: bool = false
    isMut: bool = false
    isConstructor: bool = false
    // `extern fn` — a foreign C function, no body; calls use the native
    // System V AMD64 C ABI instead of Komodo's (tag,value)[] ABI.
    isExtern: bool = false
    // `export fn` — a Komodo function with a body that is also callable
    // FROM C / C++ under its unmangled name, through a native System V
    // C-ABI entry wrapper.
    isExport: bool = false
    // `extern fn f(...) = "sym"` — the C symbol to bind when it differs
    // from the Komodo name (a C++ mangled name, or a C name that is not a
    // valid Komodo identifier).  null = the function's own name.
    symbol: string? = null
    // A body-less declaration (`fn name(params): T` with no indented
    // block): the signature is known to the compiler but the definition
    // is supplied at link time, using the ordinary Komodo call ABI (this
    // is how the standard library — `console`, `math`, … — is declared).
    isPrototype: bool = false
    // A trailing `...` parameter: the call may pass any number of extra
    // arguments after the fixed ones (e.g. `console::print`).
    variadic: bool = false
    // For a method / constructor lowered to a free function: the class it
    // came from (so an unqualified field name resolves against `self`).
    ownerClass: string? = null
    // When this free function participates in overloading (or is a
    // monomorphised generic instance), the unique symbol it is emitted
    // under — source name + arity + parameter types. null for the common
    // case, where it is emitted under `name`.
    linkName: string? = null

struct StructMember
    name: string
    declaredType: string? = null
    defaultValue: Expression? = null

struct StructDecl : Declaration
    name: string
    members: [StructMember] = []
    // `struct Child : Parent` - name of the base type, or null.
    parent: string? = null
    // A fixed-width int container (`struct Flags : u32`), or null.
    container: string? = null
    isAbstract: bool = false
    // `extern type T` - an opaque, pointer-sized C handle: a distinct
    // nominal type with no fields that cannot be constructed with `new`.
    // Codegen treats its values as plain integers; the analyzer keeps it
    // separate from `int` and from every other handle type.
    isExtern: bool = false
    // `unique struct T` - a value of this type has a single owner: binding,
    // assigning, storing or returning it *moves* it, and the source
    // location is left invalid.  Runtime representation is unchanged; the
    // analyzer enforces the ownership rule.  `shared` (the default) opts
    // back into ordinary aliasing.
    isUnique: bool = false

struct ClassField
    name: string
    declaredType: string? = null
    defaultValue: Expression? = null

struct ClassDecl : Declaration
    name: string
    fields: [ClassField] = []
    methods: [FunctionDecl] = []
    parent: string? = null
    isAbstract: bool = false

struct EnumDecl : Declaration
    name: string
    variants: [string] = []

struct ImportDecl : Declaration
    path: string

// `link name` (a bare identifier → the linker flag `-lname`) or
// `link "path/to/file.c"` (a quoted path, passed to the linker as-is,
// relative to wherever the compiler is invoked from) — only valid inside
// a module (a file that starts with `module <name>`; the parser rejects
// it elsewhere). Declares what a library's interface file needs linked
// in alongside it — see design.md's "Standard library" section and
// stdlib/sdl2.kmm. Codegen ignores this; it is a build-time detail the
// driver (main.km) collects into `<program>.links` for the `komodo` CLI.
struct LinkDecl : Declaration
    target: string
    isPath: bool = false

// ─── Program ──────────────────────────────────────────────────────────

struct Program
    // Set once the semantic analyser has walked and annotated the tree.
    analyzed: bool = false
    // Set by the analyser when it sees a `copy(x)` call anywhere — codegen
    // only synthesises the per-type deep-copy helpers when this is true, so
    // a program that never copies is byte-for-byte unaffected.
    usesCopy: bool = false
    moduleName: string? = null
    imports: [ImportDecl] = []
    links: [LinkDecl] = []
    enums: [EnumDecl] = []
    structs: [StructDecl] = []
    classes: [ClassDecl] = []
    functions: [FunctionDecl] = []
    // Top-level `let NAME be EXPR` compile-time macros. Each use of NAME
    // in the program is replaced by a fresh lowering of EXPR at codegen
    // time; nothing is allocated for the name itself.
    macros: [VarDecl] = []
    // Top-level `let NAME [: T] = EXPR` variables: one process-wide
    // storage slot each, visible (read + write) to every function. Their
    // initialisers run once, in source order, at the start of `main`.
    globals: [VarDecl] = []
    // All top-level declarations in source order, for traversal that
    // needs the original ordering (e.g. registering a base type before
    // the type that inherits it).
    declarations: [Declaration] = []
