module km_compiler
import file

// ═══════════════════════════════════════════════════════════════════════
//  Komodo compiler — driver
//
//  Pipeline:  source ─Lexer▶ tokens ─Parser▶ AST ─Analyzer▶ ─Optimizer▶ AST ─Codegen▶ text
//
//  The compiler is one `module km_compiler` spread over modules/, grouped
//  by pipeline stage (the driver walks the whole tree — see main.km's
//  `sourceTree`):
//
//      km_compiler.kmm         this file — the driver + target selection
//    frontend/
//      ast.kmm                 AST node definitions
//      lexer.kmm               source text → tokens
//      parser.kmm              tokens → AST (declarations + statements)
//      parser_expr.kmm         the expression-grammar precedence climb
//    analyze/
//      types.kmm               Type: the static type lattice
//      sema.kmm                Analyzer: driver + registries
//      sema_expr.kmm           `inferExpr` — type inference
//      sema_stmt.kmm           `checkStmt` + flow narrowing
//    optimize/
//      optimize.kmm            Optimizer: constant folding / DCE (none..max)
//    codegen/
//      codegen.kmm             Codegen: driver + the function registry
//      codegen_frame.kmm       stack-frame layout + coarse type inference
//      codegen_stmt.kmm        statement lowering
//      codegen_expr.kmm        expression lowering
//      overload.kmm            overload resolution + generic monomorphisation
//    backend/
//      backend.kmm             Backend: the target-independent emit interface
//      backend_x86.kmm         X86Backend     — System V AMD64, NASM syntax
//      backend_stackvm.kmm     StackVMBackend — textual stack-VM bytecode
//      backend_c.kmm           CBackend       — portable C translation unit
//    support/
//      strindex.kmm            StrIndex: string → position hash index
//
//  The front end and `Codegen` are target-agnostic; picking a target is
//  just picking a `Backend` (see `selectBackend`).  The x86 output
//  assembles with `nasm -f elf64` and links with `gcc` against the C
//  standard library in stdlib/.  See stdlib/km_runtime.h for the ABI and
//  `komodo` for the one-shot build.
// ═══════════════════════════════════════════════════════════════════════

fn compile(source: string, target: string): string
    return compileOpt(source, target, false, "none")

// `strict` turns the analyser's style lints (implicit-any bindings,
// redundant `mut`, …) into hard errors.  Regardless of `strict`, the
// analyser always prints non-fatal warnings for bad-practice constructs
// — `x / 0`, `x == x`, `x = x`, a constant `if`, an empty loop body —
// which `strict` likewise escalates to errors.
// `opt` is one of "none" / "low" / "medium" / "max" — see optimize.kmm.
fn compileOpt(source: string, target: string, strict: bool, opt: string): string
    return compileMapped(source, target, strict, opt, [], [])

// `compileOpt` for a source that is several files merged end to end:
// `files[k]` begins at line `starts[k]` of `source`.  Diagnostics are
// then reported against the original file (`locate`), and a parse error
// is given the position of the token the parser stopped at.
fn compileMapped(source: string, target: string, strict: bool, opt: string, files: [string], starts: [int]): string
    let lexer = new Lexer(source)
    let tokens = lexer.tokenize()
    for w in lexer.warnings() do
        print(diagOne(locate(w, files, starts)))

    let parser = new Parser(tokens)
    let parsed = parser.parseProgram()?
    if parsed == null then
        throw (parser.position() + ": " + (km_error_message() or "parse error"))
    let ast: Program = parsed

    let analyzer = new Analyzer(strict)
    if target == "lint" then
        analyzer.setLintAll()
    analyzer.setSourceMap(files, starts)
    analyzer.analyze(ast)

    // `check` stops here: the analyser has run (diagnostics are printed),
    // and no optimiser or code generation is needed
    if target == "check" or target == "lint" then
        return ""

    // `header` is a pseudo-target: the C prototypes of the `export fn`s.
    if target == "header" then
        let hsrc = ""
        if #files > 0 then
            hsrc = files[0]
        return exportHeader(ast, hsrc)

    // `export fn` is implemented by the x86 backend only
    if target != "x86" and target != "x86pic" and target != "" then
        for xf in ast.functions do
            if xf.isExport then
                throw (string(xf.line) + ":" + string(xf.column) + ": export fn is not supported on target '" + target + "' yet (use the x86 target)")

    let optimizer = new Optimizer(opt)
    optimizer.run(ast)

    let backend = selectBackend(target)
    backend.setDebugInfo(files, starts)
    let gen = new Codegen(backend)
    return gen.compileProgram(ast)

extern fn km_error_message(): string?

// Rewrite a leading "LINE:COL: " (a line of the merged translation
// unit) as "file:line:COL: " in the file that line came from.  A
// message without that prefix, or an empty map, comes back unchanged.
fn locate(msg: string, files: [string], starts: [int]): string
    if #files == 0 then
        return msg
    let n = msg.length
    let i = 0
    let line = 0
    while i < n and msg[i] >= "0" and msg[i] <= "9" do
        line = line * 10 + digitVal(msg[i])
        i += 1
    if i == 0 or i >= n or msg[i] != ":" then
        return msg
    let k = 0
    let at = 0 - 1
    while k < #starts do
        if starts[k] <= line then
            at = k
        k += 1
    if at < 0 then
        return msg
    return files[at] + ":" + string(line - starts[at] + 1) + msg[i to n]

fn digitVal(c: char): int
    let d = "0123456789"
    let j = 0
    while j < 10 do
        if d[j] == c then
            return j
        j += 1
    return 0

// The one place that knows the set of targets.  Add a case here after
// writing a new `<T>Backend : Backend`.
fn selectBackend(target: string): Backend
    if target == "stackvm" then
        return new StackVMBackend()
    if target == "c" then
        return new CBackend()
    if target == "wasm" then
        let w = new CBackend()
        w.forWasm()
        return w
    if target == "x86pic" then
        // position-independent x86 for `komodo lib` shared objects
        let p = new X86Backend()
        p.forPic()
        return p
    if target == "x86" or target == "" then
        return new X86Backend()
    throw ("unknown target '" + target + "' (known: x86, stackvm, c, wasm)")

void save(asm: string, path: string)
    file::write_all(path, asm)
    print("wrote " + path)
