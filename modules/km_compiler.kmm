module km_compiler
import file

// ═══════════════════════════════════════════════════════════════════════
//  Komodo compiler — driver
//
//  Pipeline:  source ─Lexer▶ tokens ─Parser▶ AST ─Analyzer▶ ─Optimizer▶ AST ─Codegen▶ text
//
//  The compiler is one `module km_compiler` spread over modules/, grouped
//  by pipeline stage (the driver walks the whole tree — see main.km's
//  `sourceTree`):
//
//      km_compiler.kmm         this file — the driver + target selection
//    frontend/
//      ast.kmm                 AST node definitions
//      lexer.kmm               source text → tokens
//      parser.kmm              tokens → AST (declarations + statements)
//      parser_expr.kmm         the expression-grammar precedence climb
//    analyze/
//      types.kmm               Type: the static type lattice
//      sema.kmm                Analyzer: driver + registries
//      sema_expr.kmm           `inferExpr` — type inference
//      sema_stmt.kmm           `checkStmt` + flow narrowing
//    optimize/
//      optimize.kmm            Optimizer: constant folding / DCE (none..max)
//    codegen/
//      codegen.kmm             Codegen: driver + the function registry
//      codegen_frame.kmm       stack-frame layout + coarse type inference
//      codegen_stmt.kmm        statement lowering
//      codegen_expr.kmm        expression lowering
//      overload.kmm            overload resolution + generic monomorphisation
//    backend/
//      backend.kmm             Backend: the target-independent emit interface
//      backend_x86.kmm         X86Backend     — System V AMD64, NASM syntax
//      backend_stackvm.kmm     StackVMBackend — textual stack-VM bytecode
//
//  The front end and `Codegen` are target-agnostic; picking a target is
//  just picking a `Backend` (see `selectBackend`).  The x86 output
//  assembles with `nasm -f elf64` and links with `gcc` against the C
//  standard library in stdlib/.  See stdlib/km_runtime.h for the ABI and
//  build.sh for the one-shot build.
// ═══════════════════════════════════════════════════════════════════════

fn compile(source: string, target: string): string
    return compileOpt(source, target, false, "none")

// `strict` turns the analyser's style lints (implicit-any bindings,
// redundant `mut`, …) into hard errors.  Regardless of `strict`, the
// analyser always prints non-fatal warnings for bad-practice constructs
// — `x / 0`, `x == x`, `x = x`, a constant `if`, an empty loop body —
// which `strict` likewise escalates to errors.
fn compileWith(source: string, target: string, strict: bool): string
    return compileOpt(source, target, strict, "none")

// `opt` is one of "none" / "low" / "medium" / "max" — see optimize.kmm.
fn compileOpt(source: string, target: string, strict: bool, opt: string): string
    let lexer = new Lexer(source)
    let tokens = lexer.tokenize()

    let parser = new Parser(tokens)
    let ast = parser.parseProgram()

    let analyzer = new Analyzer(strict)
    analyzer.analyze(ast)

    let optimizer = new Optimizer(opt)
    optimizer.run(ast)

    let gen = new Codegen(selectBackend(target))
    return gen.compileProgram(ast)

// The one place that knows the set of targets.  Add a case here after
// writing a new `<T>Backend : Backend`.
fn selectBackend(target: string): Backend
    if target == "stackvm" then
        return new StackVMBackend()
    if target == "x86" or target == "" then
        return new X86Backend()
    throw ("unknown target '" + target + "' (known: x86, stackvm)")

void save(asm: string, path: string)
    file::write_all(path, asm)
    print("wrote " + path)
