module km_compiler

// ═══════════════════════════════════════════════════════════════════════
//  Codegen — stack-frame layout and static type inference.
//
//  Locals (params included) each get an 8-byte slot; `slotOf` returns the
//  slot's byte offset from the frame base (8, 16, 24, …), which every
//  backend interprets for its target.  `exprType` is a coarse
//  float / string / int classifier used to pick between code paths and
//  to tag call arguments.
// ═══════════════════════════════════════════════════════════════════════

mut Codegen::hasLocal(name: string): bool
    let i = 0
    while i < #m_names do
        if m_names[i] == name then
            return true
        i += 1
    return false

void Codegen::addLocal(name: string, ty: string, immut: bool)
    if hasLocal(name) then
        return
    m_frame += 8
    m_names += [name]
    m_offsets += [m_frame]
    m_types += [ty]
    m_immut += [immut]

mut Codegen::immutOf(name: string): bool
    let i = 0
    while i < #m_names do
        if m_names[i] == name then
            return m_immut[i]
        i += 1
    return false

mut Codegen::slotOf(name: string): int
    let i = 0
    while i < #m_names do
        if m_names[i] == name then
            return m_offsets[i]
        i += 1
    return 0

mut Codegen::typeOf(name: string): string
    let i = 0
    while i < #m_names do
        if m_names[i] == name then
            return m_types[i]
        i += 1
    return "int"

// Coarse "float" / "string" / "int" classification of an expression's
// result — enough to pick between the integer and SSE code paths and to
// tag call arguments.
//
// The semantic analyser (sema*.kmm) has already resolved a static type
// for every expression it saw and left the coarse form on
// `resolvedType`; trust it.  The fall-through below still runs for nodes
// the analyser never visited — chiefly the fresh lowerings a macro use
// re-synthesises here at codegen time.
mut Codegen::exprType(e: Expression?): string
    if e == null then
        return "int"
    let rt = e.resolvedType
    if rt != null then
        return rt
    if e is FloatLiteral then
        return "float"
    if e is StringLiteral then
        return "string"
    if e is Identifier then
        let ev = envTypeOf(e.name)
        if ev != "" then
            return ev
        if not hasLocal(e.name) and isCurField(e.name) then
            return fieldTypeOf(m_curClass, e.name)
        if not hasLocal(e.name) and isMacro(e.name) then
            return exprType(macroExprOf(e.name))
        if not hasLocal(e.name) and isGlobalVar(e.name) then
            return globalTypeOf(e.name)
        return typeOf(e.name)
    if e is NewExpr then
        return e.typeName
    if e is MemberExpr then
        return fieldTypeOf(exprType(e.object), e.member)
    if e is SliceExpr then
        // a slice of a string is a string; of an array, an array
        return exprType(e.object)
    if e is UnaryOp then
        if e.op == "#" then
            return "int"
        return exprType(e.operand)
    if e is BinaryOp then
        if e.op == "is" or e.op == "in" then
            return "int"
        if isCompareOp(e.op) then
            return "int"
        // string operators:  a + b   and   s * n
        if e.op == "+" and (exprType(e.left) == "string" or exprType(e.right) == "string") then
            return "string"
        if e.op == "*" and exprType(e.left) == "string" then
            return "string"
        // arithmetic and the `and`/`or` value-select idiom: a float on
        // either side wins (`n > 0 and 1.0 or 0.0` is a float).
        if exprType(e.left) == "float" or exprType(e.right) == "float" then
            return "float"
        if e.op == "and" or e.op == "or" then
            return exprType(e.right)
        return "int"
    if e is CallExpr then
        if e.receiver != null then
            let ro = resolveMethodOwner(exprType(e.receiver), e.name[1 to e.name.length])
            if ro != "" then
                return fnRet(ro + "__" + e.name[1 to e.name.length])
        let d = dotIndex(e.name)
        // a dotted call may name an overload set / template through its
        // "_"-joined form (`algorithm.sum` → overloaded `algorithm_sum`)
        let cn = e.name
        if d > 0 then
            let r = e.name[0 to d]
            let mth = e.name[(d + 1) to e.name.length]
            if isMethodReceiver(r) then
                let owner = resolveMethodOwner(receiverType(r), mth)
                if owner != "" then
                    return fnRet(owner + "__" + mth)
            cn = m_backend.mangle(e.name)
        if isTemplate(cn) then
            fillDefaults(e, templateDeclOf(cn))
        if isTemplate(cn) and #templateDeclOf(cn).params == #e.args then
            let gsym = ensureInstance(cn, tplArgTypes(e.args))
            return lookupRet(gsym)
        if countSourceName(cn) >= 2 then
            return overloadRet(cn, e.args)
        return fnRet(e.name)
    return "int"

// Slot type for a `case Type(field: bind)` binding — the field's declared
// type with any trailing "?" removed (a nullable object still lives in an
// 8-byte word).
mut Codegen::structPatBindType(typeName: string, field: string): string
    let ft = fieldTypeOf(typeName, field)
    if #ft > 0 and ft[#ft - 1] == "?" then
        return ft[0 to (#ft - 1)]
    return ft

// Pre-scan a statement list, reserving a slot for every variable it (or a
// nested block) declares.
void Codegen::collectLocals(stmts: [Statement])
    for s in stmts do
        if s is VarDecl and not s.immutable then
            let ty = "int"
            let dt = typeOrInt(s.declaredType)
            if dt == "float" or dt == "string" or isObjType(dt) or isArrayType(dt) then
                ty = dt
            else if s.init != null then
                let it = exprType(s.init)
                if it == "float" or it == "string" or isObjType(it) or isArrayType(it) then
                    ty = it
            addLocal(s.name, ty, s.immutable)
        // `let x be expr` is a scoped macro, not a stack local — no slot.
        else if s is IfStmt then
            collectLocals(s.thenBody)
            collectLocals(s.elseBody)
        else if s is WhileStmt then
            collectLocals(s.body)
        else if s is ForStmt then
            addLocal(s.varName, "int", true)
            collectLocals(s.body)
        else if s is ForInStmt then
            let et = elemTypeOf(exprType(s.iterable))
            let evt = "int"
            if et == "float" or et == "string" or isObjType(et) then
                evt = et
            addLocal(s.varName, evt, true)
            addLocal(s.varName + "#i", "int", false)
            addLocal(s.varName + "#a", "int", false)
            collectLocals(s.body)
        else if s is MatchStmt then
            s.tmpName = "match#" + string(m_matchTmp)
            m_matchTmp += 1
            addLocal(s.tmpName, "int", false)
            for c in s.cases do
                let pat = c.pattern
                if pat is StructPattern then
                    for fp in pat.fields do
                        if fp.bind != "" then
                            addLocal(fp.bind, structPatBindType(pat.typeName, fp.field), false)
                collectLocals(c.body)
