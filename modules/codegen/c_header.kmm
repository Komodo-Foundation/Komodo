module km_compiler

// ═══════════════════════════════════════════════════════════════════════
//  C header generation for `export fn` (`komodo --emit-header`).
//
//  One prototype per exported function, mapped onto <stdint.h> types, in
//  an `extern "C"` block so the header serves C and C++ alike.  Every
//  `extern type` handle an exported signature mentions becomes a
//  `typedef void *Name;`.
// ═══════════════════════════════════════════════════════════════════════

fn headerCType(t: string, handles: [string]): string
    let b = t
    if #b > 0 and b[#b - 1] == "?" then
        b = b[0:(#b - 1)]
    if b == "int" or b == "i64" then
        return "int64_t"
    if b == "uint" or b == "u64" then
        return "uint64_t"
    if b == "i8" or b == "i16" or b == "i32" then
        return "int" + b[1:#b] + "_t"
    if b == "u8" or b == "u16" or b == "u32" then
        return "uint" + b[1:#b] + "_t"
    if b == "bool" then
        return "bool"
    if b == "float" or b == "f64" then
        return "double"
    if b == "f32" then
        return "float"
    if b == "string" then
        return "const char *"
    return b                        // an `extern type` handle

fn headerIsHandle(t: string): bool
    let b = t
    if #b > 0 and b[#b - 1] == "?" then
        b = b[0:(#b - 1)]
    let known = ["int", "i64", "uint", "u64", "i8", "i16", "i32", "u8", "u16", "u32", "bool", "float", "f64", "f32", "string"]
    return not (b in known)

fn headerParamName(n: string): string
    let reserved = ["new", "class", "delete", "default", "this", "template", "typename", "namespace", "operator", "private", "public", "register", "long", "short", "signed", "unsigned", "char", "double", "float", "int", "void", "struct", "union", "enum", "switch", "case", "for", "while", "do", "if", "else", "return", "break", "continue", "const", "static", "extern", "auto", "goto", "sizeof", "typedef", "volatile", "virtual", "try", "catch", "throw", "friend", "inline", "bool", "true", "false", "export", "restrict", "protected", "explicit", "mutable", "using", "asm", "main"]
    if n in reserved then
        return n + "_"
    return n

// Include-guard token from a file path: basename, upper-cased,
// non-alphanumerics → `_`.
fn headerGuard(path: string): string
    let cut = 0
    let i = 0
    while i < #path do
        if path[i] == "/" then
            cut = i + 1
        i += 1
    let lower = "abcdefghijklmnopqrstuvwxyz"
    let upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    let out = "KM_"
    let stop = #path
    i = cut
    while i < #path do
        if path[i] == "." then
            stop = i
        i += 1
    i = cut
    while i < stop do
        let c = path[i]
        let k = 0
        let r = "_"
        if c >= "0" and c <= "9" then
            r = string(c)
        while k < 26 do
            if c == lower[k] or c == upper[k] then
                r = string(upper[k])
            k += 1
        out = out + r
        i += 1
    return out + "_H"

fn exportHeader(prog: Program, srcPath: string): string
    let handles: [string] = []
    let protos: [string] = []
    let count = 0
    for fd in prog.functions do
        if not fd.isExport then
            continue
        count += 1
        let ps: [string] = []
        for p in fd.params do
            let pt = p.declaredType or "int"
            let ct = headerCType(pt, handles)
            if headerIsHandle(pt) and not (ct in handles) then
                handles += [ct]
            let psep = " "
            if ct[#ct - 1] == "*" then
                psep = ""
            ps += [ct + psep + headerParamName(p.name)]
        let rt = "void"
        if not fd.isVoid and fd.returnType != null then
            rt = headerCType(fd.returnType or "int", handles)
            if headerIsHandle(fd.returnType or "int") and not (rt in handles) then
                handles += [rt]
        let plist = "void"
        if #ps > 0 then
            plist = join(ps, ", ")
        let sep = " "
        if rt[#rt - 1] == "*" then
            sep = ""
        protos += [rt + sep + fd.name + "(" + plist + ");"]
    if count == 0 then
        throw "no `export fn` declarations to put in a header"
    let g = headerGuard(srcPath)
    let o = "/* Generated by `komodo --emit-header` from " + srcPath + ". Do not edit.\n"
    o = o + " *\n"
    o = o + " * Strings are NUL-terminated UTF-8. A `const char *` returned by a function\n"
    o = o + " * points into the Komodo heap: copy it before calling back into Komodo.\n"
    o = o + " * Link with -no-pie -l:libgc.so.1 -lm. */\n"
    o = o + "#ifndef " + g + "\n#define " + g + "\n\n"
    o = o + "#include <stdint.h>\n#ifndef __cplusplus\n#include <stdbool.h>\n#endif\n\n"
    o = o + "#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n"
    for h in handles do
        o = o + "typedef void *" + h + ";\n"
    if #handles > 0 then
        o = o + "\n"
    for pr in protos do
        o = o + pr + "\n"
    o = o + "\n#ifdef __cplusplus\n}\n#endif\n\n#endif /* " + g + " */\n"
    return o
