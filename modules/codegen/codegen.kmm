module km_compiler

// ═══════════════════════════════════════════════════════════════════════
//  Codegen — the target-independent lowering pass.
//
//  It walks the AST once and drives a `Backend` (see backend.kmm); it
//  never names a machine instruction or an output syntax.  The work is
//  spread across sibling files, all `module km_compiler`:
//
//      codegen.kmm         this file — class state, the driver, and the
//                          function-signature registry
//      codegen_frame.kmm   stack-frame layout + static type inference
//      codegen_stmt.kmm    statement lowering
//      codegen_expr.kmm    expression lowering
//      backend.kmm         the Backend interface + shared bookkeeping
//      backend_x86.kmm     X86Backend     — System V AMD64 / NASM
//      backend_stackvm.kmm StackVMBackend — textual stack-VM bytecode
//
//  Every Komodo call — user function or standard-library one — is
//  lowered identically; nothing about `print`, `algorithm.sort`, … is
//  special-cased.  A dotted name `a.b` mangles to the symbol `a_b`; a
//  call target not defined in the program is left for the target's
//  linker / loader to resolve.
//
//  Result-value convention (per backend):  int / pointer / string in the
//  integer accumulator, float in the float accumulator.
// ═══════════════════════════════════════════════════════════════════════

class Codegen
public
    constructor(backend: Backend)
        m_backend = backend

    mut compileProgram(prog: Program): string
        m_backend.begin()

        // Pass -1: record top-level `let NAME be EXPR` macros in the
        // outermost macro scope. They are not lowered here — each use
        // site re-lowers the expression. Nested `be` bindings push
        // further scopes as their blocks are lowered (see genStmt).
        // The semantic analyser has already rejected duplicates.
        for mac in prog.macros do
            pushMacro(mac.name, mac.init)

        // Pass -0.5: top-level `let` variables. Record name → coarse type
        // for load/store lowering, reserve one storage slot each in the
        // backend, and keep the decls so `main` can run the initialisers.
        m_globalDecls = prog.globals
        for g in prog.globals do
            let gty = g.resolvedType or "int"
            m_globalNames += [g.name]
            m_globalTypes += [gty]
            m_backend.declareGlobal(g.name, gty)

        // Enum variants become plain integer constants: `Color::RED` (which
        // the parser has already reduced to the bare name `RED`) lowers to
        // its 0-based ordinal within its enum.
        for en in prog.enums do
            let ord = 0
            for v in en.variants do
                if not (v in m_enumNames) then
                    m_enumNames += [v]
                    m_enumOrdinals += [ord]
                ord += 1

        // Pass 0: register every struct / class as an object type (name →
        // ordered fields) and lower each method / constructor to a free
        // function `Type.method` whose first parameter is the receiver
        // `self`.  Types are registered parent-before-child so an inheriting
        // type can prepend its parent's fields (see `registerTypeFull`).
        let ordered = orderTypesByInheritance(prog)
        for d in ordered do
            if d is StructDecl and d.isExtern then
                // `extern type T` — an opaque C handle.  No layout, no
                // type id, no `new`; its values are plain integers.
                continue
            else if d is StructDecl then
                registerTypeFull(d.name, false, d.isAbstract, d.parent, memberNames(d.members), memberTypes(d.members), memberDefaults(d.members))
            else if d is ClassDecl then
                registerTypeFull(d.name, true, d.isAbstract, d.parent, fieldNames(d.fields), fieldTypes(d.fields), fieldDefaults(d.fields))
                for m in d.methods do
                    let mfn = new FunctionDecl(methodSym(d.name, m))
                    let ps: [Param] = [new Param("self", d.name)]
                    for mp in m.params do
                        ps += [mp]
                    mfn.params = ps
                    mfn.body = m.body
                    mfn.isVoid = m.isVoid
                    mfn.isMut = m.isMut
                    mfn.isConstructor = m.isConstructor
                    mfn.returnType = m.returnType
                    mfn.ownerClass = d.name
                    prog.functions += [mfn]
                    registerMethod(d.name, m.name)

        // Pass 0b: assign vtable slots now that every type + its own
        // methods are registered.
        buildVtables()

        // Pass 0c: synthesise a `km_deepcopy_<T>` helper for every value
        // type, so `copy(x)` has something to call.  Only when the program
        // actually uses `copy` — otherwise the output is untouched.
        if prog.usesCopy then
            synthDeepCopiers(prog)

        // Pass 1-pre: sift generic templates (a free function with one or
        // more untyped parameters) out of `prog.functions`.  They are
        // never emitted as-is — each call site monomorphizes a copy (see
        // `ensureInstance`).  Removing them keeps every later
        // index-aligned loop over `prog.functions` / `m_fn*` intact.
        let concreteFns: [FunctionDecl] = []
        for f in prog.functions do
            if isTemplateDecl(f) then
                m_tplNames += [f.name]
                m_tplDecls += [f]
            else
                concreteFns += [f]
        prog.functions = concreteFns

        // Pass 1: collect every function's signature (forward references
        // and recursion are allowed).  Concrete duplicates were rejected
        // by the semantic analyser; overloaded free functions (same name,
        // different parameter types) sit side by side here.
        for func in prog.functions do
            m_fnNames += [func.name]
            m_fnRets += [retTypeOf(func.returnType)]
            m_fnKinds += [funcKind(func)]
            m_fnArity += [#func.params]
            m_fnSigs += [paramSig(func)]
            m_fnLink += [func.name]

        // Pass 1a: two free overloads with the identical normalized
        // parameter-type list are a genuine duplicate (sema exempts every
        // same-name set from its duplicate check to let overloading
        // through, so this is where an exact repeat is caught).
        let da = 0
        while da < #prog.functions do
            if isFreeFn(prog.functions[da]) then
                let db = da + 1
                while db < #prog.functions do
                    if m_fnNames[db] == m_fnNames[da] and isFreeFn(prog.functions[db]) and sigsEqual(m_fnSigs[da], m_fnSigs[db]) then
                        throw ("duplicate function '" + m_fnNames[da] + "' — two overloads have identical parameter types")
                    db += 1
            da += 1

        // Pass 1b: give every overloaded free function a unique link name
        // (source name + arity + parameter types), then declare each
        // callable symbol.  An `extern` / prototype keeps its raw name
        // and is left to the linker.
        let pi1 = 0
        while pi1 < #prog.functions do
            if isFreeFn(prog.functions[pi1]) and countSourceName(m_fnNames[pi1]) >= 2 then
                let ln = overloadSym(m_fnNames[pi1], m_fnSigs[pi1])
                m_fnLink[pi1] = ln
                prog.functions[pi1].linkName = ln
            pi1 += 1
        pi1 = 0
        while pi1 < #prog.functions do
            let fdef = prog.functions[pi1]
            if not fdef.isExtern and not fdef.isPrototype then
                m_backend.declareFn(m_fnLink[pi1])
            pi1 += 1

        // Pass 2: lower each body.  "Returns on every path" and the
        // `fn` / `mut` mutation contract were enforced by the semantic
        // analyser (sema*.kmm).
        for func in prog.functions do
            if func.isExtern or func.isPrototype then
                continue
            genFunction(func)

        // Pass 2b: emit every monomorphized template instance requested
        // during lowering.  Draining may enqueue further instances (an
        // instance body calling the template with new argument types).
        // sema never type-checks these bodies (the parameter types are
        // per-call-site); the backend epilogue supplies a default return.
        let gi = 0
        while gi < #m_genQueue do
            genFunction(m_genQueue[gi])
            gi += 1

        // Pass 2b: one native-ABI trampoline per Komodo function passed to
        // C as a callback (collected while lowering `extern` calls).
        for nm in m_trampNames do
            m_backend.emitTrampoline(m_backend.mangle(nm), fnArity(nm))

        // Emit the per-class vtables + the type-id → vtable index table.
        emitVtables()

        return m_backend.finish()

    // ── object-type registry ──────────────────────────────────────

    // `_`-joined so the symbol needs no mangling and its emitted label
    // matches the call site.
    fn methodSym(className: string, m: FunctionDecl): string
        if m.isConstructor then
            return className + "__ctor"
        return className + "__" + m.name

    fn ctorSym(className: string): string
        return className + "__ctor"

    // A class with no `constructor` of its own inherits its nearest
    // ancestor's (interpreter rule).  Falls back to `Name__ctor`.
    mut resolveCtorSym(className: string): string
        let cur = className
        let guard = 0
        while cur != "" do
            let s = cur + "__ctor"
            if hasFn(s) then
                return s
            cur = typeParentOf(cur)
            guard += 1
            if guard > 10000 then
                return className + "__ctor"
        return className + "__ctor"

    fn methodSymOf(className: string, method: string): string
        return className + "__" + method

    mut memberNames(ms: [StructMember]): [string]
        let out: [string] = []
        for m in ms do
            out += [m.name]
        return out

    mut memberTypes(ms: [StructMember]): [string]
        let out: [string] = []
        for m in ms do
            out += [typeOrInt(m.declaredType)]
        return out

    mut fieldNames(fs: [ClassField]): [string]
        let out: [string] = []
        for f in fs do
            out += [f.name]
        return out

    mut fieldTypes(fs: [ClassField]): [string]
        let out: [string] = []
        for f in fs do
            out += [typeOrInt(f.declaredType)]
        return out

    mut memberDefaults(ms: [StructMember]): [Expression?]
        let out: [Expression?] = []
        for m in ms do
            out += [m.defaultValue]
        return out

    mut fieldDefaults(fs: [ClassField]): [Expression?]
        let out: [Expression?] = []
        for f in fs do
            out += [f.defaultValue]
        return out

    // A declared-type string reduced to codegen's coarse form: `?` (which
    // codegen never depended on) dropped, `null` → "int".
    mut typeOrInt(t: string?): string
        let s = stripOpt(t)
        if s == null then
            return "int"
        return s

    fn parentOrEmpty(p: string?): string
        if p == null then
            return ""
        return p

    // Order structs+classes so every type comes after its parent — an
    // inheriting type prepends its (already-registered) parent's fields.
    mut orderTypesByInheritance(prog: Program): [Declaration]
        let work: [Declaration] = []
        for st in prog.structs do
            work += [st]
        for cl in prog.classes do
            work += [cl]
        let ordered: [Declaration] = []
        let done: [string] = []
        let guard = 0
        while #work > 0 do
            let remaining: [Declaration] = []
            let progressed = false
            for d in work do
                let par = declParent(d)
                if par == "" or (par in done) then
                    ordered += [d]
                    done += [declName(d)]
                    progressed = true
                else
                    remaining += [d]
            work = remaining
            if not progressed then
                throw ("cyclic or unresolved type inheritance near '" + declName(work[0]) + "'")
            guard += 1
            if guard > 10000 then
                throw "type inheritance ordering did not converge"
        return ordered

    // `parent` / `name` are on `StructDecl` / `ClassDecl`, not `Declaration`.
    mut declParent(d: Declaration): string
        if d is StructDecl then
            return parentOrEmpty(d.parent)
        if d is ClassDecl then
            return parentOrEmpty(d.parent)
        return ""

    mut declName(d: Declaration): string
        if d is StructDecl then
            return d.name
        if d is ClassDecl then
            return d.name
        return ""

    // Register a type, prepending its parent's flattened fields (names,
    // types and default-value expressions) ahead of its own.
    mut registerTypeFull(name: string, isClass: bool, isAbs: bool, parent: string?, fnames: [string], ftypes: [string], fdefs: [Expression?])
        if (name in m_typeNames) then
            throw ("duplicate type '" + name + "'")
        let par = parentOrEmpty(parent)
        let allNames: [string] = []
        let allTypes: [string] = []
        let allDefs: [Expression?] = []
        if par != "" then
            let pi = typeIndex(par)
            if pi < 0 then
                throw ("type '" + name + "' inherits unknown type '" + par + "'")
            for x in m_typeFieldNames[pi] do
                allNames += [x]
            for x in m_typeFieldTypes[pi] do
                allTypes += [x]
            for x in m_typeFieldDefaults[pi] do
                allDefs += [x]
        let k = 0
        while k < #fnames do
            allNames += [fnames[k]]
            allTypes += [ftypes[k]]
            allDefs += [fdefs[k]]
            k += 1
        m_typeNames += [name]
        m_typeIsClass += [isClass]
        m_typeIsAbstract += [isAbs]
        m_typeParent += [par]
        m_typeFieldNames += [allNames]
        m_typeFieldTypes += [allTypes]
        m_typeFieldDefaults += [allDefs]
        m_typeOwnMethods += [[]]

    // ── `copy(x)` deep-copy helpers ───────────────────────────────
    //
    //  For every non-abstract value type `T` the program can `copy`, a
    //  function `km_deepcopy_T(src: T?): T?` is synthesised here and
    //  lowered by the ordinary pipeline (Pass 1 registers it, Pass 2
    //  emits it).  Its body clones `src` field by field: a struct/class
    //  field recurses through that type's own helper, an array field is
    //  buffer-cloned, everything else (scalars, strings, enums, opaque
    //  handles, constructor-based classes) is shared by value.  Cyclic
    //  data would recurse forever — the same caveat as a hand-written C
    //  deep copy.

    mut synthDeepCopiers(prog: Program)
        // Which types get a helper — computed first so a field can refer
        // to a type processed later.
        for d in prog.structs do
            if not d.isExtern and not d.isAbstract and d.container == null then
                m_deepCopierTypes += [d.name]
        for c in prog.classes do
            if not c.isAbstract and not classHasCtor(c) then
                m_deepCopierTypes += [c.name]
        for nm in m_deepCopierTypes do
            prog.functions += [makeDeepCopier(nm)]

    mut deepCopierExists(name: string): bool
        return (name in m_deepCopierTypes)

    fn classHasCtor(c: ClassDecl): bool
        for m in c.methods do
            if m.isConstructor then
                return true
        return false

    mut makeDeepCopier(typeName: string): FunctionDecl
        let ti = typeIndex(typeName)
        let fnames = m_typeFieldNames[ti]
        let ftypes = m_typeFieldTypes[ti]
        let f = new FunctionDecl("km_deepcopy_" + typeName)
        f.params = [new Param("src", typeName + "?")]
        f.returnType = typeName + "?"

        let body: [Statement] = []
        // if src == null then return src
        let guard = new IfStmt()
        guard.cond = new BinaryOp("==", new Identifier("src"), new NullLiteral())
        let g1 = new ReturnStmt()
        g1.value = new Identifier("src")
        guard.thenBody = [g1]
        body += [guard]
        // let c = new T()
        let cdecl = new VarDecl("c")
        cdecl.declaredType = typeName
        cdecl.init = new NewExpr(typeName, [])
        body += [cdecl]
        // c.<field> = <clone of src.<field>>
        let i = 0
        while i < #fnames do
            let fa = new FieldAssignStmt()
            fa.object = new Identifier("c")
            fa.field = fnames[i]
            fa.op = "="
            fa.value = fieldCopyExpr(new MemberExpr(new Identifier("src"), fnames[i]), ftypes[i])
            body += [fa]
            i += 1
        let ret = new ReturnStmt()
        ret.value = new Identifier("c")
        body += [ret]
        f.body = body
        return f

    // How field `read` (already an lvalue expression) is duplicated.
    mut fieldCopyExpr(read: Expression, ftype: string): Expression
        let base = stripOpt(ftype) or ftype
        if isArrayType(base) then
            // `src.f[0 to #src.f]` — a fresh buffer (elements shared).
            let sl = new SliceExpr()
            sl.object = read
            return sl
        if deepCopierExists(base) then
            return new CallExpr("km_deepcopy_" + base, [read])
        return read

    // Record a method name declared directly on `className` (used to
    // resolve inherited method calls to the class that defines them).
    mut registerMethod(className: string, methodName: string)
        let ti = typeIndex(className)
        if ti < 0 then
            return
        m_typeOwnMethods[ti] += [methodName]

    // The default-value expression for field `i` of `typeName`, or null.
    mut fieldDefaultAt(typeName: string, i: int): Expression?
        let ti = typeIndex(typeName)
        if ti < 0 then
            return null
        let defs = m_typeFieldDefaults[ti]
        if i < 0 or i >= #defs then
            return null
        return defs[i]

    // Coarse type of a field by slot index (for positional `new T(...)`).
    mut fieldTypeAt(typeName: string, i: int): string
        let ti = typeIndex(typeName)
        if ti < 0 then
            return "int"
        let ts = m_typeFieldTypes[ti]
        if i < 0 or i >= #ts then
            return "int"
        return ts[i]

    mut isAbstractType(name: string): bool
        let ti = typeIndex(name)
        if ti < 0 then
            return false
        return m_typeIsAbstract[ti]

    mut typeParentOf(name: string): string
        let ti = typeIndex(name)
        if ti < 0 then
            return ""
        return m_typeParent[ti]

    // True if `t` descends from `ancestor` (strictly — not the same type).
    mut isDescendantOf(t: string, ancestor: string): bool
        let cur = typeParentOf(t)
        let guard = 0
        while cur != "" do
            if cur == ancestor then
                return true
            cur = typeParentOf(cur)
            guard += 1
            if guard > 10000 then
                return false
        return false

    // The type ids matched by `x is Name` — `Name` itself plus every type
    // that descends from it (all known at compile time).
    mut descendantIds(name: string): [int]
        let out: [int] = [typeIndex(name)]
        let i = 0
        while i < #m_typeNames do
            if isDescendantOf(m_typeNames[i], name) then
                out += [i]
            i += 1
        return out

    // A class needs a vtable when it takes part in inheritance — it has a
    // parent, or some other class names it as parent.
    mut needsVtable(name: string): bool
        if not typeIsClass(name) then
            return false
        if typeParentOf(name) != "" then
            return true
        let i = 0
        while i < #m_typeNames do
            if m_typeParent[i] == name then
                return true
            i += 1
        return false

    // Assign vtable slots.  Registry order is parent-before-child, so a
    // child inherits its parent's slot list (overrides reuse the slot)
    // and appends its own new methods.
    mut buildVtables()
        let i = 0
        while i < #m_typeNames do
            m_typeSlotNames += [[]]
            i += 1
        i = 0
        while i < #m_typeNames do
            if m_typeIsClass[i] and needsVtable(m_typeNames[i]) then
                let slots: [string] = []
                let par = m_typeParent[i]
                if par != "" then
                    let pi = typeIndex(par)
                    if pi >= 0 then
                        for s in m_typeSlotNames[pi] do
                            slots += [s]
                for mn in m_typeOwnMethods[i] do
                    if mn != "constructor" and not (mn in slots) then
                        slots += [mn]
                // An abstract base that never declares an interface method
                // itself still needs a slot for it, so a `base.method()`
                // call through a subclass instance dispatches virtually.
                // Only methods every concrete subclass supplies count as
                // the interface (a helper unique to one backend does not).
                if m_typeIsAbstract[i] then
                    let d = 0
                    while d < #m_typeNames do
                        if isDescendantOf(m_typeNames[d], m_typeNames[i]) and not m_typeIsAbstract[d] then
                            for mn in m_typeOwnMethods[d] do
                                if mn != "constructor" and not (mn in slots) and allConcreteHave(m_typeNames[i], mn) then
                                    slots += [mn]
                        d += 1
                m_typeSlotNames[i] = slots
            i += 1

    // Does every concrete (non-abstract) descendant of `base` define `mn`?
    mut allConcreteHave(base: string, mn: string): bool
        let d = 0
        while d < #m_typeNames do
            if isDescendantOf(m_typeNames[d], base) and not m_typeIsAbstract[d] then
                if not (mn in m_typeOwnMethods[d]) and resolveMethodOwner(m_typeNames[d], mn) == "" then
                    return false
            d += 1
        return true

    // Vtable slot of `method` for a receiver statically typed `className`,
    // or -1 when the call can be a direct (non-virtual) one.
    mut methodSlotOf(className: string, method: string): int
        let ti = typeIndex(className)
        if ti < 0 then
            return 0 - 1
        let slots = m_typeSlotNames[ti]
        let i = 0
        while i < #slots do
            if slots[i] == method then
                return i
            i += 1
        return 0 - 1

    // Drive the backend's vtable emission: one `__vt_<id>` per class with
    // slots, resolving each slot to the nearest declaring class's symbol.
    mut emitVtables()
        m_backend.beginVtables(#m_typeNames)
        let i = 0
        while i < #m_typeNames do
            // An abstract class is never instantiated, so its own vtable
            // is dead — and some slots may have no concrete owner yet.
            if #m_typeSlotNames[i] > 0 and not m_typeIsAbstract[i] then
                let labels: [string] = []
                for slotName in m_typeSlotNames[i] do
                    let owner = resolveMethodOwner(m_typeNames[i], slotName)
                    labels += [owner + "__" + slotName]
                m_backend.setVtable(i, labels)
            i += 1

    // The class that actually declares `method` for a receiver statically
    // typed `className` — walk up the parent chain, then (for an abstract
    // base that leaves an interface method to its subclasses) the first
    // descendant that supplies it.  "" if none.
    mut resolveMethodOwner(className: string, method: string): string
        let cur = className
        let guard = 0
        while cur != "" do
            let ti = typeIndex(cur)
            if ti >= 0 and (method in m_typeOwnMethods[ti]) then
                return cur
            cur = typeParentOf(cur)
            guard += 1
            if guard > 10000 then
                return ""
        let ci = typeIndex(className)
        if ci >= 0 and m_typeIsAbstract[ci] then
            let d = 0
            while d < #m_typeNames do
                if isDescendantOf(m_typeNames[d], className) and (method in m_typeOwnMethods[d]) then
                    return m_typeNames[d]
                d += 1
        return ""

    mut isObjType(name: string): bool
        return (name in m_typeNames)

    // ── enum variants (name → ordinal) ────────────────────────────

    mut isEnumVariant(name: string): bool
        return (name in m_enumNames)

    fn isArrayType(t: string): bool
        return #t > 0 and t[0] == "["

    // `"[[string]]"` → `"[string]"`, `"[int]"` → `"int"`, else unchanged.
    fn elemTypeOf(t: string): string
        if #t >= 2 and t[0] == "[" and t[#t - 1] == "]" then
            return t[1 to (#t - 1)]
        return t

    // Field-slot indices in positional-constructor order, matching the
    // interpreter's `reorder_constructible_fields`: required fields first
    // (declaration order), then this type's own defaulted fields, then
    // inherited defaulted ones.
    mut ctorFieldOrder(typeName: string): [int]
        let ti = typeIndex(typeName)
        if ti < 0 then
            return []
        let defs = m_typeFieldDefaults[ti]
        let par = typeParentOf(typeName)
        let pc = 0
        if par != "" then
            let pi = typeIndex(par)
            if pi >= 0 then
                pc = #m_typeFieldNames[pi]
        let req: [int] = []
        let ownOpt: [int] = []
        let inhOpt: [int] = []
        let i = 0
        while i < #defs do
            if defs[i] == null then
                req += [i]
            else if i >= pc then
                ownOpt += [i]
            else
                inhOpt += [i]
            i += 1
        let out: [int] = []
        for x in req do
            out += [x]
        for x in ownOpt do
            out += [x]
        for x in inhOpt do
            out += [x]
        return out

    mut enumOrdinal(name: string): int
        let i = 0
        while i < #m_enumNames do
            if m_enumNames[i] == name then
                return m_enumOrdinals[i]
            i += 1
        return 0

    mut hasFn(name: string): bool
        return (name in m_fnNames)

    // `a` is a bare Komodo function name used as an `extern` call argument
    // — codegen passes C a pointer to that function's trampoline.
    mut isCallbackArg(a: Identifier): bool
        let nm = a.name
        if hasLocal(nm) or isMacro(nm) or isGlobalVar(nm) or isCurField(nm) then
            return false
        if not hasFn(nm) then
            return false
        let k = fnKind(nm)
        return k != "" and k != "extern"

    mut recordTramp(name: string)
        if not (name in m_trampNames) then
            m_trampNames += [name]

    // ── macro registry ────────────────────────────────────────────
    //
    // `m_macroNames` / `m_macroExprs` are a stack. Entering a block
    // records its length (`macroScopeMark`); leaving the block truncates
    // back to that mark (`macroScopeRestore`), so a `be` binding is
    // visible only within its enclosing block. Lookup scans from the top
    // of the stack, so an inner binding shadows an outer one.

    mut isMacro(name: string): bool
        return (name in m_macroNames)

    mut macroExprOf(name: string): Expression?
        let i = #m_macroNames - 1
        while i >= 0 do
            if m_macroNames[i] == name then
                return m_macroExprs[i]
            i -= 1
        return null

    mut macroScopeMark(): int
        return #m_macroNames

    void macroScopeRestore(mark: int)
        while #m_macroNames > mark do
            m_macroNames = m_macroNames[0 to (#m_macroNames - 1)]
            m_macroExprs = m_macroExprs[0 to (#m_macroExprs - 1)]

    void pushMacro(name: string, e: Expression?)
        if e == null then
            throw ("macro '" + name + "' has no value")
        m_macroNames += [name]
        m_macroExprs += [e]

    // ── top-level variable registry ─────────────────────────────

    mut isGlobalVar(name: string): bool
        return (name in m_globalNames)

    mut globalTypeOf(name: string): string
        let i = 0
        while i < #m_globalNames do
            if m_globalNames[i] == name then
                return m_globalTypes[i]
            i += 1
        return "int"

    // Evaluate each top-level initialiser once and store it into its
    // slot.  Emitted at the very top of `main`, in source order, so a
    // later initialiser can read an earlier global.
    void genGlobalInits()
        for g in m_globalDecls do
            if g.init != null then
                genExpr(g.init)
                m_backend.storeGlobal(g.name, g.resolvedType or "int")

    mut typeIsClass(name: string): bool
        let ti = typeIndex(name)
        if ti < 0 then
            return false
        return m_typeIsClass[ti]

    mut typeIndex(name: string): int
        let i = 0
        while i < #m_typeNames do
            if m_typeNames[i] == name then
                return i
            i += 1
        return 0 - 1

    // The runtime type id stored in an object's header word — its index
    // in the registry (structs and classes share one id space).
    mut typeIdOf(name: string): int
        return typeIndex(name)

    mut objFieldCount(typeName: string): int
        let ti = typeIndex(typeName)
        if ti < 0 then
            return 0
        return #m_typeFieldNames[ti]

    mut fieldIndexOf(typeName: string, field: string): int
        let ti = typeIndex(typeName)
        if ti < 0 then
            throw ("unknown type '" + typeName + "'")
        let names = m_typeFieldNames[ti]
        let i = 0
        while i < #names do
            if names[i] == field then
                return i
            i += 1
        throw ("type '" + typeName + "' has no field '" + field + "'")

    mut fieldTypeOf(typeName: string, field: string): string
        let ti = typeIndex(typeName)
        if ti < 0 then
            return "int"
        let names = m_typeFieldNames[ti]
        let i = 0
        while i < #names do
            if names[i] == field then
                return m_typeFieldTypes[ti][i]
            i += 1
        return "int"

    // Fields of the class whose method is currently being lowered (for
    // resolving an unqualified name against `self`); empty otherwise.
    mut curClassFields(): [string]
        if m_curClass == "" then
            return []
        let ti = typeIndex(m_curClass)
        if ti < 0 then
            return []
        return m_typeFieldNames[ti]

    mut isCurField(name: string): bool
        return (name in curClassFields())

    // A function with no declared return type never yields a value
    // (`void f()`, or `mut m()` with no `: T`).
    fn isVoidFn(func: FunctionDecl): bool
        return func.isVoid or func.returnType == null

    // The `fn` / `mut` mutation contract and "returns on every path" are
    // now enforced by the semantic analyser (sema_stmt.kmm), not here.

    fn funcKind(func: FunctionDecl): string
        if func.isExtern then
            return "extern"
        if isVoidFn(func) then
            return "void"
        if func.isMut then
            return "mut"
        return "fn"

    mut fnKind(name: string): string
        let i = 0
        while i < #m_fnNames do
            if m_fnNames[i] == name then
                return m_fnKinds[i]
            i += 1
        return ""

    mut fnArity(name: string): int
        let i = 0
        while i < #m_fnNames do
            if m_fnNames[i] == name then
                return m_fnArity[i]
            i += 1
        return 0 - 1

    // ── function overloading ──────────────────────────────────────
    //
    //  A free function (no owner class, not extern / prototype) may be
    //  declared more than once under one name with different parameter
    //  types.  Each overload is emitted under a unique `overloadSym` link
    //  name; a call site picks the overload from the static argument
    //  types and, when those leave more than one candidate, emits a
    //  runtime tag / type-id check that dispatches to the right one.

    fn isFreeFn(func: FunctionDecl): bool
        return func.ownerClass == null and not func.isExtern and not func.isPrototype

    // Coarse parameter type, matched to what `exprType` / the call ABI can
    // tell apart: `int` (also bool / char / int widths / unknown),
    // `float`, `string`, `bool`, an object type name, or `any` (untyped).
    mut normParamType(t: string?): string
        let s = stripOpt(t)
        if s == null then
            return "any"
        if s == "float" or s == "string" or s == "bool" then
            return s
        if isObjType(s) then
            return s
        // an array type keeps its shape so `[int]` and `[float]` overloads
        // are distinct; the leaf is normalised the same way
        if isArrayType(s) then
            return "[" + normParamType(elemTypeOf(s)) + "]"
        return "int"

    mut paramSig(func: FunctionDecl): [string]
        let out: [string] = []
        for p in func.params do
            out += [normParamType(p.declaredType)]
        return out

    mut countSourceName(name: string): int
        let n = 0
        let i = 0
        while i < #m_fnNames do
            if m_fnNames[i] == name then
                n += 1
            i += 1
        return n

    fn overloadSym(name: string, sig: [string]): string
        let s = name + "__ov" + string(#sig)
        for p in sig do
            s = s + "_" + symSafeType(p)
        return s

    // A normalised param type made label-safe: `[int]` → `arr_int`,
    // `[[float]]` → `arr_arr_float` (drop every `]`, `[` → `arr_`).
    fn symSafeType(t: string): string
        let out = ""
        let i = 0
        while i < t.length do
            let c = t[i]
            if c == "[" then
                out = out + "arr_"
            else if c != "]" then
                out = out + c
            i += 1
        return out

    mut sigsEqual(a: [string], b: [string]): bool
        if #a != #b then
            return false
        let i = 0
        while i < #a do
            if a[i] != b[i] then
                return false
            i += 1
        return true

    // Indices of every registered overload of a free function `name` with
    // exactly `argc` parameters.
    mut arityCandidates(name: string, argc: int): [int]
        let out: [int] = []
        let i = 0
        while i < #m_fnNames do
            if m_fnNames[i] == name and m_fnArity[i] == argc then
                out += [i]
            i += 1
        return out

    // How well argument `a` fits a parameter normalized to `p`:
    //   2 = a definite static match   1 = possible (decided at runtime)
    //   0 = incompatible
    mut argFit(p: string, a: Expression?): int
        if p == "any" then
            return 1
        let at = exprType(a)
        // array parameter — match the normalised shape exactly; an empty
        // literal (`[]` ⇒ `[never]` / `[int]`) fits any array param
        if isArrayType(p) then
            if not isArrayType(at) then
                return 0
            let na = "[" + normParamType(elemTypeOf(at)) + "]"
            if na == p then
                return 2
            if elemTypeOf(at) == "never" then
                return 1
            return 0
        if p == "float" then
            if at == "float" then
                return 2
            return 0
        if p == "string" then
            if at == "string" then
                return 2
            return 0
        if p == "bool" then
            if a is BoolLiteral then
                return 2
            if at == "int" then
                return 1
            return 0
        if p == "int" then
            if a is BoolLiteral then
                return 1
            if at == "int" then
                return 2
            return 0
        // p is an object type
        if not isObjType(at) then
            return 0
        if at == p then
            return 2
        if isDescendantOf(at, p) then
            return 2
        if isDescendantOf(p, at) then
            return 1
        return 0

    // Minimum fit across all parameters (0 ⇒ the whole overload is out).
    mut sigFit(sig: [string], args: [Expression]): int
        let worst = 2
        let i = 0
        while i < #sig do
            let f = argFit(sig[i], args[i])
            if f < worst then
                worst = f
            i += 1
        return worst

    // Larger ⇒ more specific ⇒ tried first at runtime.
    mut sigSpecificity(sig: [string], args: [Expression]): int
        let total = 0
        let i = 0
        while i < #sig do
            let p = sig[i]
            if p == "any" then
                total += 0
            else if isObjType(p) then
                let at = exprType(args[i])
                if at == p then
                    total += 3
                else if isDescendantOf(at, p) then
                    total += 2
                else
                    total += 1
            else
                total += 3
            i += 1
        return total

    mut orderBySpecificity(idxs: [int], args: [Expression]): [int]
        let out: [int] = []
        for x in idxs do
            out += [x]
        let i = 1
        while i < #out do
            let cur = out[i]
            let key = sigSpecificity(m_fnSigs[cur], args)
            let j = i - 1
            while j >= 0 and sigSpecificity(m_fnSigs[out[j]], args) < key do
                out[j + 1] = out[j]
                j -= 1
            out[j + 1] = cur
            i += 1
        return out

    // Resolve an overloaded call.  Returns a registry index when it is
    // statically decided, -2 when a runtime dispatch is required (order
    // left in `m_ovOrder`), or throws on a genuine mismatch / ambiguity.
    mut selectOverload(name: string, args: [Expression]): int
        let byArity = arityCandidates(name, #args)
        if #byArity == 0 then
            throw ("no overload of '" + name + "' takes " + string(#args) + " argument(s)")
        if #byArity == 1 then
            return byArity[0]
        let exact: [int] = []
        let scored: [int] = []
        for i in byArity do
            let f = sigFit(m_fnSigs[i], args)
            if f == 2 then
                exact += [i]
            if f > 0 then
                scored += [i]
        if #exact == 1 then
            return exact[0]
        if #exact > 1 then
            throw ("ambiguous overloaded call to '" + name + "'")
        if #scored == 0 then
            throw ("no overload of '" + name + "' matches the argument types")
        if #scored == 1 then
            return scored[0]
        m_ovOrder = orderBySpecificity(scored, args)
        return 0 - 2

    // Non-throwing return-type lookup for an overloaded call (static type
    // classifier).  Falls back to int when candidates disagree.
    mut overloadRet(name: string, args: [Expression]): string
        let byArity = arityCandidates(name, #args)
        if #byArity == 0 then
            return "int"
        if #byArity == 1 then
            return m_fnRets[byArity[0]]
        let exact: [int] = []
        let scored: [int] = []
        for i in byArity do
            let f = sigFit(m_fnSigs[i], args)
            if f == 2 then
                exact += [i]
            if f > 0 then
                scored += [i]
        if #exact >= 1 then
            return m_fnRets[exact[0]]
        if #scored == 0 then
            return m_fnRets[byArity[0]]
        let r = m_fnRets[scored[0]]
        for i in scored do
            if m_fnRets[i] != r then
                return "int"
        return r

    // ── generic (implicit-type) functions ────────────────────────
    //
    //  A free function with one or more untyped parameters is a
    //  *template*: never emitted on its own.  Every call site classifies
    //  its argument types and asks for a monomorphized copy
    //  (`name__g<argc>_<t1>_<t2>…`) specialized to those types.

    fn isTemplateDecl(func: FunctionDecl): bool
        if func.ownerClass != null or func.isExtern or func.isPrototype or func.variadic then
            return false
        if func.name == "main" then
            return false
        for p in func.params do
            if p.declaredType == null then
                return true
        return false

    mut isTemplate(name: string): bool
        let i = 0
        while i < #m_tplNames do
            if m_tplNames[i] == name then
                return true
            i += 1
        return false

    mut templateDeclOf(name: string): FunctionDecl
        let i = 0
        while i < #m_tplNames do
            if m_tplNames[i] == name then
                return m_tplDecls[i]
            i += 1
        return m_tplDecls[0]

    mut genDone(sym: string): bool
        for s in m_genDone do
            if s == sym then
                return true
        return false

    // Concrete classification of each argument at a template call site.
    // Anything not pinned to float / string / bool / an object type is
    // treated as an integer (the uniform 64-bit slot).
    mut tplArgTypes(args: [Expression]): [string]
        let out: [string] = []
        for a in args do
            let t = exprType(a)
            if t != "float" and t != "string" and t != "bool" and not isObjType(t) then
                t = "int"
            out += [t]
        return out

    fn instSym(name: string, types: [string]): string
        let s = name + "__g" + string(#types)
        for t in types do
            s = s + "_" + t
        return s

    // Auxiliary name→type environment, consulted by `exprType` while a
    // template's return type is inferred (before its instance has a frame).
    mut envTypeOf(name: string): string
        let i = 0
        while i < #m_envNames do
            if m_envNames[i] == name then
                return m_envTypes[i]
            i += 1
        return ""

    mut firstReturnType(stmts: [Statement]): string
        for s in stmts do
            if s is ReturnStmt then
                if s.value == null then
                    return "void"
                return exprType(s.value)
            if s is IfStmt then
                let a = firstReturnType(s.thenBody)
                if a != "" then
                    return a
                let b = firstReturnType(s.elseBody)
                if b != "" then
                    return b
            if s is WhileStmt then
                let w = firstReturnType(s.body)
                if w != "" then
                    return w
            if s is ForStmt then
                let f = firstReturnType(s.body)
                if f != "" then
                    return f
            if s is ForInStmt then
                let g = firstReturnType(s.body)
                if g != "" then
                    return g
        return ""

    mut inferReturnType(body: [Statement], pnames: [string], ptypes: [string]): string
        let saveN = m_envNames
        let saveT = m_envTypes
        m_envNames = pnames
        m_envTypes = ptypes
        let r = firstReturnType(body)
        m_envNames = saveN
        m_envTypes = saveT
        return r

    // `""` / `"void"` ⇒ no return annotation (procedure); float / string
    // keep it; everything else (int / bool / object handle) rides an
    // integer slot, so annotate it `int`.
    fn retAnnot(rt: string): string?
        if rt == "" or rt == "void" then
            return null
        if rt == "float" or rt == "string" then
            return rt
        return "int"

    mut lookupRet(sym: string): string
        let i = 0
        while i < #m_fnNames do
            if m_fnNames[i] == sym then
                return m_fnRets[i]
            i += 1
        return "int"

    // Ensure a monomorphized instance of template `name` specialized to
    // `argTypes` is registered and queued for emission; return its symbol.
    mut ensureInstance(name: string, argTypes: [string]): string
        let sym = instSym(name, argTypes)
        if genDone(sym) then
            return sym
        m_genDone += [sym]
        let tpl = templateDeclOf(name)
        let ps: [Param] = []
        let pnames: [string] = []
        let i = 0
        while i < #tpl.params do
            let sp = tpl.params[i]
            let ty = sp.declaredType
            if ty == null then
                ty = argTypes[i]
            ps += [new Param(sp.name, ty, sp.defaultValue, sp.modifier)]
            pnames += [sp.name]
            i += 1
        let rt = inferReturnType(tpl.body, pnames, argTypes)
        let inst = new FunctionDecl(sym)
        inst.params = ps
        inst.body = tpl.body
        inst.isVoid = tpl.isVoid or rt == "" or rt == "void"
        inst.isMut = tpl.isMut
        inst.returnType = retAnnot(rt)
        inst.linkName = sym
        let rtStore = rt
        if rt == "" or rt == "void" then
            rtStore = "int"
        m_fnNames += [sym]
        m_fnRets += [rtStore]
        m_fnKinds += [funcKind(inst)]
        m_fnArity += [#ps]
        m_fnSigs += [paramSig(inst)]
        m_fnLink += [sym]
        m_backend.declareFn(sym)
        m_genQueue += [inst]
        return sym

private
    // ── the target ─────────────────────────────────────────────────
    m_backend: Backend

    // ── program-wide function table ───────────────────────────────
    m_fnNames: [string] = []
    m_fnRets: [string] = []
    m_fnKinds: [string] = []      // "fn" (pure) / "mut" / "void"
    m_fnArity: [int] = []
    // normalized parameter-type list per function (overload resolution)
    m_fnSigs: [[string]] = []
    // symbol each function is emitted / called under — differs from its
    // source name only for overloaded free functions and generic instances
    m_fnLink: [string] = []
    // scratch: candidate order for the last runtime-dispatched call
    m_ovOrder: [int] = []

    // ── generic (implicit-type) function templates ────────────────
    m_tplNames: [string] = []
    m_tplDecls: [FunctionDecl] = []
    m_genDone: [string] = []          // instance symbols already registered
    m_genQueue: [FunctionDecl] = []   // instances awaiting body emission
    // name→type env for return-type inference over a template body
    m_envNames: [string] = []
    m_envTypes: [string] = []
    // Komodo functions referenced as C callbacks — one trampoline each.
    m_trampNames: [string] = []
    // value types that have a synthesised `km_deepcopy_<T>` helper
    m_deepCopierTypes: [string] = []

    // ── conservative auto-free (per function) ─────────────────────
    // Names of `let`-bound heap locals proved never to escape, and their
    // frame offsets split by kind.  `m_escaped` is scratch for the walk.
    m_freeNames: [string] = []
    m_freeObjOffs: [int] = []
    m_freeArrOffs: [int] = []
    m_escaped: [string] = []

    // ── top-level macros (`let NAME be EXPR`) ─────────────────────
    m_macroNames: [string] = []
    m_macroExprs: [Expression?] = []

    // ── top-level variables (`let NAME [: T] = EXPR`) ────────────
    m_globalNames: [string] = []
    m_globalTypes: [string] = []
    m_globalDecls: [VarDecl] = []

    // ── enum variants → 0-based ordinal ──────────────────────────
    m_enumNames: [string] = []
    m_enumOrdinals: [int] = []

    // per-function counter handing out hidden `match#N` subject slots
    m_matchTmp: int = 0

    // ── object-type registry (structs + classes) ──────────────────
    m_typeNames: [string] = []
    m_typeIsClass: [bool] = []
    m_typeIsAbstract: [bool] = []
    // parent type name, or "" — fields below are already parent-flattened
    m_typeParent: [string] = []
    m_typeFieldNames: [[string]] = []
    m_typeFieldTypes: [[string]] = []
    // default-value expression per (flattened) field, or null
    m_typeFieldDefaults: [[Expression?]] = []
    // method names declared directly on each type (not inherited)
    m_typeOwnMethods: [[string]] = []
    // per class: method name at each vtable slot ([] = no vtable)
    m_typeSlotNames: [[string]] = []
    // class owning the method currently being lowered ("" if none)
    m_curClass: string = ""

    // ── current-function stack frame (see codegen_frame.kmm) ────────
    m_names: [string] = []
    m_offsets: [int] = []
    m_types: [string] = []
    m_immut: [bool] = []
    m_frame: int = 0
    m_curRet: string = "int"
    m_curVoid: bool = false
    m_curKind: string = "fn"
    // true while lowering a dotted library call redirected to an overload
    // wrapper — exempts it from the "pure `fn` can't call a void" rule,
    // as a linked-prototype library call always was.
    m_libCall: bool = false

    // labels for the innermost enclosing loop (break / continue targets)
    m_loopBreak: [string] = []
    m_loopCont: [string] = []

    // ── function-signature registry ────────────────────────────────

    fn retTypeOf(declared: string?): string
        let d = stripOpt(declared)
        if d == "float" then
            return "float"
        if d == "string" then
            return "string"
        return "int"

    // Return type of a call target: a function/prototype known to this
    // translation unit (by its own name or its "_"-joined dotted form),
    // else assume int / pointer.  The semantic analyser has already put
    // the real type on `resolvedType` for every call it saw; this is the
    // fallback for synthesised nodes.
    mut fnRet(name: string): string
        let i = 0
        while i < #m_fnNames do
            if m_fnNames[i] == name then
                return m_fnRets[i]
            i += 1
        let mangled = m_backend.mangle(name)
        let j = 0
        while j < #m_fnNames do
            if m_fnNames[j] == mangled then
                return m_fnRets[j]
            j += 1
        return "int"

    fn isCompareOp(op: string): bool
        return op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">=" or op == "and" or op == "or"
