module km_compiler

// ═══════════════════════════════════════════════════════════════════════
//  Codegen — function and statement lowering.  Target-independent: every
//  concrete instruction is emitted through `m_backend` (see backend.kmm).
// ═══════════════════════════════════════════════════════════════════════

void Codegen::genFunction(func: FunctionDecl)
    m_names = []
    m_offsets = []
    m_types = []
    m_immut = []
    // Offset 8 is reserved by the x86 backend for the saved rbx; locals
    // start below it.  Other backends simply ignore the gap.
    m_frame = 8
    m_matchTmp = 0
    m_curRet = retTypeOf(func.returnType)
    m_curVoid = isVoidFn(func)
    m_curKind = funcKind(func)
    m_curClass = func.ownerClass or ""
    m_curInst = instDisplay(func)

    for p in func.params do
        let pty = "int"
        let dt = typeOrInt(p.declaredType)
        if dt == "float" or dt == "string" or isObjType(dt) or isArrayType(dt) then
            pty = dt
        addLocal(p.name, pty, false)

    collectLocals(func.body)

    // Round the frame to 16 bytes so a target that keeps a hardware
    // stack stays aligned on entry to every call.
    while m_frame % 16 != 0 do
        m_frame += 8

    let paramOffsets: [int] = []
    for p in func.params do
        paramOffsets += [slotOf(p.name)]

    // Overloaded free functions and generic instances carry a distinct
    // emit symbol; everything else is emitted under its source name.
    let emitName = func.name
    if func.linkName != null then
        emitName = func.linkName
    m_backend.beginFunction(emitName, m_frame, paramOffsets, func.name == "main")

    // top-level `let` initialisers run once, at the very start of `main`
    if (func.name == "main" or (func.name == "km_lib_init" and m_exportInit != "")) and (func.ownerClass or "") == "" then
        genGlobalInits()

    let macroMark = macroScopeMark()
    for s in func.body do
        genStmt(s)
    macroScopeRestore(macroMark)
    m_backend.endFunction()

void Codegen::genStmt(s: Statement?)
    if s is VarDecl then
        if s.immutable then
            // `let x be expr` — register a macro in the current block
            // scope; no storage, no code. Uses are substituted.
            pushMacro(s.name, s.init)
        else if s.init != null then
            genExpr(s.init)
            coerceToFloat(typeOf(s.name), s.init)
            storeVar(s.name)
    else if s is AssignStmt then
        genAssign(s)
    else if s is FieldAssignStmt then
        genFieldAssign(s)
    else if s is IndexAssignStmt then
        genIndexAssign(s)
    else if s is ExprStmt then
        if s.expr != null then
            genExpr(s.expr)
    else if s is ReturnStmt then
        genReturn(s)
    else if s is IfStmt then
        genIf(s)
    else if s is WhileStmt then
        genWhile(s)
    else if s is ForStmt then
        genFor(s)
    else if s is ForInStmt then
        genForIn(s)
    else if s is BreakStmt then
        if #m_loopBreak == 0 then
            throw "break outside a loop"
        m_backend.jump(m_loopBreak[#m_loopBreak - 1])
    else if s is ContinueStmt then
        if #m_loopCont == 0 then
            throw "continue outside a loop"
        m_backend.jump(m_loopCont[#m_loopCont - 1])
    else if s is ThrowStmt then
        genThrow(s.message)
    else if s is MatchStmt then
        genMatch(s)

void Codegen::storeVar(name: string)
    m_backend.storeLocal(slotOf(name), typeOf(name))

// `match subject` — evaluate the subject once into its hidden local, then
// try each `case` in order (`==` for ints / enums, string-equality when
// the pattern is a string literal).  `else` is the default arm.
void Codegen::genMatch(s: MatchStmt)
    let subjStr = exprType(s.subject) == "string"
    let subjFloat = exprType(s.subject) == "float"
    genExpr(s.subject)
    // the hidden subject slot always holds a raw 64-bit word — float bits
    // for a float subject, reconstituted per case for the comparison.
    if subjFloat then
        m_backend.floatToBits()
    m_backend.storeLocal(slotOf(s.tmpName), "int")
    let endL = m_backend.newLabel()
    for c in s.cases do
        let macroMark = macroScopeMark()
        if c.isDefault then
            for st in c.body do
                genStmt(st)
            macroScopeRestore(macroMark)
            m_backend.jump(endL)
        else if c.pattern is StructPattern then
            let nextL = m_backend.newLabel()
            genStructPatternTest(c.pattern, s.tmpName, nextL)
            for st in c.body do
                genStmt(st)
            macroScopeRestore(macroMark)
            m_backend.jump(endL)
            m_backend.label(nextL)
        else
            let nextL = m_backend.newLabel()
            let useStr = subjStr or c.pattern is StringLiteral
            if subjFloat then
                m_backend.loadLocal(slotOf(s.tmpName), "int")
                m_backend.bitsToFloat()
                m_backend.pushAccFloat()
                genOperandAsFloat(c.pattern)
                m_backend.compareFloat("==")
                m_backend.branchIfZero(nextL)
            else
                m_backend.loadLocal(slotOf(s.tmpName), "int")
                m_backend.pushAcc()
                genExpr(c.pattern)
                if useStr then
                    m_backend.strEquals(false)
                else
                    m_backend.compareInt("==")
                m_backend.branchIfZero(nextL)
            for st in c.body do
                genStmt(st)
            macroScopeRestore(macroMark)
            m_backend.jump(endL)
            m_backend.label(nextL)
    m_backend.label(endL)

// Lower a `case Type(field: <lit>, field: bind, …)` guard: jump to
// `failL` unless the subject in local `tmp` is a `Type` (or subtype) with
// every literal field-pattern equal; then bind the requested fields.
void Codegen::genStructPatternTest(p: StructPattern, tmp: string, failL: string)
    // 1. runtime type-id guard
    m_backend.loadLocal(slotOf(tmp), "int")
    m_backend.isTypeCheck(descendantIds(p.typeName))
    m_backend.branchIfZero(failL)
    // 2. literal field comparisons
    for fp in p.fields do
        if fp.lit != null then
            let idx = fieldIndexOf(p.typeName, fp.field)
            m_backend.loadLocal(slotOf(tmp), "int")
            m_backend.loadField(idx)
            m_backend.pushAcc()
            genExpr(fp.lit)
            if fieldTypeOf(p.typeName, fp.field) == "string" or fp.lit is StringLiteral then
                m_backend.strEquals(false)
            else
                m_backend.compareInt("==")
            m_backend.branchIfZero(failL)
    // 3. bindings (only reached when the arm matches)
    for fp in p.fields do
        if fp.bind != "" then
            let bidx = fieldIndexOf(p.typeName, fp.field)
            m_backend.loadLocal(slotOf(tmp), "int")
            m_backend.loadField(bidx)
            m_backend.storeLocal(slotOf(fp.bind), structPatBindType(p.typeName, fp.field))

// `+=` `-=` `*=` `/=` `%=` — a compound assignment `lhs <op>= v` lowers
// to `lhs = lhs <op> v`.
fn Codegen::isCompoundAssign(op: string): bool
    return op == "+=" or op == "-=" or op == "*=" or op == "/=" or op == "%="

// The bare arithmetic operator of a compound assignment: `"*="` → `"*"`.
fn Codegen::compoundOp(op: string): string
    if op == "+=" then
        return "+"
    if op == "-=" then
        return "-"
    if op == "*=" then
        return "*"
    if op == "/=" then
        return "/"
    return "%"

void Codegen::genAssign(s: AssignStmt)
    // unqualified assignment to a field of the enclosing method's class
    if not hasLocal(s.name) and isCurField(s.name) then
        let idx = fieldIndexOf(m_curClass, s.name)
        if s.op == "=" then
            m_backend.loadLocal(slotOf("self"), "int")
            m_backend.pushAcc()
            genExpr(s.value)
            // a float field is stored as raw bits; widen an int RHS first
            if fieldTypeOf(m_curClass, s.name) == "float" then
                if exprType(s.value) != "float" then
                    m_backend.cvtIntToFloat()
                m_backend.floatToBits()
            m_backend.storeField(idx)
            return
        // compound `field += v` / `field -= v` against the receiver
        let fieldIsArray = isArrayType(fieldTypeOf(m_curClass, s.name))
        if s.op == "+=" and fieldIsArray then
            m_backend.loadLocal(slotOf("self"), "int")
            m_backend.pushAcc()
            let sole = soleElement(s.value)
            if sole != null and m_backend.inPlaceAppend() then
                genSoleElement(s.value, sole)
                m_backend.arrayPushToField(idx)
                return
            genExpr(s.value)
            m_backend.arrayAppendToField(idx)
            return
        // numeric `field += v` / `field -= v`:  field = field <op> v
        if fieldTypeOf(m_curClass, s.name) == "float" then
            m_backend.loadLocal(slotOf("self"), "int")
            m_backend.pushAcc()                       // receiver for storeField
            m_backend.loadLocal(slotOf("self"), "int")
            m_backend.loadField(idx)
            m_backend.bitsToFloat()
            m_backend.pushAccFloat()
            genExpr(s.value)
            if exprType(s.value) != "float" then
                m_backend.cvtIntToFloat()
            m_backend.binaryFloat(compoundOp(s.op))
            m_backend.floatToBits()
            m_backend.storeField(idx)
            return
        m_backend.loadLocal(slotOf("self"), "int")
        m_backend.pushAcc()
        m_backend.loadLocal(slotOf("self"), "int")
        m_backend.loadField(idx)
        m_backend.pushAcc()
        genExpr(s.value)
        m_backend.binaryInt(compoundOp(s.op))
        m_backend.storeField(idx)
        return
    if not hasLocal(s.name) and isGlobalVar(s.name) then
        genGlobalAssign(s)
        return

    if not hasLocal(s.name) then
        throw ("assignment to undeclared variable '" + s.name + "'")
    if immutOf(s.name) then
        throw ("cannot reassign immutable variable '" + s.name + "' (declared with `be`)")
    if s.op == "+=" and isArrayType(typeOf(s.name)) then
        // array concat / append:  dst += src  (`dst += [v]` appends v in place)
        let sole = soleElement(s.value)
        if sole != null and m_backend.inPlaceAppend() then
            genSoleElement(s.value, sole)
            m_backend.arrayPushTo(slotOf(s.name))
        else
            genExpr(s.value)
            m_backend.arrayAppendTo(slotOf(s.name))
    else if isCompoundAssign(s.op) and typeOf(s.name) == "float" then
        // float `x <op>= v`  →  x = x <op> v  in the SSE unit
        m_backend.loadLocal(slotOf(s.name), "float")
        m_backend.pushAccFloat()
        genExpr(s.value)
        if exprType(s.value) != "float" then
            m_backend.cvtIntToFloat()
        m_backend.binaryFloat(compoundOp(s.op))
        m_backend.storeLocal(slotOf(s.name), "float")
    else if s.op == "-=" then
        genExpr(s.value)
        m_backend.subFromLocal(slotOf(s.name))
    else if isCompoundAssign(s.op) then
        // numeric (or, for `+=`, string) `x <op>= v`  →  x = x <op> v
        let st = typeOf(s.name) == "string"
        m_backend.loadLocal(slotOf(s.name), typeOf(s.name))
        m_backend.pushAcc()
        genExpr(s.value)
        if st and s.op == "+=" then
            m_backend.strBinOp("km_str_concat")
        else
            m_backend.binaryInt(compoundOp(s.op))
        storeVar(s.name)
    else
        genExpr(s.value)
        coerceToFloat(typeOf(s.name), s.value)
        storeVar(s.name)

// An integer-class value headed for a `float` slot (`let x: float = 2`,
// `x = n`) is widened in the SSE unit first — otherwise its raw bits
// would be stored and read back as a denormal.
void Codegen::coerceToFloat(dstType: string, value: Expression?)
    if dstType == "float" and value != null and exprType(value) == "int" then
        m_backend.cvtIntToFloat()

// `g = v` / `g += v` / `g -= v` for a top-level variable `g`.  The
// compound forms lower to `g = g <op> v`, mirroring the local path.
void Codegen::genGlobalAssign(s: AssignStmt)
    let name = s.name
    let ty = globalTypeOf(name)
    if s.op == "=" then
        genExpr(s.value)
        coerceToFloat(ty, s.value)
        m_backend.storeGlobal(name, ty)
        return
    // `g += elem` where `g` is an array — append one element (grow),
    // mirroring the local `arr += x` lowering.
    if s.op == "+=" and isArrayType(ty) then
        genExpr(s.value)
        m_backend.pushAcc()
        m_backend.loadGlobal(name, ty)
        m_backend.arrayGrowAcc()
        m_backend.storeGlobal(name, ty)
        return
    // float compound → in the SSE unit
    if ty == "float" then
        m_backend.loadGlobal(name, "float")
        m_backend.pushAccFloat()
        genExpr(s.value)
        if exprType(s.value) != "float" then
            m_backend.cvtIntToFloat()
        m_backend.binaryFloat(compoundOp(s.op))
        m_backend.storeGlobal(name, "float")
        return
    // numeric / string compound → `g = g <op> v`
    m_backend.loadGlobal(name, ty)
    m_backend.pushAcc()
    genExpr(s.value)
    if ty == "string" and s.op == "+=" then
        m_backend.strBinOp("km_str_concat")
    else
        m_backend.binaryInt(compoundOp(s.op))
    m_backend.storeGlobal(name, ty)

// `obj.field = value`  /  `obj.field += value`  /  `obj.field -= value`
void Codegen::genFieldAssign(s: FieldAssignStmt)
    let objType = exprType(s.object)
    if not isObjType(objType) then
        throw ("field assignment on a non-object (type '" + objType + "')")
    let idx = fieldIndexOf(objType, s.field)
    let fld = fieldTypeOf(objType, s.field)

    if s.op == "=" then
        genExpr(s.object)
        m_backend.pushAcc()
        genExpr(s.value)
        // a float field is stored as raw bits; widen an int RHS first
        if fld == "float" then
            if exprType(s.value) != "float" then
                m_backend.cvtIntToFloat()
            m_backend.floatToBits()
        m_backend.storeField(idx)
        return

    if s.op == "+=" and isArrayType(fld) then
        genExpr(s.object)
        m_backend.pushAcc()
        let sole = soleElement(s.value)
        if sole != null and m_backend.inPlaceAppend() then
            genSoleElement(s.value, sole)
            m_backend.arrayPushToField(idx)
            return
        genExpr(s.value)
        m_backend.arrayAppendToField(idx)
        return

    // numeric `obj.field <op>= value`:  obj.field = obj.field <op> value
    if fld == "float" then
        genExpr(s.object)
        m_backend.pushAcc()          // receiver for the eventual storeField
        genExpr(s.object)
        m_backend.loadField(idx)
        m_backend.bitsToFloat()
        m_backend.pushAccFloat()
        genExpr(s.value)
        if exprType(s.value) != "float" then
            m_backend.cvtIntToFloat()
        m_backend.binaryFloat(compoundOp(s.op))
        m_backend.floatToBits()
        m_backend.storeField(idx)
        return

    genExpr(s.object)
    m_backend.pushAcc()          // receiver for the eventual storeField
    genExpr(s.object)
    m_backend.loadField(idx)
    m_backend.pushAcc()          // current field value
    genExpr(s.value)
    m_backend.binaryInt(compoundOp(s.op))
    m_backend.storeField(idx)

// `arr[i] = value`  /  `arr[i] += value`  /  `arr[i] -= value`
void Codegen::genIndexAssign(s: IndexAssignStmt)
    let elemF = elemTypeOf(exprType(s.object)) == "float"

    if s.op == "=" then
        genExpr(s.object)
        m_backend.pushAcc()
        genExpr(s.index)
        m_backend.pushAcc()
        genExpr(s.value)
        // a float element is stored as raw bits; widen an int RHS first
        if elemF then
            if exprType(s.value) != "float" then
                m_backend.cvtIntToFloat()
            m_backend.floatToBits()
        m_backend.indexAssign()
        return

    // compound: arr[i] = arr[i] <op> value
    let elemIsArray = isArrayType(elemTypeOf(exprType(s.object)))
    if elemF then
        genExpr(s.object)
        m_backend.pushAcc()
        genExpr(s.index)
        m_backend.pushAcc()
        genExpr(s.object)
        m_backend.pushAcc()
        genExpr(s.index)
        m_backend.indexAcc()
        m_backend.bitsToFloat()
        m_backend.pushAccFloat()
        genExpr(s.value)
        if exprType(s.value) != "float" then
            m_backend.cvtIntToFloat()
        m_backend.binaryFloat(compoundOp(s.op))
        m_backend.floatToBits()
        m_backend.indexAssign()
        return

    genExpr(s.object)
    m_backend.pushAcc()
    genExpr(s.index)
    m_backend.pushAcc()
    // recompute arr[i] for the left-hand operand
    genExpr(s.object)
    m_backend.pushAcc()
    genExpr(s.index)
    m_backend.indexAcc()
    m_backend.pushAcc()
    genExpr(s.value)
    if s.op == "+=" and elemIsArray then
        m_backend.arrayAppendAcc()
    else
        m_backend.binaryInt(compoundOp(s.op))
    m_backend.indexAssign()

void Codegen::genReturn(s: ReturnStmt)
    // void/value mismatch is caught by the semantic analyser.
    if s.value != null then
        genExpr(s.value)
        let vt = exprType(s.value)
        if m_curRet == "float" and vt == "int" then
            m_backend.cvtIntToFloat()
        else if m_curRet == "int" and vt == "float" then
            m_backend.cvtFloatToInt()
    m_backend.epilogue()

void Codegen::genIf(s: IfStmt)
    let elseL = m_backend.newLabel()
    let endL = m_backend.newLabel()
    genExpr(s.cond)
    m_backend.branchIfZero(elseL)
    let thenMark = macroScopeMark()
    for st in s.thenBody do
        genStmt(st)
    macroScopeRestore(thenMark)
    m_backend.jump(endL)
    m_backend.label(elseL)
    let elseMark = macroScopeMark()
    for st in s.elseBody do
        genStmt(st)
    macroScopeRestore(elseMark)
    m_backend.label(endL)

void Codegen::pushLoop(contL: string, breakL: string)
    m_loopCont += [contL]
    m_loopBreak += [breakL]

void Codegen::popLoop()
    m_loopCont = m_loopCont[0 to (#m_loopCont - 1)]
    m_loopBreak = m_loopBreak[0 to (#m_loopBreak - 1)]

void Codegen::genWhile(s: WhileStmt)
    let topL = m_backend.newLabel()
    let endL = m_backend.newLabel()
    pushLoop(topL, endL)
    m_backend.label(topL)
    genExpr(s.cond)
    m_backend.branchIfZero(endL)
    let macroMark = macroScopeMark()
    for st in s.body do
        genStmt(st)
    macroScopeRestore(macroMark)
    m_backend.jump(topL)
    m_backend.label(endL)
    popLoop()

// `for i = a to b`  /  `for i = a down to b`  /  `... until b`
void Codegen::genFor(s: ForStmt)
    genExpr(s.start)
    m_backend.storeLocal(slotOf(s.varName), "int")
    let topL = m_backend.newLabel()
    let contL = m_backend.newLabel()
    let endL = m_backend.newLabel()
    pushLoop(contL, endL)
    m_backend.label(topL)
    m_backend.loadLocal(slotOf(s.varName), "int")
    m_backend.pushAcc()
    genExpr(s.end)
    m_backend.forCompareExit(endL, s.descending, s.inclusive)
    let macroMark = macroScopeMark()
    for st in s.body do
        genStmt(st)
    macroScopeRestore(macroMark)
    m_backend.label(contL)
    m_backend.stepLocal(slotOf(s.varName), s.descending)
    m_backend.jump(topL)
    m_backend.label(endL)
    popLoop()

// `for x in arr` — arrays only.  #a/#i are hidden per-loop locals.
void Codegen::genForIn(s: ForInStmt)
    let vi = s.varName + "#i"
    let va = s.varName + "#a"
    genExpr(s.iterable)
    m_backend.forInInit(slotOf(vi), slotOf(va))
    let topL = m_backend.newLabel()
    let contL = m_backend.newLabel()
    let endL = m_backend.newLabel()
    pushLoop(contL, endL)
    m_backend.label(topL)
    m_backend.forInHead(slotOf(vi), slotOf(va), endL)
    m_backend.forInElem(slotOf(s.varName))
    let macroMark = macroScopeMark()
    for st in s.body do
        genStmt(st)
    macroScopeRestore(macroMark)
    m_backend.label(contL)
    m_backend.forInStep(slotOf(vi))
    m_backend.jump(topL)
    m_backend.label(endL)
    popLoop()
