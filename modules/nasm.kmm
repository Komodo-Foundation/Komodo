module km_compiler

// ═══════════════════════════════════════════════════════════════════════
//  Codegen — NASM text emitter and symbol bookkeeping.
//
//  Everything that knows about NASM's concrete syntax lives here: the
//  line buffer, instruction / label helpers, .rodata interning, the
//  aligned-call sequence, name mangling, and assembling the final file
//  (header + body + footer).
// ═══════════════════════════════════════════════════════════════════════

// ── line buffer ────────────────────────────────────────────────────

void Codegen::emit(line: string)
    m_body = m_body + line + "\n"

void Codegen::ins(text: string)
    emit("    " + text)

void Codegen::label(name: string)
    emit(name + ":")

mut Codegen::newLabel(): string
    m_labelId += 1
    return ".L" + string(m_labelId)

// Emit a `call` with the stack force-aligned to 16 bytes.  rbx holds the
// pre-call rsp (it is callee-saved, and every generated function saves
// the caller's rbx in its prologue), so temporaries left on the stack
// mid-expression can never break an inner call's alignment.
void Codegen::emitCall(sym: string)
    ins("mov rbx, rsp")
    ins("and rsp, -16")
    ins("call " + sym)
    ins("mov rsp, rbx")

// ── .rodata interning ──────────────────────────────────────────────

// Intern a double constant; returns its label.
mut Codegen::addDouble(value: string): string
    m_doubleId += 1
    let name = "LC" + string(m_doubleId)
    m_rodata = m_rodata + name + ": dq " + value + "\n"
    return name

// Intern a string literal (`lexeme` still carries its quotes).  NASM
// back-quoted strings understand the same \n \t \\ escapes as Komodo
// source, so the body passes straight through.
mut Codegen::addString(lexeme: string): string
    m_stringId += 1
    let name = "LS" + string(m_stringId)
    let body = lexeme[1 to (lexeme.length - 1)]
    m_rodata = m_rodata + name + ": db `" + body + "`, 0\n"
    return name

// ── symbols ────────────────────────────────────────────────────────

// `module.member` → `module_member`; a plain name is unchanged.
fn Codegen::mangle(name: string): string
    let out = ""
    let i = 0
    while i < name.length do
        if name[i] == "." then
            out = out + "_"
        else
            out = out + name[i]
        i += 1
    return out

mut Codegen::listHas(list: [string], item: string): bool
    let i = 0
    while i < #list do
        if list[i] == item then
            return true
        i += 1
    return false

// A call target that isn't a function defined in this program is
// resolved at link time — record it so the header can `extern` it.
void Codegen::recordExtern(sym: string)
    if listHas(m_fnNames, sym) then
        return
    if not listHas(m_externs, sym) then
        m_externs += [sym]

// ── final assembly ─────────────────────────────────────────────────

mut Codegen::header(): string
    let h = "; generated by the Komodo compiler — NASM x86-64\n"
    h = h + "default rel\n\n"
    h = h + "global main\n\n"
    if m_usesMalloc then
        h = h + "extern malloc\n"
    if m_usesAppend then
        h = h + "extern km_array_append\n"
    if m_usesStr then
        h = h + "extern km_str_concat\n"
        h = h + "extern km_str_repeat\n"
        h = h + "extern km_str_len\n"
        h = h + "extern km_str_eq\n"
    let i = 0
    while i < #m_externs do
        h = h + "extern " + m_externs[i] + "\n"
        i += 1
    h = h + "\nsection .text\n\n"
    return h

fn Codegen::footer(): string
    return "\nsection .rodata\n" + m_rodata + "\nsection .note.GNU-stack noalloc noexec nowrite progbits\n"
