module km_compiler

// ═══════════════════════════════════════════════════════════════════════
//  Codegen — the target-independent lowering pass.
//
//  It walks the AST once and drives a `Backend` (see backend.kmm); it
//  never names a machine instruction or an output syntax.  The work is
//  spread across sibling files, all `module km_compiler`:
//
//      codegen.kmm         this file — class state, the driver, and the
//                          function-signature registry
//      codegen_frame.kmm   stack-frame layout + static type inference
//      codegen_stmt.kmm    statement lowering
//      codegen_expr.kmm    expression lowering
//      backend.kmm         the Backend interface + shared bookkeeping
//      backend_x86.kmm     X86Backend     — System V AMD64 / NASM
//      backend_stackvm.kmm StackVMBackend — textual stack-VM bytecode
//
//  Every Komodo call — user function or standard-library one — is
//  lowered identically; nothing about `print`, `algorithm.sort`, … is
//  special-cased.  A dotted name `a.b` mangles to the symbol `a_b`; a
//  call target not defined in the program is left for the target's
//  linker / loader to resolve.
//
//  Result-value convention (per backend):  int / pointer / string in the
//  integer accumulator, float in the float accumulator.
// ═══════════════════════════════════════════════════════════════════════

class Codegen
public
    constructor(backend: Backend)
        m_backend = backend

    mut compileProgram(prog: Program): string
        m_backend.begin()

        // Pass -1: record top-level `let NAME be EXPR` macros in the
        // outermost macro scope. They are not lowered here — each use
        // site re-lowers the expression. Nested `be` bindings push
        // further scopes as their blocks are lowered (see genStmt).
        // The semantic analyser has already rejected duplicates.
        for mac in prog.macros do
            pushMacro(mac.name, mac.init)

        // Enum variants become plain integer constants: `Color::RED` (which
        // the parser has already reduced to the bare name `RED`) lowers to
        // its 0-based ordinal within its enum.
        for en in prog.enums do
            let ord = 0
            for v in en.variants do
                if not listHas(m_enumNames, v) then
                    m_enumNames += [v]
                    m_enumOrdinals += [ord]
                ord += 1

        // Pass 0: register every struct / class as an object type (name →
        // ordered fields) and lower each method / constructor to a free
        // function `Type.method` whose first parameter is the receiver
        // `self`.  Types are registered parent-before-child so an inheriting
        // type can prepend its parent's fields (see `registerTypeFull`).
        let ordered = orderTypesByInheritance(prog)
        for d in ordered do
            if d is StructDecl then
                registerTypeFull(d.name, false, d.isAbstract, d.parent, memberNames(d.members), memberTypes(d.members), memberDefaults(d.members))
            else if d is ClassDecl then
                registerTypeFull(d.name, true, d.isAbstract, d.parent, fieldNames(d.fields), fieldTypes(d.fields), fieldDefaults(d.fields))
                for m in d.methods do
                    let mfn = new FunctionDecl(methodSym(d.name, m))
                    let ps: [Param] = [new Param("self", d.name)]
                    for mp in m.params do
                        ps += [mp]
                    mfn.params = ps
                    mfn.body = m.body
                    mfn.isVoid = m.isVoid
                    mfn.isMut = m.isMut
                    mfn.isConstructor = m.isConstructor
                    mfn.returnType = m.returnType
                    mfn.ownerClass = d.name
                    prog.functions += [mfn]
                    registerMethod(d.name, m.name)

        // Pass 0b: assign vtable slots now that every type + its own
        // methods are registered.
        buildVtables()

        // Pass 1: collect every function's signature (forward references
        // and recursion are allowed).  Duplicates were rejected by the
        // semantic analyser.
        for func in prog.functions do
            m_fnNames += [func.name]
            m_fnRets += [retTypeOf(func.returnType)]
            m_fnKinds += [funcKind(func)]
            m_fnArity += [#func.params]
            // An `extern` (C ABI) or a body-less prototype (Komodo ABI,
            // e.g. the standard library) is resolved by the linker — do
            // not register it as a program-local symbol or emit it.
            if not func.isExtern and not func.isPrototype then
                m_backend.declareFn(func.name)

        // Pass 2: lower each body.  "Returns on every path" and the
        // `fn` / `mut` mutation contract were enforced by the semantic
        // analyser (sema*.kmm).
        for func in prog.functions do
            if func.isExtern or func.isPrototype then
                continue
            genFunction(func)

        // Emit the per-class vtables + the type-id → vtable index table.
        emitVtables()

        return m_backend.finish()

    // ── object-type registry ──────────────────────────────────────

    // `_`-joined so the symbol needs no mangling and its emitted label
    // matches the call site.
    fn methodSym(className: string, m: FunctionDecl): string
        if m.isConstructor then
            return className + "__ctor"
        return className + "__" + m.name

    fn ctorSym(className: string): string
        return className + "__ctor"

    // A class with no `constructor` of its own inherits its nearest
    // ancestor's (interpreter rule).  Falls back to `Name__ctor`.
    mut resolveCtorSym(className: string): string
        let cur = className
        let guard = 0
        while cur != "" do
            let s = cur + "__ctor"
            if hasFn(s) then
                return s
            cur = typeParentOf(cur)
            guard += 1
            if guard > 10000 then
                return className + "__ctor"
        return className + "__ctor"

    fn methodSymOf(className: string, method: string): string
        return className + "__" + method

    mut memberNames(ms: [StructMember]): [string]
        let out: [string] = []
        for m in ms do
            out += [m.name]
        return out

    mut memberTypes(ms: [StructMember]): [string]
        let out: [string] = []
        for m in ms do
            out += [typeOrInt(m.declaredType)]
        return out

    mut fieldNames(fs: [ClassField]): [string]
        let out: [string] = []
        for f in fs do
            out += [f.name]
        return out

    mut fieldTypes(fs: [ClassField]): [string]
        let out: [string] = []
        for f in fs do
            out += [typeOrInt(f.declaredType)]
        return out

    mut memberDefaults(ms: [StructMember]): [Expression?]
        let out: [Expression?] = []
        for m in ms do
            out += [m.defaultValue]
        return out

    mut fieldDefaults(fs: [ClassField]): [Expression?]
        let out: [Expression?] = []
        for f in fs do
            out += [f.defaultValue]
        return out

    // A declared-type string reduced to codegen's coarse form: `?` (which
    // codegen never depended on) dropped, `null` → "int".
    mut typeOrInt(t: string?): string
        let s = stripOpt(t)
        if s == null then
            return "int"
        return s

    fn parentOrEmpty(p: string?): string
        if p == null then
            return ""
        return p

    // Order structs+classes so every type comes after its parent — an
    // inheriting type prepends its (already-registered) parent's fields.
    mut orderTypesByInheritance(prog: Program): [Declaration]
        let work: [Declaration] = []
        for st in prog.structs do
            work += [st]
        for cl in prog.classes do
            work += [cl]
        let ordered: [Declaration] = []
        let done: [string] = []
        let guard = 0
        while #work > 0 do
            let remaining: [Declaration] = []
            let progressed = false
            for d in work do
                let par = declParent(d)
                if par == "" or listHas(done, par) then
                    ordered += [d]
                    done += [declName(d)]
                    progressed = true
                else
                    remaining += [d]
            work = remaining
            if not progressed then
                throw ("cyclic or unresolved type inheritance near '" + declName(work[0]) + "'")
            guard += 1
            if guard > 10000 then
                throw "type inheritance ordering did not converge"
        return ordered

    // `parent` / `name` are on `StructDecl` / `ClassDecl`, not `Declaration`.
    mut declParent(d: Declaration): string
        if d is StructDecl then
            return parentOrEmpty(d.parent)
        if d is ClassDecl then
            return parentOrEmpty(d.parent)
        return ""

    mut declName(d: Declaration): string
        if d is StructDecl then
            return d.name
        if d is ClassDecl then
            return d.name
        return ""

    // Register a type, prepending its parent's flattened fields (names,
    // types and default-value expressions) ahead of its own.
    mut registerTypeFull(name: string, isClass: bool, isAbs: bool, parent: string?, fnames: [string], ftypes: [string], fdefs: [Expression?])
        if listHas(m_typeNames, name) then
            throw ("duplicate type '" + name + "'")
        let par = parentOrEmpty(parent)
        let allNames: [string] = []
        let allTypes: [string] = []
        let allDefs: [Expression?] = []
        if par != "" then
            let pi = typeIndex(par)
            if pi < 0 then
                throw ("type '" + name + "' inherits unknown type '" + par + "'")
            for x in m_typeFieldNames[pi] do
                allNames += [x]
            for x in m_typeFieldTypes[pi] do
                allTypes += [x]
            for x in m_typeFieldDefaults[pi] do
                allDefs += [x]
        let k = 0
        while k < #fnames do
            allNames += [fnames[k]]
            allTypes += [ftypes[k]]
            allDefs += [fdefs[k]]
            k += 1
        m_typeNames += [name]
        m_typeIsClass += [isClass]
        m_typeIsAbstract += [isAbs]
        m_typeParent += [par]
        m_typeFieldNames += [allNames]
        m_typeFieldTypes += [allTypes]
        m_typeFieldDefaults += [allDefs]
        m_typeOwnMethods += [[]]

    // Record a method name declared directly on `className` (used to
    // resolve inherited method calls to the class that defines them).
    mut registerMethod(className: string, methodName: string)
        let ti = typeIndex(className)
        if ti < 0 then
            return
        m_typeOwnMethods[ti] += [methodName]

    // The default-value expression for field `i` of `typeName`, or null.
    mut fieldDefaultAt(typeName: string, i: int): Expression?
        let ti = typeIndex(typeName)
        if ti < 0 then
            return null
        let defs = m_typeFieldDefaults[ti]
        if i < 0 or i >= #defs then
            return null
        return defs[i]

    mut isAbstractType(name: string): bool
        let ti = typeIndex(name)
        if ti < 0 then
            return false
        return m_typeIsAbstract[ti]

    mut typeParentOf(name: string): string
        let ti = typeIndex(name)
        if ti < 0 then
            return ""
        return m_typeParent[ti]

    // True if `t` descends from `ancestor` (strictly — not the same type).
    mut isDescendantOf(t: string, ancestor: string): bool
        let cur = typeParentOf(t)
        let guard = 0
        while cur != "" do
            if cur == ancestor then
                return true
            cur = typeParentOf(cur)
            guard += 1
            if guard > 10000 then
                return false
        return false

    // The type ids matched by `x is Name` — `Name` itself plus every type
    // that descends from it (all known at compile time).
    mut descendantIds(name: string): [int]
        let out: [int] = [typeIndex(name)]
        let i = 0
        while i < #m_typeNames do
            if isDescendantOf(m_typeNames[i], name) then
                out += [i]
            i += 1
        return out

    // A class needs a vtable when it takes part in inheritance — it has a
    // parent, or some other class names it as parent.
    mut needsVtable(name: string): bool
        if not typeIsClass(name) then
            return false
        if typeParentOf(name) != "" then
            return true
        let i = 0
        while i < #m_typeNames do
            if m_typeParent[i] == name then
                return true
            i += 1
        return false

    // Assign vtable slots.  Registry order is parent-before-child, so a
    // child inherits its parent's slot list (overrides reuse the slot)
    // and appends its own new methods.
    mut buildVtables()
        let i = 0
        while i < #m_typeNames do
            m_typeSlotNames += [[]]
            i += 1
        i = 0
        while i < #m_typeNames do
            if m_typeIsClass[i] and needsVtable(m_typeNames[i]) then
                let slots: [string] = []
                let par = m_typeParent[i]
                if par != "" then
                    let pi = typeIndex(par)
                    if pi >= 0 then
                        for s in m_typeSlotNames[pi] do
                            slots += [s]
                for mn in m_typeOwnMethods[i] do
                    if mn != "constructor" and not listHas(slots, mn) then
                        slots += [mn]
                // An abstract base that never declares an interface method
                // itself still needs a slot for it, so a `base.method()`
                // call through a subclass instance dispatches virtually.
                // Only methods every concrete subclass supplies count as
                // the interface (a helper unique to one backend does not).
                if m_typeIsAbstract[i] then
                    let d = 0
                    while d < #m_typeNames do
                        if isDescendantOf(m_typeNames[d], m_typeNames[i]) and not m_typeIsAbstract[d] then
                            for mn in m_typeOwnMethods[d] do
                                if mn != "constructor" and not listHas(slots, mn) and allConcreteHave(m_typeNames[i], mn) then
                                    slots += [mn]
                        d += 1
                m_typeSlotNames[i] = slots
            i += 1

    // Does every concrete (non-abstract) descendant of `base` define `mn`?
    mut allConcreteHave(base: string, mn: string): bool
        let d = 0
        while d < #m_typeNames do
            if isDescendantOf(m_typeNames[d], base) and not m_typeIsAbstract[d] then
                if not listHas(m_typeOwnMethods[d], mn) and resolveMethodOwner(m_typeNames[d], mn) == "" then
                    return false
            d += 1
        return true

    // Vtable slot of `method` for a receiver statically typed `className`,
    // or -1 when the call can be a direct (non-virtual) one.
    mut methodSlotOf(className: string, method: string): int
        let ti = typeIndex(className)
        if ti < 0 then
            return 0 - 1
        let slots = m_typeSlotNames[ti]
        let i = 0
        while i < #slots do
            if slots[i] == method then
                return i
            i += 1
        return 0 - 1

    // Drive the backend's vtable emission: one `__vt_<id>` per class with
    // slots, resolving each slot to the nearest declaring class's symbol.
    mut emitVtables()
        m_backend.beginVtables(#m_typeNames)
        let i = 0
        while i < #m_typeNames do
            // An abstract class is never instantiated, so its own vtable
            // is dead — and some slots may have no concrete owner yet.
            if #m_typeSlotNames[i] > 0 and not m_typeIsAbstract[i] then
                let labels: [string] = []
                for slotName in m_typeSlotNames[i] do
                    let owner = resolveMethodOwner(m_typeNames[i], slotName)
                    labels += [owner + "__" + slotName]
                m_backend.setVtable(i, labels)
            i += 1

    // The class that actually declares `method` for a receiver statically
    // typed `className` — walk up the parent chain, then (for an abstract
    // base that leaves an interface method to its subclasses) the first
    // descendant that supplies it.  "" if none.
    mut resolveMethodOwner(className: string, method: string): string
        let cur = className
        let guard = 0
        while cur != "" do
            let ti = typeIndex(cur)
            if ti >= 0 and listHas(m_typeOwnMethods[ti], method) then
                return cur
            cur = typeParentOf(cur)
            guard += 1
            if guard > 10000 then
                return ""
        let ci = typeIndex(className)
        if ci >= 0 and m_typeIsAbstract[ci] then
            let d = 0
            while d < #m_typeNames do
                if isDescendantOf(m_typeNames[d], className) and listHas(m_typeOwnMethods[d], method) then
                    return m_typeNames[d]
                d += 1
        return ""

    mut isObjType(name: string): bool
        return listHas(m_typeNames, name)

    // ── enum variants (name → ordinal) ────────────────────────────

    mut isEnumVariant(name: string): bool
        return listHas(m_enumNames, name)

    fn isArrayType(t: string): bool
        return #t > 0 and t[0] == "["

    // `"[[string]]"` → `"[string]"`, `"[int]"` → `"int"`, else unchanged.
    fn elemTypeOf(t: string): string
        if #t >= 2 and t[0] == "[" and t[#t - 1] == "]" then
            return t[1 to (#t - 1)]
        return t

    // Field-slot indices in positional-constructor order, matching the
    // interpreter's `reorder_constructible_fields`: required fields first
    // (declaration order), then this type's own defaulted fields, then
    // inherited defaulted ones.
    mut ctorFieldOrder(typeName: string): [int]
        let ti = typeIndex(typeName)
        if ti < 0 then
            return []
        let defs = m_typeFieldDefaults[ti]
        let par = typeParentOf(typeName)
        let pc = 0
        if par != "" then
            let pi = typeIndex(par)
            if pi >= 0 then
                pc = #m_typeFieldNames[pi]
        let req: [int] = []
        let ownOpt: [int] = []
        let inhOpt: [int] = []
        let i = 0
        while i < #defs do
            if defs[i] == null then
                req += [i]
            else if i >= pc then
                ownOpt += [i]
            else
                inhOpt += [i]
            i += 1
        let out: [int] = []
        for x in req do
            out += [x]
        for x in ownOpt do
            out += [x]
        for x in inhOpt do
            out += [x]
        return out

    mut enumOrdinal(name: string): int
        let i = 0
        while i < #m_enumNames do
            if m_enumNames[i] == name then
                return m_enumOrdinals[i]
            i += 1
        return 0

    mut hasFn(name: string): bool
        return listHas(m_fnNames, name)

    // ── macro registry ────────────────────────────────────────────
    //
    // `m_macroNames` / `m_macroExprs` are a stack. Entering a block
    // records its length (`macroScopeMark`); leaving the block truncates
    // back to that mark (`macroScopeRestore`), so a `be` binding is
    // visible only within its enclosing block. Lookup scans from the top
    // of the stack, so an inner binding shadows an outer one.

    mut isMacro(name: string): bool
        return listHas(m_macroNames, name)

    mut macroExprOf(name: string): Expression?
        let i = #m_macroNames - 1
        while i >= 0 do
            if m_macroNames[i] == name then
                return m_macroExprs[i]
            i -= 1
        return null

    mut macroScopeMark(): int
        return #m_macroNames

    void macroScopeRestore(mark: int)
        while #m_macroNames > mark do
            m_macroNames = m_macroNames[0 to (#m_macroNames - 1)]
            m_macroExprs = m_macroExprs[0 to (#m_macroExprs - 1)]

    void pushMacro(name: string, e: Expression?)
        if e == null then
            throw ("macro '" + name + "' has no value")
        m_macroNames += [name]
        m_macroExprs += [e]

    mut typeIsClass(name: string): bool
        let ti = typeIndex(name)
        if ti < 0 then
            return false
        return m_typeIsClass[ti]

    mut typeIndex(name: string): int
        let i = 0
        while i < #m_typeNames do
            if m_typeNames[i] == name then
                return i
            i += 1
        return 0 - 1

    // The runtime type id stored in an object's header word — its index
    // in the registry (structs and classes share one id space).
    mut typeIdOf(name: string): int
        return typeIndex(name)

    mut objFieldCount(typeName: string): int
        let ti = typeIndex(typeName)
        if ti < 0 then
            return 0
        return #m_typeFieldNames[ti]

    mut fieldIndexOf(typeName: string, field: string): int
        let ti = typeIndex(typeName)
        if ti < 0 then
            throw ("unknown type '" + typeName + "'")
        let names = m_typeFieldNames[ti]
        let i = 0
        while i < #names do
            if names[i] == field then
                return i
            i += 1
        throw ("type '" + typeName + "' has no field '" + field + "'")

    mut fieldTypeOf(typeName: string, field: string): string
        let ti = typeIndex(typeName)
        if ti < 0 then
            return "int"
        let names = m_typeFieldNames[ti]
        let i = 0
        while i < #names do
            if names[i] == field then
                return m_typeFieldTypes[ti][i]
            i += 1
        return "int"

    // Fields of the class whose method is currently being lowered (for
    // resolving an unqualified name against `self`); empty otherwise.
    mut curClassFields(): [string]
        if m_curClass == "" then
            return []
        let ti = typeIndex(m_curClass)
        if ti < 0 then
            return []
        return m_typeFieldNames[ti]

    mut isCurField(name: string): bool
        return listHas(curClassFields(), name)

    // A function with no declared return type never yields a value
    // (`void f()`, or `mut m()` with no `: T`).
    fn isVoidFn(func: FunctionDecl): bool
        return func.isVoid or func.returnType == null

    // The `fn` / `mut` mutation contract and "returns on every path" are
    // now enforced by the semantic analyser (sema_stmt.kmm), not here.

    fn funcKind(func: FunctionDecl): string
        if func.isExtern then
            return "extern"
        if isVoidFn(func) then
            return "void"
        if func.isMut then
            return "mut"
        return "fn"

    mut fnKind(name: string): string
        let i = 0
        while i < #m_fnNames do
            if m_fnNames[i] == name then
                return m_fnKinds[i]
            i += 1
        return ""

    mut fnArity(name: string): int
        let i = 0
        while i < #m_fnNames do
            if m_fnNames[i] == name then
                return m_fnArity[i]
            i += 1
        return 0 - 1

    mut listHas(list: [string], item: string): bool
        let i = 0
        while i < #list do
            if list[i] == item then
                return true
            i += 1
        return false

private
    // ── the target ─────────────────────────────────────────────────
    m_backend: Backend

    // ── program-wide function table ───────────────────────────────
    m_fnNames: [string] = []
    m_fnRets: [string] = []
    m_fnKinds: [string] = []      // "fn" (pure) / "mut" / "void"
    m_fnArity: [int] = []

    // ── top-level macros (`let NAME be EXPR`) ─────────────────────
    m_macroNames: [string] = []
    m_macroExprs: [Expression?] = []

    // ── enum variants → 0-based ordinal ──────────────────────────
    m_enumNames: [string] = []
    m_enumOrdinals: [int] = []

    // per-function counter handing out hidden `match#N` subject slots
    m_matchTmp: int = 0

    // ── object-type registry (structs + classes) ──────────────────
    m_typeNames: [string] = []
    m_typeIsClass: [bool] = []
    m_typeIsAbstract: [bool] = []
    // parent type name, or "" — fields below are already parent-flattened
    m_typeParent: [string] = []
    m_typeFieldNames: [[string]] = []
    m_typeFieldTypes: [[string]] = []
    // default-value expression per (flattened) field, or null
    m_typeFieldDefaults: [[Expression?]] = []
    // method names declared directly on each type (not inherited)
    m_typeOwnMethods: [[string]] = []
    // per class: method name at each vtable slot ([] = no vtable)
    m_typeSlotNames: [[string]] = []
    // class owning the method currently being lowered ("" if none)
    m_curClass: string = ""

    // ── current-function stack frame (see codegen_frame.kmm) ────────
    m_names: [string] = []
    m_offsets: [int] = []
    m_types: [string] = []
    m_immut: [bool] = []
    m_frame: int = 0
    m_curRet: string = "int"
    m_curVoid: bool = false
    m_curKind: string = "fn"

    // labels for the innermost enclosing loop (break / continue targets)
    m_loopBreak: [string] = []
    m_loopCont: [string] = []

    // ── function-signature registry ────────────────────────────────

    fn retTypeOf(declared: string?): string
        let d = stripOpt(declared)
        if d == "float" then
            return "float"
        if d == "string" then
            return "string"
        return "int"

    // Return type of a call target: a function/prototype known to this
    // translation unit (by its own name or its "_"-joined dotted form),
    // else assume int / pointer.  The semantic analyser has already put
    // the real type on `resolvedType` for every call it saw; this is the
    // fallback for synthesised nodes.
    mut fnRet(name: string): string
        let i = 0
        while i < #m_fnNames do
            if m_fnNames[i] == name then
                return m_fnRets[i]
            i += 1
        let mangled = m_backend.mangle(name)
        let j = 0
        while j < #m_fnNames do
            if m_fnNames[j] == mangled then
                return m_fnRets[j]
            j += 1
        return "int"

    fn isCompareOp(op: string): bool
        return op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">=" or op == "and" or op == "or"
