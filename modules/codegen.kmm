module km_compiler

// ═══════════════════════════════════════════════════════════════════════
//  Codegen — the target-independent lowering pass.
//
//  It walks the AST once and drives a `Backend` (see backend.kmm); it
//  never names a machine instruction or an output syntax.  The work is
//  spread across sibling files, all `module km_compiler`:
//
//      codegen.kmm         this file — class state, the driver, and the
//                          function-signature registry
//      codegen_frame.kmm   stack-frame layout + static type inference
//      codegen_stmt.kmm    statement lowering
//      codegen_expr.kmm    expression lowering
//      backend.kmm         the Backend interface + shared bookkeeping
//      backend_x86.kmm     X86Backend     — System V AMD64 / NASM
//      backend_stackvm.kmm StackVMBackend — textual stack-VM bytecode
//
//  Every Komodo call — user function or standard-library one — is
//  lowered identically; nothing about `print`, `algorithm.sort`, … is
//  special-cased.  A dotted name `a.b` mangles to the symbol `a_b`; a
//  call target not defined in the program is left for the target's
//  linker / loader to resolve.
//
//  Result-value convention (per backend):  int / pointer / string in the
//  integer accumulator, float in the float accumulator.
// ═══════════════════════════════════════════════════════════════════════

class Codegen
public
    constructor(backend: Backend)
        m_backend = backend

    mut compileProgram(prog: Program): string
        m_backend.begin()

        // Pass 1: collect every function's signature (forward references
        // and recursion are allowed) and reject duplicates.
        for func in prog.functions do
            if listHas(m_fnNames, func.name) then
                throw ("duplicate function '" + func.name + "'")
            m_fnNames += [func.name]
            m_fnRets += [retTypeOf(func.returnType)]
            m_fnKinds += [funcKind(func)]
            m_fnArity += [#func.params]
            m_backend.declareFn(func.name)

        // Pass 2: enforce "returns on every path" for value functions,
        // then lower each body.
        for func in prog.functions do
            if not func.isVoid and not returnsOnAllPaths(func.body) then
                throw ("function '" + func.name + "' must return a value on every path")
            genFunction(func)

        return m_backend.finish()

    fn funcKind(func: FunctionDecl): string
        if func.isVoid then
            return "void"
        if func.isMut then
            return "mut"
        return "fn"

    mut fnKind(name: string): string
        let i = 0
        while i < #m_fnNames do
            if m_fnNames[i] == name then
                return m_fnKinds[i]
            i += 1
        return ""

    mut fnArity(name: string): int
        let i = 0
        while i < #m_fnNames do
            if m_fnNames[i] == name then
                return m_fnArity[i]
            i += 1
        return 0 - 1

    mut listHas(list: [string], item: string): bool
        let i = 0
        while i < #list do
            if list[i] == item then
                return true
            i += 1
        return false

private
    // ── the target ─────────────────────────────────────────────────
    m_backend: Backend

    // ── program-wide function table ───────────────────────────────
    m_fnNames: [string] = []
    m_fnRets: [string] = []
    m_fnKinds: [string] = []      // "fn" (pure) / "mut" / "void"
    m_fnArity: [int] = []

    // ── current-function stack frame (see codegen_frame.kmm) ────────
    m_names: [string] = []
    m_offsets: [int] = []
    m_types: [string] = []
    m_immut: [bool] = []
    m_frame: int = 0
    m_curRet: string = "int"
    m_curVoid: bool = false
    m_curKind: string = "fn"

    // labels for the innermost enclosing loop (break / continue targets)
    m_loopBreak: [string] = []
    m_loopCont: [string] = []

    // ── function-signature registry ────────────────────────────────

    fn retTypeOf(declared: string?): string
        if declared == "float" then
            return "float"
        if declared == "string" then
            return "string"
        return "int"

    // Return type of a call target: a function defined in this program,
    // else a known standard-library symbol, else assume "int".
    mut fnRet(name: string): string
        let i = 0
        while i < #m_fnNames do
            if m_fnNames[i] == name then
                return m_fnRets[i]
            i += 1
        return stdlibRet(m_backend.mangle(name))

    // The handful of standard-library symbols whose result is not a
    // plain integer.  Everything else (and every unknown symbol) is
    // treated as returning an int / pointer.
    fn stdlibRet(sym: string): string
        if sym == "math_sqrt" then
            return "float"
        return "int"

    fn isCompareOp(op: string): bool
        return op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">=" or op == "and" or op == "or"
