module km_compiler

// ═══════════════════════════════════════════════════════════════════════
//  Komodo static type system — the internal representation the semantic
//  analyser (sema*.kmm) reasons about.
//
//  This is *not* surface syntax: the parser still records a declared type
//  as a plain string ("int", "string?", "[Token]", …).  `parseTypeStr`
//  turns such a string into a structured `Type`; `typeToLegacy` collapses
//  a `Type` back to the coarse string the code generator consumes
//  ("int" / "float" / "string" / "[T]" / an object-type name), so codegen
//  never has to learn the richer lattice.
//
//  Kinds:
//     int uint float bool string char void        — primitives
//     u8 u16 u32 u64 i8 i16 i32 i64                — fixed-width integers
//     null      — the type of the `null` literal
//     never     — no value (a `throw`, an exhausted branch)
//     array     — `elem` is the element type
//     nullable  — `elem` is the non-null inner type (`T?` = `T | null`)
//     object    — `name` is a struct / class / enum name
//     union     — `members` are the alternatives (analyser-internal only)
//     fn        — `members` are the parameter types, `ret` the result
// ═══════════════════════════════════════════════════════════════════════

struct Type
    kind: string
    elem: Type? = null
    name: string = ""
    members: [Type] = []
    ret: Type? = null

// ── constructors ─────────────────────────────────────────────────────

fn tPrim(k: string): Type
    return new Type(k)

fn tArray(e: Type): Type
    return new Type("array", e)

fn tObject(n: string): Type
    return new Type("object", null, n)

let tNever be new Type("never")

// The gradual escape hatch: an un-annotated parameter's type.  `any` is
// assignable to and from everything, and reading a member / indexing /
// calling on it yields `any` again.  `strict` mode reports the binding.
let tAny be new Type("any")

let tNull be new Type("null")

let tVoid be new Type("void")

// `T?` — idempotent, and `null` / `never` are left unchanged.
fn tNullable(inner: Type): Type
    if inner.kind == "nullable" or inner.kind == "null" or inner.kind == "never" then
        return inner
    return new Type("nullable", inner)

// ── predicates ───────────────────────────────────────────────────────

fn isNullable(t: Type): bool
    return t.kind == "nullable" or t.kind == "null"

// The non-null core of a type (`T?` → `T`, everything else unchanged).
fn stripNull(t: Type): Type
    if t.kind == "nullable" then
        return t.elem or tPrim("never")
    return t

fn isIntKind(k: string): bool
    if k == "int" or k == "uint" then
        return true
    if k == "u8" or k == "u16" or k == "u32" or k == "u64" then
        return true
    if k == "i8" or k == "i16" or k == "i32" or k == "i64" then
        return true
    return false

// A floating-point kind.  `f64` is a spelling of `float` and is folded
// away in `parseTypeBody`; `f32` stays a distinct kind so struct layout
// and the C FFI can narrow it to a 32-bit float at the boundary, but it
// is arithmetically identical to `float` (a 64-bit double) everywhere
// inside Komodo — `typeToLegacy` collapses it to "float".
fn isFloatKind(k: string): bool
    return k == "float" or k == "f32"

// ── fixed-width integer facts ───────────────────────────────────────
// `uint` is an unsigned 64-bit; `int` / `i64` are signed 64-bit.
fn intBits(k: string): int
    if k == "u8" or k == "i8" then
        return 8
    if k == "u16" or k == "i16" then
        return 16
    if k == "u32" or k == "i32" then
        return 32
    return 64

fn intSigned(k: string): bool
    return not (k == "u8" or k == "u16" or k == "u32" or k == "u64" or k == "uint")

// Kinds whose values need width / unsigned handling in codegen ("" for
// int / i64 and everything else).  `f32` rounds to single precision.
fn narrowKind(k: string): string
    if k == "u8" or k == "u16" or k == "u32" or k == "u64" or k == "uint" then
        return k
    if k == "i8" or k == "i16" or k == "i32" or k == "f32" then
        return k
    return ""

// every value of `s` fits `d` (implicit widening)
fn intWidens(s: string, d: string): bool
    if intSigned(s) == intSigned(d) then
        return intBits(s) <= intBits(d)
    if not intSigned(s) then
        return intBits(s) < intBits(d)
    return false

// decimal / 0x literal text `v` (optionally "-"-prefixed) fits kind `k`
fn litFits(v: string, k: string): bool
    let neg = #v > 0 and v[0] == "-"
    let m = v
    if neg then
        m = v[1 to #v]
    let hex = #m > 2 and m[0] == "0" and (m[1] == "x" or m[1] == "X")
    let lim = ""
    let bits = intBits(k)
    let sg = intSigned(k)
    if neg and not sg then
        return false
    // limit magnitude as decimal text
    if bits == 8 then
        lim = "255"
        if sg and neg then
            lim = "128"
        else if sg then
            lim = "127"
    else if bits == 16 then
        lim = "65535"
        if sg and neg then
            lim = "32768"
        else if sg then
            lim = "32767"
    else if bits == 32 then
        lim = "4294967295"
        if sg and neg then
            lim = "2147483648"
        else if sg then
            lim = "2147483647"
    else
        lim = "18446744073709551615"
        if sg and neg then
            lim = "9223372036854775808"
        else if sg then
            lim = "9223372036854775807"
    if hex then
        // compare hex digit count against the limit's: nibbles = bits / 4
        let d = m[2 to #m]
        while #d > 1 and d[0] == "0" do
            d = d[1 to #d]
        let nib = bits / 4
        if #d < nib then
            return true
        if #d > nib then
            return false
        return not sg or d[0] <= "7"
    while #m > 1 and m[0] == "0" do
        m = m[1 to #m]
    if #m != #lim then
        return #m < #lim
    return m <= lim

// a literal's Type carries its text in `name` ("lit:300" / "lit"), so
// assignment can range-check it; `delit` forgets that.
fn isLit(t: Type): bool
    return (t.kind == "int" or t.kind == "float") and #t.name >= 3 and t.name[0 to 3] == "lit"

fn delit(t: Type): Type
    if isLit(t) then
        return tPrim(t.kind)
    return t

fn litText(t: Type): string
    return t.name[4 to #t.name]

fn canonInt(k: string): string
    if k == "uint" then
        return "u64"
    if k == "i64" then
        return "int"
    return k

// `u8(x)` … `i64(x)` / `f32(x)` conversion spellings (`int` and `float`
// have their own handling)
fn isConvName(n: string): bool
    return n == "f32" or (isIntKind(n) and n != "int")

fn isNumeric(t: Type): bool
    if isFloatKind(t.kind) then
        return true
    return isIntKind(t.kind)

// ── stringification ──────────────────────────────────────────────────

fn typeToString(t: Type): string
    if t.kind == "array" then
        return "[" + typeToString(t.elem or tPrim("int")) + "]"
    if t.kind == "nullable" then
        return typeToString(t.elem or tPrim("int")) + "?"
    if t.kind == "object" then
        return t.name
    if t.kind == "union" then
        let s = ""
        let i = 0
        while i < #t.members do
            if i > 0 then
                s = s + " | "
            s = s + typeToString(t.members[i])
            i += 1
        return s
    if t.kind == "fn" then
        let s = "("
        let i = 0
        while i < #t.members do
            if i > 0 then
                s = s + ", "
            s = s + typeToString(t.members[i])
            i += 1
        return s + "): " + typeToString(t.ret or tVoid)
    return t.kind

// The coarse tag the code generator keys off: one of "int", "float",
// "string", "[T]", or an object-type name.  Nullability, fixed-width
// integer sizes and unions all wash out here — codegen never needed them.
fn typeToLegacy(t: Type): string
    if t.kind == "nullable" then
        return typeToLegacy(t.elem or tPrim("int"))
    if t.kind == "array" then
        return "[" + typeToLegacy(t.elem or tPrim("int")) + "]"
    if t.kind == "object" then
        return t.name
    if isFloatKind(t.kind) then
        return "float"
    if t.kind == "string" then
        return "string"
    // a `char` is a one-character string at run time (it compares and
    // concatenates like one), so codegen treats it as a string.
    if t.kind == "char" then
        return "string"
    if t.kind == "bool" then
        return "int"
    if t.kind == "union" then
        // codegen wants one tag; "string"/"float" only if every arm agrees
        let acc = ""
        let i = 0
        while i < #t.members do
            let l = typeToLegacy(t.members[i])
            if i == 0 then
                acc = l
            else if l != acc then
                acc = "int"
            i += 1
        return acc
    if isIntKind(t.kind) then
        return "int"
    // void / null / never / fn — nothing meaningful for codegen
    return "int"

// ── parsing a declared-type string into a `Type` ─────────────────────
//
//  Declared types are recorded by the parser as strings.  Grammar here:
//  an optional trailing "?" makes it nullable; "[...]" is an array whose
//  body is itself a declared-type string; a bare word is a primitive
//  (known kind) or an object-type name.

fn stripOpt(t: string?): string?
    if t == null then
        return null
    if #t > 0 and t[#t - 1] == "?" then
        return t[0 to (#t - 1)]
    return t

fn isPrimName(w: string): bool
    if w == "int" or w == "uint" or w == "float" or w == "bool" then
        return true
    if w == "f32" or w == "f64" then
        return true
    if w == "string" or w == "char" or w == "void" then
        return true
    return isIntKind(w)

fn parseTypeStr(s: string?): Type
    if s == null then
        return tPrim("int")
    let body = s
    let nullable = false
    if #body > 0 and body[#body - 1] == "?" then
        nullable = true
        body = body[0 to (#body - 1)]
    let inner = parseTypeBody(body)
    if nullable then
        return tNullable(inner)
    return inner

fn parseTypeBody(body: string): Type
    if #body >= 2 and body[0] == "[" and body[#body - 1] == "]" then
        return tArray(parseTypeStr(body[1 to (#body - 1)]))
    if body == "any" then
        return tAny
    // `f64` is just `float`; `f32` keeps its own kind (see isFloatKind).
    if body == "f64" then
        return tPrim("float")
    if isPrimName(body) then
        return tPrim(body)
    return tObject(body)
