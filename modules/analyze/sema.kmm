module km_compiler

// ═══════════════════════════════════════════════════════════════════════
//  Analyzer — Komodo's static semantic-analysis / type-checking pass.
//
//  Runs between the parser and the code generator:
//
//      tokens ──Parser──▶ AST ──Analyzer──▶ (checked, type-annotated AST) ──Codegen──▶ text
//
//  Responsibilities, all of which used to be tangled into `Codegen`:
//
//    • build the type registry (structs / classes / enums, parent-
//      flattened fields) and the function-signature registry
//    • resolve every identifier to a declaration and every call to a
//      target; reject the unresolved ones
//    • infer a single static `Type` for every expression, with
//      flow-sensitive narrowing (`== null`, `is T`, diverging branches)
//    • enforce the language rules: arity, assignability, null-safety,
//      "returns on every path", the `fn` / `mut` mutation contract,
//      abstract instantiation, loop-only `break` / `continue`, …
//    • stamp `Expression.resolvedType` (and `CallExpr.resolvedSym`) so
//      the code generator only reads results
//
//  Work is spread across sibling files, all `module km_compiler`:
//
//      types.kmm       the `Type` lattice + declared-string parsing
//      sema.kmm        this file — class state, driver, registries
//      sema_expr.kmm   `inferExpr` — the inference engine
//      sema_stmt.kmm   `checkStmt` + flow narrowing + body-level checks
//
//  `analyze` throws a "<line>:<col>: <message>" string on the first
//  semantic error, matching the rest of the compiler's error style.
// ═══════════════════════════════════════════════════════════════════════

class Analyzer
public
    constructor(strict: bool)
        m_strict = strict
        m_typeIdx = new StrIndex()
        m_fnIdx = new StrIndex()
        m_ownIdx = new StrIndex()

    mut setSourceMap(files: [string], starts: [int])
        m_srcFiles = files
        m_srcStarts = starts

    mut analyze(prog: Program)
        // ── Pass 0: register enums, then types parent-before-child ──
        for en in prog.enums do
            registerEnum(en)
        for d in orderTypes(prog) do
            if d is StructDecl then
                registerStruct(d)
            else if d is ClassDecl then
                registerClass(d)

        // `void main(args)`: the untyped parameter is the command line,
        // always a [string] (args[0] the program path, args[1..] the user's).
        for fd in prog.functions do
            if fd.name == "main" and #fd.params == 1 and fd.params[0].declaredType == null then
                fd.params[0].declaredType = "[string]"

        // ── Pass 1: free-function + method signatures ──────────────
        //  Generic templates (untyped params) and overload sets (>=2 free
        //  decls sharing a name) are resolved by the code generator
        //  (monomorphisation / dispatch); the analyser only exempts them
        //  from the single-definition rule and leaves their call sites
        //  loosely typed.
        for fd in prog.functions do
            if fnIsTemplate(fd) then
                //  A template does not also overload (design.md, Functions).
                for other in prog.functions do
                    if other.name == fd.name and (other.line != fd.line or other.column != fd.column) then
                        err(fd, "template '" + fd.name + "' cannot share its name with another '" + fd.name + "' declaration (a template does not overload)")
                if not (fd.name in m_templateNames) then
                    m_templateNames += [fd.name]
                m_tplFns += [fd]
                continue
            if freeDeclCount(prog, fd.name) >= 2 then
                if not (fd.name in m_overloadNames) then
                    m_overloadNames += [fd.name]
                if not hasFn(fd.name) then
                    registerFn(fd.name, "", fd)
                continue
            if hasFn(fd.name) then
                err(fd, "duplicate function '" + fd.name + "'")
            registerFn(fd.name, "", fd)
        for cl in prog.classes do
            for m in cl.methods do
                registerFn(methodSym(cl.name, m), cl.name, m)

        // ── Pass 1b/1c: default parameter values (see sema_stmt.kmm) and
        //  `export fn` / `extern fn … = "sym"` rules; one error per
        //  declaration is recorded and the rest are still checked ──
        for fd in prog.functions do
            checkDeclKeepGoing(fd, "")
        for cl in prog.classes do
            for m in cl.methods do
                checkDeclKeepGoing(m, cl.name)

        // ── Pass 2: top-level macros ──────────────────────────────
        for mac in prog.macros do
            if isMacro(mac.name) then
                err(mac, "duplicate macro '" + mac.name + "'")
            pushMacro(mac.name, mac.init)

        // ── Pass 2b: top-level variables ─────────────────────────
        // Registered before any body so every function sees them, and in
        // source order so an initialiser may read an earlier global.
        for g in prog.globals do
            registerGlobal(g)

        // ── Pass 3: check + annotate every body ───────────────────
        //  Templates are skipped: their parameter types are known only
        //  per call site, so codegen type-checks each monomorphised copy.
        //  Overload members are ordinary functions — checked normally.
        //  An error inside one body does not stop the others: it is
        //  recorded and the next function is checked (up to 20 errors),
        //  then they are all thrown together, one per line.
        for fd in prog.functions do
            if fnIsTemplate(fd) then
                continue
            checkFunctionKeepGoing(fd, "")
        for cl in prog.classes do
            for m in cl.methods do
                checkFunctionKeepGoing(m, cl.name)
        if #m_errors > 0 then
            throw join(m_errors, "\n")

        // non-fatal bad-practice warnings, in source order
        for w in m_lints do
            print(diagOne(locate(w, m_srcFiles, m_srcStarts)))

        prog.analyzed = true
        prog.usesCopy = m_usesCopy

    // ── diagnostics ───────────────────────────────────────────────

    // `checkFunction` with the error caught at the function boundary.
    // `checkFunction` resets all per-function state (scopes, macros,
    // loop depth) on entry, so continuing with the next body is safe.
    mut checkFunctionKeepGoing(fd: FunctionDecl, owner: string)
        if #m_errors >= 20 then
            return
        let ok = checkFunctionOk(fd, owner)?
        if ok == null then
            m_errors += [km_error_message() or "internal error"]

    mut checkDeclKeepGoing(fd: FunctionDecl, owner: string)
        if #m_errors >= 20 then
            return
        let ok = checkDeclOk(fd, owner)?
        if ok == null then
            m_errors += [km_error_message() or "internal error"]

    mut checkDeclOk(fd: FunctionDecl, owner: string): int
        checkParamDefaults(fd, owner)
        if owner == "" then
            if fd.isExport then
                checkExport(fd)
            if fd.isExtern and fd.symbol != null then
                checkExternSymbol(fd)
        return 1

    mut checkFunctionOk(fd: FunctionDecl, owner: string): int
        checkFunction(fd, owner)
        return 1

    void err(node: ASTNode, msg: string)
        throw (string(node.line) + ":" + string(node.column) + ": " + msg)

    // A strict-mode-only diagnostic: hard error under `strict`, silent
    // otherwise.
    void warn(node: ASTNode, msg: string)
        if m_strict then
            throw (string(node.line) + ":" + string(node.column) + ": " + msg)

    // A non-fatal warning about a legal-but-suspicious construct — "this
    // looks like a mistake" checks (dead code, self-assignment, `x / 0`,
    // …).  Always recorded; the driver prints `lints()` after a
    // successful analysis and the compile proceeds.  Under `strict` the
    // same finding is escalated to a hard error.
    mut lint(node: ASTNode, msg: string)
        let at = string(node.line) + ":" + string(node.column) + ": "
        if m_strict then
            throw (at + msg)
        m_lints += [at + "warning: " + msg]

    mut lints(): [string]
        return m_lints

    // ── lint helpers ─────────────────────────────────────────────

    // an integer literal lexeme whose value is 0 (`0`, `-0`, `000`)
    mut intZero(v: string): bool
        let i = 0
        if v.length > 0 and v[0] == "-" then
            i = 1
        if i >= v.length then
            return false
        while i < v.length do
            if v[i] != "0" then
                return false
            i += 1
        return true

    // two expressions that are syntactically the same plain variable
    mut sameVar(a: Expression?, b: Expression?): bool
        if a == null or b == null then
            return false
        if a is Identifier and b is Identifier then
            return a.name == b.name
        return false

    // "" unless `e` is a literal that is always truthy / always falsy as
    // a condition, in which case the word "true" / "false"
    mut constTruthWord(e: Expression?): string
        if e == null then
            return ""
        if e is BoolLiteral then
            if e.value then
                return "true"
            return "false"
        if e is NullLiteral then
            return "false"
        if e is IntLiteral then
            if intZero(e.value) then
                return "false"
            return "true"
        return ""

    // ── type registry ────────────────────────────────────────────

    fn methodSym(className: string, m: FunctionDecl): string
        if m.isConstructor then
            return className + "__ctor"
        return className + "__" + m.name

    mut parentOrEmpty(p: string?): string
        return stripOpt(p) or ""

    // `parent` / `name` live on `StructDecl` / `ClassDecl`, not their
    // common `Declaration` base — reach them through a narrowing helper.
    mut declParentName(d: Declaration): string
        if d is StructDecl then
            return parentOrEmpty(d.parent)
        if d is ClassDecl then
            return parentOrEmpty(d.parent)
        return ""

    mut declName(d: Declaration): string
        if d is StructDecl then
            return d.name
        if d is ClassDecl then
            return d.name
        return ""

    // structs + classes ordered so a type always follows its parent
    mut orderTypes(prog: Program): [Declaration]
        let work: [Declaration] = []
        for st in prog.structs do
            work += [st]
        for cl in prog.classes do
            work += [cl]
        let ordered: [Declaration] = []
        let done: [string] = []
        let guard = 0
        while #work > 0 do
            let remaining: [Declaration] = []
            let progressed = false
            for d in work do
                let par = declParentName(d)
                if par == "" or (par in done) then
                    ordered += [d]
                    done += [declName(d)]
                    progressed = true
                else
                    remaining += [d]
            work = remaining
            if not progressed then
                err(work[0], "cyclic or unresolved inheritance near '" + declName(work[0]) + "'")
            guard += 1
            if guard > 100000 then
                throw "inheritance ordering did not converge"
        return ordered

    mut registerEnum(en: EnumDecl)
        if (en.name in m_typeNames) then
            err(en, "duplicate type '" + en.name + "'")
        m_typeIdx.add(en.name, #m_typeNames)
        m_typeNames += [en.name]
        m_typeIsClass += [false]
        m_typeIsEnum += [true]
        m_typeIsAbstract += [false]
        m_typeIsUnique += [false]
        m_typeIsExtern += [false]
        m_typeParent += [""]
        m_typeFieldNames += [[]]
        m_typeFieldTypes += [[]]
        m_typeFieldHasDef += [[]]
        m_typeOwnMethods += [[]]
        m_enumVariants += [en.variants]

    mut registerStruct(d: StructDecl)
        let names: [string] = []
        let types: [string] = []
        let hasDef: [bool] = []
        for m in d.members do
            names += [m.name]
            types += [m.declaredType or "int"]
            hasDef += [m.defaultValue != null]
        registerType(d.name, d.parent, d, false, d.isAbstract, d.isUnique, names, types, hasDef)
        if d.isExtern then
            m_typeIsExtern[typeIndex(d.name)] = true

    mut registerClass(d: ClassDecl)
        let names: [string] = []
        let types: [string] = []
        let hasDef: [bool] = []
        for f in d.fields do
            names += [f.name]
            types += [f.declaredType or "int"]
            hasDef += [f.defaultValue != null]
        registerType(d.name, d.parent, d, true, d.isAbstract, false, names, types, hasDef)
        let ti = typeIndex(d.name)
        for f in d.fields do
            m_ownMembers += [d.name + "." + f.name]
            m_ownIdx.add(d.name + "." + f.name, 0)
            if f.visibility == "private" then
                m_privMembers += [d.name + "." + f.name]
        for m in d.methods do
            if not m.isConstructor then
                m_typeOwnMethods[ti] += [m.name]
                m_ownMembers += [d.name + "." + m.name]
                m_ownIdx.add(d.name + "." + m.name, 0)
                if m.visibility == "private" then
                    m_privMembers += [d.name + "." + m.name]

    mut registerType(name: string, parent: string?, node: ASTNode, isClass: bool, isAbs: bool, isUniq: bool, fnames: [string], ftypes: [string], fdef: [bool])
        if (name in m_typeNames) then
            err(node, "duplicate type '" + name + "'")
        let par = parentOrEmpty(parent)
        // ownership is inherited: a child of a `unique` base is unique too.
        let uniq = isUniq
        if par != "" then
            let upi = typeIndex(par)
            if upi >= 0 and m_typeIsUnique[upi] then
                uniq = true
        let allNames: [string] = []
        let allTypes: [string] = []
        let allDef: [bool] = []
        if par != "" then
            let pi = typeIndex(par)
            if pi < 0 then
                err(node, "type '" + name + "' inherits unknown type '" + par + "'")
            for x in m_typeFieldNames[pi] do
                allNames += [x]
            for x in m_typeFieldTypes[pi] do
                allTypes += [x]
            for x in m_typeFieldHasDef[pi] do
                allDef += [x]
        let k = 0
        while k < #fnames do
            allNames += [fnames[k]]
            allTypes += [ftypes[k]]
            allDef += [fdef[k]]
            k += 1
        m_typeIdx.add(name, #m_typeNames)
        m_typeNames += [name]
        m_typeIsClass += [isClass]
        m_typeIsEnum += [false]
        m_typeIsAbstract += [isAbs]
        m_typeIsUnique += [uniq]
        m_typeIsExtern += [false]
        m_typeParent += [par]
        m_typeFieldNames += [allNames]
        m_typeFieldTypes += [allTypes]
        m_typeFieldHasDef += [allDef]
        m_typeOwnMethods += [[]]
        m_enumVariants += [[]]

    mut typeIndex(name: string): int
        return m_typeIdx.first(name)

    mut isObjType(name: string): bool
        return typeIndex(name) >= 0

    mut isEnumType(name: string): bool
        let ti = typeIndex(name)
        return ti >= 0 and m_typeIsEnum[ti]

    mut isClassType(name: string): bool
        let ti = typeIndex(name)
        return ti >= 0 and m_typeIsClass[ti]

    mut isAbstractType(name: string): bool
        let ti = typeIndex(name)
        return ti >= 0 and m_typeIsAbstract[ti]

    // `unique struct T` (or a struct descended from one): its values carry
    // single-owner move semantics — see `consumeMove` / `isMoved`.
    mut isUniqueType(name: string): bool
        let ti = typeIndex(name)
        return ti >= 0 and m_typeIsUnique[ti]

    // `extern type T` — an opaque C handle: a distinct nominal type,
    // pointer-sized, with no fields and no `new`.
    mut isExternType(name: string): bool
        let ti = typeIndex(name)
        return ti >= 0 and m_typeIsExtern[ti]

    mut typeParentOf(name: string): string
        let ti = typeIndex(name)
        if ti < 0 then
            return ""
        return m_typeParent[ti]

    mut isDescendantOf(t: string, ancestor: string): bool
        let cur = typeParentOf(t)
        let guard = 0
        while cur != "" do
            if cur == ancestor then
                return true
            cur = typeParentOf(cur)
            guard += 1
            if guard > 100000 then
                return false
        return false

    // structural: `src` usable where `dst` (an object type) is wanted
    mut objAssignable(dst: string, src: string): bool
        if dst == src then
            return true
        return isDescendantOf(src, dst)

    mut fieldNamesOf(typeName: string): [string]
        let ti = typeIndex(typeName)
        if ti < 0 then
            return []
        return m_typeFieldNames[ti]

    mut hasField(typeName: string, field: string): bool
        return (field in fieldNamesOf(typeName))

    // The class that declares member `field` (a field or method) for a
    // receiver statically `typeName`: the nearest class up the chain whose
    // own section declares it, or "" when none does.
    mut fieldDeclaringClass(typeName: string, field: string): string
        let cur = typeName
        let guard = 0
        while cur != "" do
            if m_ownIdx.has(cur + "." + field) then
                return cur
            cur = typeParentOf(cur)
            guard += 1
            if guard > 100000 then
                return ""
        return ""

    // A `private` class member is reachable only from the members of the
    // class that declares it (a subclass does not inherit that access).
    mut checkMemberAccess(node: ASTNode, owner: string, member: string)
        if owner == "" or m_curClass == owner then
            return
        if (owner + "." + member) in m_privMembers then
            err(node, "'" + member + "' is private to class '" + owner + "'")

    mut checkFieldAccess(node: ASTNode, typeName: string, field: string)
        checkMemberAccess(node, fieldDeclaringClass(typeName, field), field)

    // the declared type string of a field (may carry a trailing "?")
    mut fieldDeclType(typeName: string, field: string): string
        let ti = typeIndex(typeName)
        if ti < 0 then
            return "int"
        let names = m_typeFieldNames[ti]
        let i = 0
        while i < #names do
            if names[i] == field then
                return m_typeFieldTypes[ti][i]
            i += 1
        return "int"

    mut fieldHasDefault(typeName: string, field: string): bool
        let ti = typeIndex(typeName)
        if ti < 0 then
            return false
        let names = m_typeFieldNames[ti]
        let i = 0
        while i < #names do
            if names[i] == field then
                return m_typeFieldHasDef[ti][i]
            i += 1
        return false

    // The static type of reading `obj.field`.  A *struct* field of object
    // type with no non-null default is implicitly nullable — `new T()`
    // zero-fills it.  *Class* fields are trusted to be set by the
    // constructor, so they stay non-null unless annotated `T?`.
    mut fieldReadType(typeName: string, field: string): Type
        let raw = fieldDeclType(typeName, field)
        let t = parseTypeStr(raw)
        if isClassType(typeName) then
            return t
        if t.kind == "object" and not isEnumType(t.name) and not fieldHasDefault(typeName, field) then
            return tNullable(t)
        return t

    mut fieldCount(typeName: string): int
        return #fieldNamesOf(typeName)

    // the class that declares `method` for a receiver statically `className`
    mut methodOwner(className: string, method: string): string
        let cur = className
        let guard = 0
        while cur != "" do
            let ti = typeIndex(cur)
            if ti >= 0 and (method in m_typeOwnMethods[ti]) then
                return cur
            cur = typeParentOf(cur)
            guard += 1
            if guard > 100000 then
                return ""
        // an interface method a subclass supplies but the (abstract) base
        // does not declare — resolve it against the first such subclass so
        // the signature is known; codegen dispatches it virtually.
        let ci = typeIndex(className)
        if ci >= 0 and m_typeIsAbstract[ci] then
            let d = 0
            while d < #m_typeNames do
                if isDescendantOf(m_typeNames[d], className) and (method in m_typeOwnMethods[d]) then
                    return m_typeNames[d]
                d += 1
        return ""

    // ── function-signature registry ──────────────────────────────

    mut registerFn(sym: string, owner: string, fd: FunctionDecl)
        m_fnIdx.add(sym, #m_fnNames)
        m_fnNames += [sym]
        m_fnOwner += [owner]
        let ptypes: [string] = []
        if owner != "" then
            ptypes += [owner]                 // implicit `self` / receiver
        for p in fd.params do
            ptypes += [p.declaredType or "any"]
        m_fnParamTypes += [ptypes]
        m_fnRet += [retDeclOf(fd)]
        m_fnKind += [kindOf(fd)]
        m_fnVariadic += [fd.variadic]
        // fewest arguments a call may pass: every parameter without a
        // default (the implicit receiver always counts)
        let req = 0
        if owner != "" then
            req = 1
        for p in fd.params do
            if p.defaultValue == null then
                req += 1
        m_fnRequired += [req]
        m_fnLinked += [fd.isPrototype or fd.isExtern]
        m_fnVis += [fd.visibility]
        m_fnMod += [fd.moduleOwner]

    mut fnVisOf(sym: string): string
        let i = fnIndex(sym)
        if i < 0 then
            return "public"
        return m_fnVis[i]

    mut fnModOf(sym: string): string
        let i = fnIndex(sym)
        if i < 0 then
            return ""
        return m_fnMod[i]

    mut retDeclOf(fd: FunctionDecl): string
        if fd.isVoid or fd.returnType == null then
            return "void"
        return fd.returnType or "void"

    mut kindOf(fd: FunctionDecl): string
        if fd.isExtern then
            return "extern"
        if fd.isVoid or fd.returnType == null then
            return "void"
        if fd.isMut then
            return "mut"
        return "fn"

    mut fnIndex(sym: string): int
        return m_fnIdx.first(sym)

    mut hasFn(sym: string): bool
        return fnIndex(sym) >= 0

    mut fnParamTypes(sym: string): [string]
        let i = fnIndex(sym)
        if i < 0 then
            return []
        return m_fnParamTypes[i]

    mut fnRetType(sym: string): string
        let i = fnIndex(sym)
        if i < 0 then
            return "void"
        return m_fnRet[i]

    mut fnKindOf(sym: string): string
        let i = fnIndex(sym)
        if i < 0 then
            return ""
        return m_fnKind[i]

    mut fnRequiredOf(sym: string): int
        let i = fnIndex(sym)
        if i < 0 then
            return 0
        return m_fnRequired[i]

    mut fnIsVariadic(sym: string): bool
        let i = fnIndex(sym)
        if i < 0 then
            return false
        return m_fnVariadic[i]

    // A link-time symbol (prototype / extern): its body is not visible,
    // so the "a pure `fn` may not call a void procedure" rule — a proxy
    // for hidden mutation — does not apply to it.
    mut fnIsLinked(sym: string): bool
        let i = fnIndex(sym)
        if i < 0 then
            return false
        return m_fnLinked[i]

    // `console.print` → `console_print` (dotted stdlib calls carry their
    // module in the name; the linked symbol is the "_"-joined form).
    mut mangleDotted(name: string): string
        let out = ""
        let i = 0
        while i < name.length do
            if name[i] == "." then
                out = out + "_"
            else
                out = out + name[i]
            i += 1
        return out

    // ── macro registry (block-scoped stack, mirrors Codegen) ─────

    mut isMacro(name: string): bool
        return (name in m_macroNames)

    mut macroExprOf(name: string): Expression?
        let i = #m_macroNames - 1
        while i >= 0 do
            if m_macroNames[i] == name then
                return m_macroExprs[i]
            i -= 1
        return null

    mut macroMark(): int
        return #m_macroNames

    void macroRestore(mark: int)
        while #m_macroNames > mark do
            m_macroNames = m_macroNames[0 to (#m_macroNames - 1)]
            m_macroExprs = m_macroExprs[0 to (#m_macroExprs - 1)]

    void pushMacro(name: string, e: Expression?)
        if e == null then
            throw ("macro '" + name + "' has no value")
        m_macroNames += [name]
        m_macroExprs += [e]

    // ── top-level variable registry (process-wide, never reset) ──

    mut isGlobalVar(name: string): bool
        return (name in m_globalNames)

    mut globalVarType(name: string): Type
        let i = 0
        while i < #m_globalNames do
            if m_globalNames[i] == name then
                return m_globalTypes[i]
            i += 1
        return tPrim("int")

    // Type-check one `let NAME [: T] = EXPR` / `let NAME : T` and record
    // its type.  Initialisers see functions (Pass 1) and every earlier
    // global; a forward reference to a later global is not allowed.
    mut registerGlobal(g: VarDecl)
        if isGlobalVar(g.name) or isMacro(g.name) or (g.name in m_fnNames) then
            err(g, "duplicate top-level name '" + g.name + "'")
        if g.isExtern then
            checkExternVar(g)

        if g.constArray then
            checkConstArray(g)

        let declared: Type? = null
        if g.declaredType != null then
            declared = parseTypeStr(g.declaredType)

        let initT: Type? = null
        if g.init != null then
            initT = inferExpr(g.init)

        let bound = tPrim("int")
        if declared != null then
            bound = declared
            if initT != null then
                checkAssignable(g, declared, initT, "initialiser for '" + g.name + "'")
        else if initT != null then
            bound = widenForBinding(initT)
        else
            err(g, "top-level '" + g.name + "' needs a type annotation or an initialiser")

        g.resolvedType = typeToLegacy(bound)
        m_globalNames += [g.name]
        m_globalTypes += [bound]

    // ── lexical scope for locals / params (flat per function) ────
    //
    //  Komodo locals do not lexically shadow one another (only macros
    //  do), so a single flat table per function is faithful to codegen's
    //  frame model.  `m_scopeType` is the *current, possibly narrowed*
    //  type; `m_scopeDecl` is the declared one narrowing may not exceed.

    void scopeReset()
        m_scopeNames = []
        m_scopeDecl = []
        m_scopeType = []
        m_scopeImmut = []
        m_scopeUsed = []
        m_scopeMoved = []
        m_scopeMovedAt = []
        m_scopeDeclAt = []
        m_pathKeys = []
        m_pathTypes = []

    mut scopeHas(name: string): bool
        return (name in m_scopeNames)

    mut scopeAdd(name: string, t: Type, immut: bool)
        if scopeHas(name) then
            return
        m_scopeNames += [name]
        m_scopeDecl += [t]
        m_scopeType += [t]
        m_scopeImmut += [immut]
        m_scopeUsed += [false]
        m_scopeMoved += [false]
        m_scopeMovedAt += [""]
        m_scopeDeclAt += [string(m_declLine) + ":" + string(m_declCol)]

    // ── ownership / move tracking (unique structs) ───────────────────
    //
    //  A binding of `unique` type is "moved" once its value has been
    //  transferred elsewhere (bound, assigned, stored, returned).  Reading
    //  a moved binding is an error until a fresh value revives it.

    mut markMoved(name: string, at: ASTNode)
        let i = scopeIndex(name)
        if i >= 0 then
            m_scopeMoved[i] = true
            m_scopeMovedAt[i] = string(at.line) + ":" + string(at.column)

    mut isMoved(name: string): bool
        let i = scopeIndex(name)
        return i >= 0 and m_scopeMoved[i]

    mut movedAt(name: string): string
        let i = scopeIndex(name)
        if i < 0 then
            return "?"
        return m_scopeMovedAt[i]

    // a fresh value has landed in `name` — it owns again
    mut reviveBinding(name: string)
        let i = scopeIndex(name)
        if i >= 0 then
            m_scopeMoved[i] = false
            m_scopeMovedAt[i] = ""

    mut movedSnapshot(): [bool]
        let out: [bool] = []
        for b in m_scopeMoved do
            out += [b]
        return out

    mut movedApply(snap: [bool])
        let i = 0
        while i < #snap and i < #m_scopeMoved do
            m_scopeMoved[i] = snap[i]
            i += 1

    // conservative merge of two control-flow paths: a binding is moved
    // after the join if it was moved on either side.
    mut movedUnion(a: [bool], b: [bool]): [bool]
        let out: [bool] = []
        let i = 0
        while i < #m_scopeMoved do
            let av = i < #a and a[i]
            let bv = i < #b and b[i]
            out += [av or bv]
            i += 1
        return out

    mut scopeIndex(name: string): int
        let i = 0
        while i < #m_scopeNames do
            if m_scopeNames[i] == name then
                return i
            i += 1
        return 0 - 1

    mut scopeType(name: string): Type
        let i = scopeIndex(name)
        if i < 0 then
            return tPrim("int")
        m_scopeUsed[i] = true
        return m_scopeType[i]

    mut scopeDeclType(name: string): Type
        let i = scopeIndex(name)
        if i < 0 then
            return tPrim("int")
        return m_scopeDecl[i]

    mut scopeImmut(name: string): bool
        let i = scopeIndex(name)
        if i < 0 then
            return false
        return m_scopeImmut[i]

    // set the current (narrowed or reassigned) type of a binding
    mut scopeNarrow(name: string, t: Type)
        let i = scopeIndex(name)
        if i >= 0 then
            m_scopeType[i] = t

    // snapshot / restore narrowings around a branch
    mut scopeSnapshot(): [Type]
        let out: [Type] = []
        for t in m_scopeType do
            out += [t]
        return out

    mut scopeApply(snap: [Type])
        let i = 0
        while i < #snap and i < #m_scopeType do
            m_scopeType[i] = snap[i]
            i += 1

    // ── member-path narrowing (`e.right`, `func.ownerClass`, …) ──────
    //
    //  A limited, TypeScript-style refinement of `receiver.field` accesses
    //  after `x.f == null` / `x.f is T` guards.  Keyed by a dotted path
    //  string; invalidated when anything on that path is written.

    mut pathIndex(key: string): int
        let i = 0
        while i < #m_pathKeys do
            if m_pathKeys[i] == key then
                return i
            i += 1
        return 0 - 1

    mut pathType(key: string): Type?
        let i = pathIndex(key)
        if i < 0 then
            return null
        return m_pathTypes[i]

    mut pathNarrow(key: string, t: Type)
        if key == "" then
            return
        let i = pathIndex(key)
        if i >= 0 then
            m_pathTypes[i] = t
        else
            m_pathKeys += [key]
            m_pathTypes += [t]

    // Drop `key` and any deeper path rooted at it (a write invalidates
    // every refinement that assumed the old value).
    mut pathClear(key: string)
        if key == "" then
            return
        let nk: [string] = []
        let nt: [Type] = []
        let pfx = key + "."
        let i = 0
        while i < #m_pathKeys do
            let k = m_pathKeys[i]
            let deeper = #k > #pfx and k[0 to #pfx] == pfx
            if k != key and not deeper then
                nk += [k]
                nt += [m_pathTypes[i]]
            i += 1
        m_pathKeys = nk
        m_pathTypes = nt

    mut pathMark(): int
        return #m_pathKeys

    mut pathSnap(): [Type]
        let out: [Type] = []
        for t in m_pathTypes do
            out += [t]
        return out

    mut pathRestore(mark: int, snap: [Type])
        while #m_pathKeys > mark do
            m_pathKeys = m_pathKeys[0 to (#m_pathKeys - 1)]
            m_pathTypes = m_pathTypes[0 to (#m_pathTypes - 1)]
        let i = 0
        while i < #snap and i < #m_pathTypes do
            m_pathTypes[i] = snap[i]
            i += 1

    // Dotted path of an lvalue-ish expression, or "" if not narrowable.
    mut pathOf(e: Expression?): string
        if e == null then
            return ""
        if e is Identifier then
            return e.name
        if e is MemberExpr then
            let base = pathOf(e.object)
            if base == "" then
                return ""
            return base + "." + e.member
        return ""

    // ── current-function context ────────────────────────────────

    mut curClassFieldType(name: string): Type
        if m_curClass == "" then
            return tPrim("int")
        return fieldReadType(m_curClass, name)

    mut isCurField(name: string): bool
        if m_curClass == "" then
            return false
        return hasField(m_curClass, name)

    // ── misc helpers ───────────────────────────────────────────

    // ── "did you mean" suggestions ───────────────────────────────
    //
    //  A small Levenshtein distance: the number of single-character
    //  insert / delete / substitute edits that turn `a` into `b`.
    //  Two rolling rows, so it costs O(#a · #b) time and O(#b) space.
    mut editDistance(a: string, b: string): int
        let n = a.length
        let m = b.length
        if n == 0 then
            return m
        if m == 0 then
            return n
        let prev: [int] = []
        let j = 0
        while j <= m do
            prev += [j]
            j += 1
        let i = 1
        while i <= n do
            let cur: [int] = [i]
            let k = 1
            while k <= m do
                let cost = 1
                if a[i - 1] == b[k - 1] then
                    cost = 0
                let best = prev[k] + 1                 // delete
                let ins = cur[k - 1] + 1               // insert
                if ins < best then
                    best = ins
                let sub = prev[k - 1] + cost           // substitute
                if sub < best then
                    best = sub
                cur += [best]
                k += 1
            prev = cur
            i += 1
        return prev[m]

    //  The nearest entry in `candidates` to `name`, or "" when nothing
    //  is close enough to be worth mentioning.  The threshold is tighter
    //  for short names (a 1-edit gap between two 3-letter words is noise).
    mut closestName(name: string, candidates: [string]): string
        let limit = 2
        if name.length <= 4 then
            limit = 1
        let best = ""
        let bestD = 999
        for c in candidates do
            if c != name and c.length > 0 then
                let d = editDistance(name, c)
                if d < bestD then
                    bestD = d
                    best = c
        if bestD <= limit then
            return best
        return ""

    //  " (did you mean 'x'?)" or "" — append to any err() message.
    mut didYouMean(name: string, candidates: [string]): string
        let c = closestName(name, candidates)
        if c == "" then
            return ""
        return " (did you mean '" + c + "'?)"

    //  Every name that could legally stand where an identifier is used:
    //  locals in scope, free functions, globals, macros, current-class
    //  fields, and enum-variant shorthands.
    mut identCandidates(): [string]
        let out: [string] = []
        for s in m_scopeNames do
            out += [s]
        for f in m_fnNames do
            if dotIndex(f) < 0 then
                out += [f]
        for g in m_globalNames do
            out += [g]
        for mm in m_macroNames do
            out += [mm]
        if m_curClass != "" then
            let ti = typeIndex(m_curClass)
            if ti >= 0 then
                for fld in m_typeFieldNames[ti] do
                    out += [fld]
        let i = 0
        while i < #m_typeNames do
            if m_typeIsEnum[i] then
                for v in m_enumVariants[i] do
                    out += [v]
            i += 1
        return out

    //  Constructible type names (struct / class), for a bad `new T`.
    mut typeCandidates(): [string]
        let out: [string] = []
        let i = 0
        while i < #m_typeNames do
            if not m_typeIsEnum[i] then
                out += [m_typeNames[i]]
            i += 1
        return out

    mut dotIndex(s: string): int
        let i = 0
        while i < s.length do
            if s[i] == "." then
                return i
            i += 1
        return 0 - 1

    // ── overloading / generic templates ─────────────────────────────
    //  Both are resolved by the code generator (`Codegen::selectOverload`
    //  / `ensureInstance`); the analyser just relaxes its rules for the
    //  names involved and leaves their call sites loosely typed.

    //  A free function with >=1 un-annotated parameter — a
    //  monomorphisation template, never emitted as-is.  Must match
    //  `Codegen::isTemplateDecl` exactly (a `void` procedure with untyped
    //  params counts, so it is *not* excluded here).
    mut fnIsTemplate(fd: FunctionDecl): bool
        if fd.isExtern or fd.isPrototype or fd.isConstructor then
            return false
        if fd.variadic or fd.name == "main" then
            return false
        for p in fd.params do
            if p.declaredType == null then
                return true
        return false

    //  How many non-template free declarations share `name`.
    mut freeDeclCount(prog: Program, name: string): int
        let n = 0
        for fd in prog.functions do
            if fd.name == name and not fnIsTemplate(fd) then
                n += 1
        return n

    mut isTemplateName(name: string): bool
        return (name in m_templateNames)

    mut isOverloadedName(name: string): bool
        return (name in m_overloadNames)

private
    m_strict: bool = false
    // merged-source line map, for reporting warnings per file (`locate`)
    m_srcFiles: [string] = []
    m_srcStarts: [int] = []
    // non-fatal warnings collected during analysis (see `lint`)
    m_lints: [string] = []
    m_errors: [string] = []

    // type registry (`m_typeIdx` hashes m_typeNames — see StrIndex)
    m_typeNames: [string] = []
    m_typeIdx: StrIndex
    m_typeIsClass: [bool] = []
    m_typeIsEnum: [bool] = []
    m_typeIsAbstract: [bool] = []
    m_typeIsUnique: [bool] = []
    m_typeIsExtern: [bool] = []
    m_typeParent: [string] = []
    m_typeFieldNames: [[string]] = []
    m_typeFieldTypes: [[string]] = []
    m_typeFieldHasDef: [[bool]] = []
    m_typeOwnMethods: [[string]] = []
    m_enumVariants: [[string]] = []

    // free-function names that are monomorphisation templates (untyped
    // params) or overload sets (>=2 decls); codegen resolves both.
    m_templateNames: [string] = []
    m_overloadNames: [string] = []

    // function-signature registry (`m_fnIdx` hashes m_fnNames)
    m_fnNames: [string] = []
    m_constArrs: [string] = []       // constant-array names (`x := [..]`)
    m_constOk: bool = false          // next Identifier may name one (index / # / for-in)
    m_fnIdx: StrIndex
    m_fnOwner: [string] = []
    m_fnParamTypes: [[string]] = []
    m_fnRet: [string] = []
    m_fnKind: [string] = []
    m_fnVariadic: [bool] = []
    m_fnRequired: [int] = []      // fewest args a call may pass (see registerFn)
    // generic templates' declarations, for their call-arity check
    m_tplFns: [FunctionDecl] = []
    m_fnLinked: [bool] = []
    m_fnVis: [string] = []       // "public" / "private" (module section)
    // class members: "Class.member" for each own field and method, and the
    // subset declared under a `private` section
    m_ownMembers: [string] = []
    m_ownIdx: StrIndex            // hashes m_ownMembers
    m_privMembers: [string] = []
    m_fnMod: [string] = []       // owning module name ("" for the program)
    // module of the function body currently being checked (for privacy)
    m_curModuleOwner: string = ""

    // macros
    m_macroNames: [string] = []
    m_macroExprs: [Expression?] = []
    // top-level `let` variables — registered once, visible to every body
    m_globalNames: [string] = []
    m_globalTypes: [Type] = []
    // number of (top-level) macros present before any function body ran
    m_macroBase: int = 0
    m_macroBaseSet: bool = false

    // lexical scope
    m_scopeNames: [string] = []
    m_scopeDecl: [Type] = []
    m_scopeType: [Type] = []
    m_scopeImmut: [bool] = []
    m_scopeUsed: [bool] = []
    // per-binding ownership state for `unique` types
    m_scopeMoved: [bool] = []
    m_scopeMovedAt: [string] = []
    m_scopeDeclAt: [string] = []     // "line:col" where each binding was declared
    m_declLine: int = 0              // position of the statement being checked
    m_declCol: int = 0

    // member-path narrowings
    m_pathKeys: [string] = []
    m_pathTypes: [Type] = []

    // current function
    m_curClass: string = ""
    m_curFnName: string = ""
    m_curRet: Type? = null
    m_curVoid: bool = false
    m_curKind: string = "fn"
    m_loopDepth: int = 0
    // set when a `copy(x)` call is seen anywhere in the program
    m_usesCopy: bool = false
