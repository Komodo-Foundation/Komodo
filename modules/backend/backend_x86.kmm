module km_compiler

// ═══════════════════════════════════════════════════════════════════════
//  X86Backend — System V AMD64 target, NASM syntax.
//
//  This is the reference lowering for the `Backend` operation vocabulary
//  (see backend.kmm).  Everything that knows about x86-64 or NASM's
//  concrete syntax lives here: the line buffer, the register/SSE
//  conventions, the aligned-call sequence, .rodata interning, the extern
//  list and the final file (header + body + footer).
//
//  Result convention:  int / pointer / string → rax,  float → xmm0.
//  Locals live at `[rbp - off]`, where `off` is the byte offset handed
//  out by `Codegen` (see codegen_frame.kmm).  `[rbp - 8]` holds the
//  saved rbx (see emitCall); the first real local starts at `[rbp - 16]`.
// ═══════════════════════════════════════════════════════════════════════

class X86Backend : Backend
private
    m_lines: [string] = []         // .text body, one entry per line
    m_rodata: [string] = []        // .rodata lines (dq / db), joined in footer
    m_globals: [string] = []       // top-level variable names → .bss cells
    m_doubleId: int = 0
    m_stringId: int = 0
    // constant-pool dedup: identical .rodata constants (doubles and
    // immutable string literals) share one label.  Always on — the pool
    // holds read-only data, so merging entries never changes behaviour
    // and is independent of the optimiser level.
    m_intern: bool = true
    m_poolKeys: [string] = []      // "d:<value>" / "s:<lexeme>"
    m_poolLabels: [string] = []
    m_poolIdx: StrIndex = new StrIndex()   // hash index over m_poolKeys
    m_externs: [string] = []       // link-time symbols to `extern`
    m_usesMalloc: bool = false
    m_usesAppend: bool = false
    m_usesStr: bool = false
    m_usesFfiStruct: bool = false   // reserve km_ffi_marshal scratch in .bss
    m_vtblText: [string] = []         // `__vt_<id>: dq …` lines
    m_vtabCount: int = 0            // number of registered type ids
    m_vtabSet: [int] = []           // ids that have a real vtable
    m_dispEnd: string = ""          // overload dispatch: shared exit label
    m_dispNext: string = ""         // overload dispatch: current case's skip label
    m_tryCatch: [string] = []       // protected-call: catch labels (nesting stack)
    m_tryDone: [string] = []        // protected-call: done labels (nesting stack)

// ── line buffer ────────────────────────────────────────────────────

void X86Backend::emit(line: string)
    m_lines += [line]

void X86Backend::ins(text: string)
    emit("    " + text)

void X86Backend::label(name: string)
    emit(name + ":")

// Emit a `call` with the stack force-aligned to 16 bytes.  rbx holds the
// pre-call rsp (callee-saved, and every generated function saves the
// caller's rbx in its prologue), so temporaries left on the stack
// mid-expression can never break an inner call's alignment.
void X86Backend::emitCall(sym: string)
    ins("mov rbx, rsp")
    ins("and rsp, -16")
    ins("call " + sym)
    ins("mov rsp, rbx")

// ── .rodata interning ──────────────────────────────────────────────

mut X86Backend::poolFind(key: string): string
    if not m_intern then
        return ""
    let i = m_poolIdx.first(key)
    if i < 0 then
        return ""
    return m_poolLabels[i]

mut X86Backend::poolAdd(key: string, label: string)
    if m_intern then
        m_poolIdx.add(key, #m_poolKeys)
        m_poolKeys += [key]
        m_poolLabels += [label]

mut X86Backend::addDouble(value: string): string
    let hit = poolFind("d:" + value)
    if hit != "" then
        return hit
    m_doubleId += 1
    let name = "LC" + string(m_doubleId)
    m_rodata += [name + ": dq " + value + "\n"]
    poolAdd("d:" + value, name)
    return name

// `lexeme` still carries its quotes.  NASM back-quoted strings honour
// the same \n \t \\ escapes as Komodo source, so the body passes through.
mut X86Backend::addString(lexeme: string): string
    let hit = poolFind("s:" + lexeme)
    if hit != "" then
        return hit
    m_stringId += 1
    let name = "LS" + string(m_stringId)
    poolAdd("s:" + lexeme, name)
    let raw = lexeme[1 to (lexeme.length - 1)]
    // NASM back-quoted strings use `` ` `` as the delimiter, so any
    // backtick inside the literal has to be escaped.
    let body = ""
    let i = 0
    while i < raw.length do
        if raw[i] == "`" then
            body = body + "\\`"
        else
            body = body + raw[i]
        i += 1
    m_rodata += [name + ": db `" + body + "`, 0\n"]
    return name

// A call target that isn't defined in this program is resolved at link
// time — record it so the header can `extern` it.
void X86Backend::recordExtern(sym: string)
    if isLocalFn(sym) then
        return
    if not (sym in m_externs) then
        m_externs += [sym]

// ── lifecycle ──────────────────────────────────────────────────────

void X86Backend::begin()
    m_lines = []

// name + frame size (bytes, already 16-aligned) + each parameter's
// frame offset.  `main` is entered by the C runtime with the C ABI;
// every other function receives  rsi = &(tag,value)[argc].
void X86Backend::beginFunction(name: string, frame: int, paramOffsets: [int], isMain: bool)
    if isMain then
        label("km_program_main")
    else
        label(name)
    ins("push rbp")
    ins("mov rbp, rsp")
    ins("push rbx")
    ins("sub rsp, " + string(frame))
    // Both the ordinary Komodo ABI and the C runtime's `main` shim pass
    // arguments as `rsi` → KmArg records, so load params the same way for
    // `main` (which may take `args`) as for everything else.
    let i = 0
    while i < #paramOffsets do
        ins("mov rax, [rsi + " + string(16 * i + 8) + "]")
        ins("mov [rbp - " + string(paramOffsets[i]) + "], rax")
        i += 1

void X86Backend::endFunction()
    ins("xor eax, eax")
    epilogue()
    emit("")

void X86Backend::epilogue()
    ins("lea rsp, [rbp - 8]")
    ins("pop rbx")
    ins("pop rbp")
    ins("ret")

// ── constants ──────────────────────────────────────────────────────

void X86Backend::loadIntLit(text: string)
    ins("mov rax, " + text)

void X86Backend::loadBoolLit(value: bool)
    if value then
        ins("mov rax, 1")
    else
        ins("mov rax, 0")

mut X86Backend::loadFloatLit(literal: string)
    let lbl = addDouble(literal)
    ins("movsd xmm0, [rel " + lbl + "]")

mut X86Backend::loadStrLit(literal: string)
    let lbl = addString(literal)
    ins("lea rax, [rel " + lbl + "]")

// ── locals ─────────────────────────────────────────────────────────

void X86Backend::loadLocal(off: int, ty: string)
    if ty == "float" then
        ins("movsd xmm0, [rbp - " + string(off) + "]")
    else
        ins("mov rax, [rbp - " + string(off) + "]")

void X86Backend::storeLocal(off: int, ty: string)
    if ty == "float" then
        ins("movsd [rbp - " + string(off) + "], xmm0")
    else
        ins("mov [rbp - " + string(off) + "], rax")

// ── top-level variables ───────────────────────────────────────────
// One 8-byte cell each in .bss (label `KG_<name>`), zero-initialised by
// the loader; the program's own initialiser code runs at the top of
// `main`.

void X86Backend::declareGlobal(name: string, ty: string)
    if not (name in m_globals) then
        m_globals += [name]

void X86Backend::loadGlobal(name: string, ty: string)
    if ty == "float" then
        ins("movsd xmm0, [rel KG_" + name + "]")
    else
        ins("mov rax, [rel KG_" + name + "]")

void X86Backend::storeGlobal(name: string, ty: string)
    if ty == "float" then
        ins("movsd [rel KG_" + name + "], xmm0")
    else
        ins("mov [rel KG_" + name + "], rax")

// ── operand-stack scratch ──────────────────────────────────────────

void X86Backend::pushAcc()
    ins("push rax")

void X86Backend::pushAccFloat()
    ins("sub rsp, 16")
    ins("movsd [rsp], xmm0")

// ── integer / bool ─────────────────────────────────────────────────

// left spilled by pushAcc(), right in rax.
void X86Backend::binaryInt(op: string)
    ins("mov rcx, rax")
    ins("pop rax")
    if op == "+" then
        ins("add rax, rcx")
    else if op == "-" then
        ins("sub rax, rcx")
    else if op == "*" then
        ins("imul rax, rcx")
    else if op == "/" then
        ins("cqo")
        ins("idiv rcx")
    else if op == "%" then
        ins("cqo")
        ins("idiv rcx")
        ins("mov rax, rdx")
    else if op == "&" then
        ins("and rax, rcx")
    else if op == "|" then
        ins("or rax, rcx")
    else if op == "^" or op == "xor" then
        ins("xor rax, rcx")
    else if op == "<<" then
        ins("shl rax, cl")
    else if op == ">>" then
        ins("sar rax, cl")

void X86Backend::compareInt(op: string)
    ins("mov rcx, rax")
    ins("pop rax")
    ins("cmp rax, rcx")
    ins(setInstr(op) + " al")
    ins("movzx eax, al")

fn X86Backend::setInstr(op: string): string
    if op == "==" then
        return "sete"
    if op == "!=" then
        return "setne"
    if op == "<" then
        return "setl"
    if op == ">" then
        return "setg"
    if op == "<=" then
        return "setle"
    return "setge"

void X86Backend::negInt()
    ins("neg rax")

void X86Backend::notBool()
    ins("cmp rax, 0")
    ins("sete al")
    ins("movzx eax, al")

// ── float ──────────────────────────────────────────────────────────

// left spilled by pushAccFloat(), right in xmm0.
void X86Backend::binaryFloat(op: string)
    ins("movsd xmm1, xmm0")
    ins("movsd xmm0, [rsp]")
    ins("add rsp, 16")
    if op == "+" then
        ins("addsd xmm0, xmm1")
    else if op == "-" then
        ins("subsd xmm0, xmm1")
    else if op == "*" then
        ins("mulsd xmm0, xmm1")
    else if op == "/" then
        ins("divsd xmm0, xmm1")
    else if op == "%" then
        // C `fmod(x, y)` — x in xmm0, y in xmm1 (already placed above).
        recordExtern("fmod")
        emitCall("fmod")

// `a <cmp> b` on floats — left spilled by pushAccFloat(), right in xmm0.
// `ucomisd` sets CF/ZF/PF; the setcc that follows reads them.  NaN
// (unordered ⇒ PF=1) is treated as "not equal / not less" — no NaN-safe
// special-casing.
void X86Backend::compareFloat(op: string)
    ins("movsd xmm1, xmm0")          // right
    ins("movsd xmm0, [rsp]")         // left
    ins("add rsp, 16")
    ins("ucomisd xmm0, xmm1")
    if op == "==" then
        ins("sete al")
    else if op == "!=" then
        ins("setne al")
    else if op == ">" then
        ins("seta al")
    else if op == ">=" then
        ins("setae al")
    else if op == "<" then
        ins("setb al")
    else
        ins("setbe al")
    ins("movzx eax, al")

void X86Backend::negFloat()
    ins("movsd xmm1, xmm0")
    ins("xorps xmm0, xmm0")
    ins("subsd xmm0, xmm1")

void X86Backend::cvtIntToFloat()
    ins("cvtsi2sd xmm0, rax")

void X86Backend::cvtFloatToInt()
    ins("cvttsd2si rax, xmm0")

void X86Backend::floatToBits()
    ins("movq rax, xmm0")

// The inverse: reinterpret the 64 bits in rax as a double in xmm0.  Used
// after a raw 8-byte read (array element, struct field) whose static type
// is `float`, to restore the "float lives in xmm0" convention.
void X86Backend::bitsToFloat()
    ins("movq xmm0, rax")

// ── strings ────────────────────────────────────────────────────────

// left spilled by pushAcc(), right in rax → rdi, rsi then runtime call.
mut X86Backend::strBinOp(helper: string)
    m_usesStr = true
    ins("mov rsi, rax")
    ins("pop rdi")
    emitCall(helper)

// `needle in haystack` for strings — haystack spilled, needle in rax.
mut X86Backend::strIn()
    ins("mov rsi, rax")
    ins("pop rdi")
    recordExtern("km_in_str")
    emitCall("km_in_str")

// `v in arr` — array handle spilled by pushAcc(), candidate in rax.
// `km_in_array(arr, v, leaf)` returns 1 / 0.  `leaf` is the element's
// scalar tag (2 = string ⇒ strcmp, else a raw 64-bit `==`).
mut X86Backend::arrayIn(leaf: int)
    ins("mov rsi, rax")
    ins("pop rdi")
    ins("mov rdx, " + string(leaf))
    recordExtern("km_in_array")
    emitCall("km_in_array")

mut X86Backend::strEquals(negate: bool)
    m_usesStr = true
    ins("mov rsi, rax")
    ins("pop rdi")
    emitCall("km_str_eq")
    if negate then
        ins("xor eax, 1")

// `s[i]` — index in rax, string pointer spilled → fresh 1-char string.
mut X86Backend::strIndexAcc()
    ins("mov rsi, rax")
    ins("pop rdi")
    recordExtern("km_str_char")
    emitCall("km_str_char")

// `s1 <op> s2` (`<` `>` `<=` `>=`) — right in rax, left spilled.
mut X86Backend::strCompare(op: string)
    ins("mov rsi, rax")
    ins("pop rdi")
    recordExtern("km_str_cmp")
    emitCall("km_str_cmp")
    ins("cmp rax, 0")
    ins(setInstr(op) + " al")
    ins("movzx eax, al")

mut X86Backend::strLen()
    m_usesStr = true
    ins("mov rdi, rax")
    emitCall("km_str_len")

// `s[a to b]` — object spilled first (deeper), start spilled next, end in
// rax.  → km_str_slice(s, start, end); fresh char* in rax.
mut X86Backend::sliceStr()
    ins("mov rdx, rax")
    ins("pop rsi")
    ins("pop rdi")
    recordExtern("km_str_slice")
    emitCall("km_str_slice")

// `arr[a to b]` — same operand layout → km_array_slice; fresh handle in rax.
mut X86Backend::sliceArray()
    ins("mov rdx, rax")
    ins("pop rsi")
    ins("pop rdi")
    recordExtern("km_array_slice")
    emitCall("km_array_slice")

// ── arrays ─────────────────────────────────────────────────────────

// object spilled by pushAcc(), index in rax.
void X86Backend::indexAcc()
    ins("mov rcx, rax")
    ins("pop rax")
    ins("mov rax, [rax + rcx*8 + 16]")

// `#arr` — the length field lives at offset 0 of the handle.
void X86Backend::arrayLenField()
    ins("mov rax, [rax]")

mut X86Backend::arrayBegin(n: int)
    m_usesMalloc = true
    ins("mov rdi, " + string(16 + 8 * n))
    emitCall("malloc")
    ins("mov qword [rax], " + string(n))
    ins("mov qword [rax + 8], " + string(n))
    ins("push rax")

void X86Backend::arrayStoreElem(i: int)
    ins("mov rdx, [rsp]")
    ins("mov [rdx + " + string(16 + 8 * i) + "], rax")

void X86Backend::arrayEnd()
    ins("pop rax")

// ── objects (structs + classes) ───────────────────────────────────
//
//  An object handle is a bare pointer to `fieldCount` contiguous 8-byte
//  slots — no header.  `new` mallocs and zeroes it and leaves the handle
//  pushed (like arrayBegin); `objFinishNew` pops it back as the result.

// An object handle points at  [ type_id | field0 | field1 | … ]  — one
// leading 8-byte word holding the integer type id (structs and classes
// both), so every field offset is shifted by 8.
mut X86Backend::objNew(typeId: int, nFields: int)
    m_usesMalloc = true
    // one extra word for the refcount, which sits just *before* the
    // handle — so the type-id word and every field offset are unchanged.
    let bytes = (nFields + 2) * 8
    ins("mov rdi, " + string(bytes))
    emitCall("malloc")
    ins("mov qword [rax], 1")               // refcount = 1
    ins("add rax, 8")                       // handle = block + 8
    ins("mov qword [rax], " + string(typeId))
    let k = 0
    while k < nFields do
        ins("mov qword [rax + " + string(8 + k * 8) + "], 0")
        k += 1
    ins("push rax")

// ── object / array lifetime (conservative auto-free) ──────────────
//
//  The compiler's escape analysis (codegen_stmt.kmm) hands each function
//  the frame offsets of its `let`-bound heap locals that provably never
//  escape — those are freed here, and only here.

void X86Backend::zeroFreeableSlots(offsets: [int])
    for off in offsets do
        ins("mov qword [rbp - " + string(off) + "], 0")

// Release every freeable local.  `preserveAcc` keeps the return value
// alive across the C calls (each `km_release` clobbers rax and every xmm);
// `accIsFloat` says whether it rides in xmm0 rather than rax.
mut X86Backend::emitScopeReleases(objOffsets: [int], arrOffsets: [int], preserveAcc: bool, accIsFloat: bool)
    if #objOffsets == 0 and #arrOffsets == 0 then
        return
    if preserveAcc then
        if accIsFloat then
            ins("sub rsp, 16")
            ins("movsd [rsp], xmm0")
        else
            ins("push rax")
    for off in objOffsets do
        ins("mov rdi, [rbp - " + string(off) + "]")
        recordExtern("km_release")
        emitCall("km_release")
    for off in arrOffsets do
        ins("mov rdi, [rbp - " + string(off) + "]")
        recordExtern("km_drop_array")
        emitCall("km_drop_array")
    if preserveAcc then
        if accIsFloat then
            ins("movsd xmm0, [rsp]")
            ins("add rsp, 16")
        else
            ins("pop rax")

// `v = <fresh>` for a freeable local: drop the value it held first.  The
// new value is already in rax.
mut X86Backend::releaseStoreLocal(off: int, isArray: bool)
    ins("push rax")
    ins("mov rdi, [rbp - " + string(off) + "]")
    if isArray then
        recordExtern("km_drop_array")
        emitCall("km_drop_array")
    else
        recordExtern("km_release")
        emitCall("km_release")
    ins("pop rax")
    ins("mov [rbp - " + string(off) + "], rax")

// value in rax, handle at [rsp] (positional field init for `new`)
void X86Backend::objSetField(idx: int)
    ins("mov rdx, [rsp]")
    ins("mov [rdx + " + string(8 + idx * 8) + "], rax")

// handle in rax → its integer type id in rax
void X86Backend::objTypeId()
    ins("mov rax, [rax]")

// handle in rax → rax = 1 if its header type id is one of `ids`, else 0.
// A null handle (rax == 0) is never a match.
mut X86Backend::isTypeCheck(ids: [int])
    let falseL = newLabel()
    let endL = newLabel()
    ins("test rax, rax")
    ins("jz " + falseL)
    ins("mov rax, [rax]")
    ins("xor ecx, ecx")
    for id in ids do
        ins("cmp rax, " + string(id))
        ins("mov edx, 0")
        ins("sete dl")
        ins("or rcx, rdx")
    ins("mov rax, rcx")
    ins("jmp " + endL)
    label(falseL)
    ins("xor eax, eax")
    label(endL)

// constructor frame: slot 0 ← the pushed handle (at [rsp + total*16])
void X86Backend::objInitArg0(total: int)
    ins("mov rax, [rsp + " + string(total * 16) + "]")
    ins("mov qword [rsp], 0")
    ins("mov [rsp + 8], rax")

void X86Backend::objFinishNew()
    ins("pop rax")

// handle in rax → field value in rax
void X86Backend::loadField(idx: int)
    ins("mov rax, [rax + " + string(8 + idx * 8) + "]")

// value in rax, handle spilled by pushAcc()
void X86Backend::storeField(idx: int)
    ins("mov rcx, rax")
    ins("pop rax")
    ins("mov [rax + " + string(8 + idx * 8) + "], rcx")

// `arr[i] = v` — value in rax, index spilled, handle spilled below it
void X86Backend::indexAssign()
    ins("mov rcx, rax")
    ins("pop rax")
    ins("pop rdx")
    ins("mov [rdx + rax*8 + 16], rcx")

// `dst += src` — value in rax, dst at [rbp - off].
mut X86Backend::arrayAppendTo(off: int)
    m_usesAppend = true
    ins("mov rsi, rax")
    ins("mov rdi, [rbp - " + string(off) + "]")
    emitCall("km_array_grow")
    ins("mov [rbp - " + string(off) + "], rax")

// `string(x)` — value in rax, `tag` a compile-time constant
// (0 int / 1 float-bits / 2 string / 3 bool).  → km_to_string(tag, value).
mut X86Backend::toStringOf(tag: int)
    ins("mov rsi, rax")
    ins("mov rdi, " + string(tag))
    recordExtern("km_to_string")
    emitCall("km_to_string")

// `a + b` for arrays / `dst[i] += src` — right operand in rax, left
// spilled by pushAcc().  Copying (left may be aliased).
mut X86Backend::arrayAppendAcc()
    m_usesAppend = true
    ins("mov rsi, rax")
    ins("pop rdi")
    emitCall("km_array_append")

// `g += elem` for an array global — array in rax, the element spilled by
// pushAcc().  → km_array_grow(array, elem); new handle left in rax.
mut X86Backend::arrayGrowAcc()
    m_usesAppend = true
    ins("mov rdi, rax")
    ins("pop rsi")
    emitCall("km_array_grow")

// `arr * n` — count in rax, array spilled by pushAcc().
mut X86Backend::arrayRepeat()
    ins("mov rsi, rax")
    ins("pop rdi")
    recordExtern("km_array_repeat")
    emitCall("km_array_repeat")

// `self.field += src` (array append) — src in rax, receiver spilled by
// pushAcc().  self.field = km_array_append(self.field, src).
mut X86Backend::arrayAppendToField(idx: int)
    m_usesAppend = true
    ins("mov rsi, rax")
    ins("pop rax")
    ins("mov rdi, [rax + " + string(8 + idx * 8) + "]")
    ins("push rax")
    emitCall("km_array_grow")
    ins("pop rcx")
    ins("mov [rcx + " + string(8 + idx * 8) + "], rax")

// `dst -= src` — value in rax, dst at [rbp - off].
void X86Backend::subFromLocal(off: int)
    ins("mov rcx, rax")
    ins("mov rax, [rbp - " + string(off) + "]")
    ins("sub rax, rcx")
    ins("mov [rbp - " + string(off) + "], rax")

// ── control flow ───────────────────────────────────────────────────

void X86Backend::jump(name: string)
    ins("jmp " + name)

void X86Backend::branchIfZero(name: string)
    ins("test rax, rax")
    ins("je " + name)

void X86Backend::branchIfNonzero(name: string)
    ins("test rax, rax")
    ins("jne " + name)

// `and` / `or` short-circuit: `test` already leaves the value in rax, so
// the "keep" forms are identical to the plain ones on x86.
void X86Backend::branchIfZeroKeep(name: string)
    branchIfZero(name)

void X86Backend::branchIfNonzeroKeep(name: string)
    branchIfNonzero(name)

// loop-variable in rax spilled by pushAcc(), bound in rax; exit when the
// loop is already past the bound.
void X86Backend::forCompareExit(endL: string, descending: bool, inclusive: bool)
    ins("mov rcx, rax")
    ins("pop rax")
    ins("cmp rax, rcx")
    if descending then
        if inclusive then
            ins("jl " + endL)
        else
            ins("jle " + endL)
    else
        if inclusive then
            ins("jg " + endL)
        else
            ins("jge " + endL)

void X86Backend::stepLocal(off: int, desc: bool)
    ins("mov rax, [rbp - " + string(off) + "]")
    if desc then
        ins("dec rax")
    else
        ins("inc rax")
    ins("mov [rbp - " + string(off) + "], rax")

// `for x in arr` — iterable handle in rax; vi = cursor, va = handle copy.
void X86Backend::forInInit(viOff: int, vaOff: int)
    ins("mov [rbp - " + string(vaOff) + "], rax")
    ins("xor eax, eax")
    ins("mov [rbp - " + string(viOff) + "], rax")

void X86Backend::forInHead(viOff: int, vaOff: int, endL: string)
    ins("mov rax, [rbp - " + string(viOff) + "]")
    ins("mov rdx, [rbp - " + string(vaOff) + "]")
    ins("cmp rax, [rdx]")
    ins("jge " + endL)

// rax = cursor, rdx = handle (left by forInHead).
void X86Backend::forInElem(xOff: int)
    ins("mov rcx, rax")
    ins("mov rax, [rdx + rcx*8 + 16]")
    ins("mov [rbp - " + string(xOff) + "], rax")

void X86Backend::forInStep(viOff: int)
    ins("mov rax, [rbp - " + string(viOff) + "]")
    ins("inc rax")
    ins("mov [rbp - " + string(viOff) + "], rax")

// ── calls ──────────────────────────────────────────────────────────
//
//  Uniform ABI: build an argc-long (tag, value)[] on the stack, pass
//  rdi = argc, rsi = &pairs.  `print`, `algorithm.sort`, … are ordinary
//  calls whose symbol is resolved from the C runtime at link time.

mut X86Backend::call0(name: string)
    let sym = mangle(name)
    recordExtern(sym)
    ins("xor edi, edi")
    ins("xor esi, esi")
    emitCall(sym)

void X86Backend::callFrameBegin(n: int)
    ins("sub rsp, " + string(n * 16))

void X86Backend::callArgTag(j: int, tag: int)
    ins("mov qword [rsp + " + string(j * 16) + "], " + string(tag))

void X86Backend::callArgStore(j: int)
    ins("mov [rsp + " + string(j * 16 + 8) + "], rax")

mut X86Backend::callFrameEnd(name: string, n: int)
    let sym = mangle(name)
    recordExtern(sym)
    ins("mov rdi, " + string(n))
    ins("mov rsi, rsp")
    emitCall(sym)
    ins("add rsp, " + string(n * 16))

// ── overload dispatch ─────────────────────────────────────────────
//
//  The (tag,value)[] frame is already built at [rsp].  For each candidate
//  overload, `dispatchTest*` compare argument tags / header type ids and
//  `jne` to that case's skip label; on a full match `dispatchCall` calls
//  the overload and jumps to the shared exit.  No runtime match ⇒
//  `abort`.

mut X86Backend::dispatchBegin()
    m_dispEnd = newLabel()

mut X86Backend::dispatchCaseBegin()
    m_dispNext = newLabel()

// arg `j`'s tag word must equal `tag`.
void X86Backend::dispatchTestTag(j: int, tag: int)
    ins("cmp qword [rsp + " + string(j * 16) + "], " + string(tag))
    ins("jne " + m_dispNext)

// arg `j` must be a non-null object handle whose header type id is one
// of `ids`.
mut X86Backend::dispatchTestType(j: int, ids: [int])
    ins("mov rax, [rsp + " + string(j * 16 + 8) + "]")
    ins("test rax, rax")
    ins("jz " + m_dispNext)
    ins("mov rax, [rax]")
    let okL = newLabel()
    for id in ids do
        ins("cmp rax, " + string(id))
        ins("je " + okL)
    ins("jmp " + m_dispNext)
    label(okL)

mut X86Backend::dispatchCall(sym: string, n: int)
    let s = mangle(sym)
    recordExtern(s)
    ins("mov rdi, " + string(n))
    ins("mov rsi, rsp")
    emitCall(s)
    ins("jmp " + m_dispEnd)

void X86Backend::dispatchCaseEnd()
    label(m_dispNext)

mut X86Backend::dispatchEnd(n: int)
    recordExtern("abort")
    emitCall("abort")
    label(m_dispEnd)
    ins("add rsp, " + string(n * 16))

// Virtual dispatch: the (tag,value)[] frame is already built (arg 0 = the
// receiver handle).  Look the method up through  __km_vtab[type_id][slot].
mut X86Backend::vcall(slot: int, n: int)
    ins("mov rdi, " + string(n))
    ins("mov rsi, rsp")
    ins("mov rcx, [rsp + 8]")
    ins("mov rcx, [rcx]")
    ins("lea rdx, [__km_vtab]")
    ins("mov rdx, [rdx + rcx*8]")
    ins("mov rax, [rdx + " + string(slot * 8) + "]")
    ins("mov rbx, rsp")
    ins("and rsp, -16")
    ins("call rax")
    ins("mov rsp, rbx")
    ins("add rsp, " + string(n * 16))

// ── vtables ────────────────────────────────────────────────────────

void X86Backend::beginVtables(nTypes: int)
    m_vtabCount = nTypes

mut X86Backend::setVtable(typeId: int, labels: [string])
    let line = "__vt_" + string(typeId) + ": dq "
    let i = 0
    while i < #labels do
        if i > 0 then
            line = line + ", "
        line = line + labels[i]
        i += 1
    m_vtblText += [line + "\n"]
    m_vtabSet += [typeId]

// ── C FFI (`extern fn`) — full System V AMD64 call ─────────────────
//
//  Every argument is evaluated left-to-right and spilled to a scratch
//  block with `push` (8 bytes each, ints and floats alike) so a nested
//  call in a later argument can't clobber it.  `cCallEnd` then, from the
//  recorded per-argument class list:
//
//    • loads the first 6 integer/pointer args into rdi rsi rdx rcx r8 r9
//    • loads the first 8 float args into xmm0..7
//    • copies any further args to a fresh 16-aligned block at [rsp+k*8]
//    • sets al = number of xmm regs used (the vararg convention)
//
//  rbx holds the scratch base across the call (no nested emitCall runs
//  between the spills and here), so one `mov rsp, rbx` unwinds both the
//  aligned outgoing block and the scratch.
//
//  Scratch layout after n pushes:  arg i sits at [rsp + (n-1-i)*8].

void X86Backend::cCallBegin(n: int)
    return

void X86Backend::cCallArg(i: int, cls: string)
    if cls == "f32" then
        // a 32-bit C `float` argument: narrow the double now, then spill
        // it like any other SSE word (only the low 32 bits are read).
        ins("cvtsd2ss xmm0, xmm0")
        ins("sub rsp, 8")
        ins("movsd [rsp], xmm0")
    else if cls == "float" then
        ins("sub rsp, 8")
        ins("movsd [rsp], xmm0")
    else
        ins("push rax")

mut X86Backend::cCallEnd(name: string, classes: [string])
    let n = #classes
    // `$`-prefix so NASM always reads it as an identifier, never as one
    // of its own reserved words (`abs`, `rel`, `seg`, …).
    let sym = "$" + name
    recordExtern(sym)

    let gpRegs = ["rdi", "rsi", "rdx", "rcx", "r8", "r9"]
    let xmmRegs = ["xmm0", "xmm1", "xmm2", "xmm3", "xmm4", "xmm5", "xmm6", "xmm7"]
    let gp = 0
    let xmm = 0

    // scratch base — arg i is at [rbx + (n-1-i)*8] from here on.
    ins("mov rbx, rsp")

    // Pass 1: register args, straight from the scratch block.
    let stackArgs: [int] = []
    let i = 0
    while i < n do
        let cls = classes[i]
        let src = "[rbx + " + string((n - 1 - i) * 8) + "]"
        if cls == "float" or cls == "f32" then
            if xmm < 8 then
                ins("movsd " + xmmRegs[xmm] + ", " + src)
                xmm += 1
            else
                stackArgs += [i]
        else if cls == "mem" then
            // a MEMORY-class aggregate word: always in the stack area
            stackArgs += [i]
        else
            if gp < 6 then
                ins("mov " + gpRegs[gp] + ", " + src)
                gp += 1
            else
                stackArgs += [i]
        i += 1

    // Pass 2: overflow args → a fresh 16-aligned outgoing block.
    let ns = #stackArgs
    ins("and rsp, -16")
    if ns % 2 != 0 then
        ins("sub rsp, 8")
    if ns > 0 then
        ins("sub rsp, " + string(ns * 8))
        let k = 0
        while k < ns do
            ins("mov rax, [rbx + " + string((n - 1 - stackArgs[k]) * 8) + "]")
            ins("mov [rsp + " + string(k * 8) + "], rax")
            k += 1

    // al = number of vector registers used (harmless for non-variadic).
    ins("mov eax, " + string(xmm))
    ins("call " + sym)
    // Unwind the outgoing block and the scratch in one move.
    ins("mov rsp, rbx")
    ins("add rsp, " + string(n * 8))

// ── by-value struct marshalling for `extern` calls ────────────────
//
//  `km_ffi_marshal` is a 32-byte static scratch (two eightbytes plus
//  slack).  `ffiStructMarshal` repacks a Komodo struct — every field in
//  its own 8-byte slot — into the tight C layout there; `ffiStructLoadWord`
//  then hands one eightbyte to `cCallArg` like any scalar.  Argument
//  structs are marshalled one at a time and their eightbytes pushed onto
//  the scratch block before the next argument, so a single buffer is
//  enough.  `ffiStructRet` runs the reverse: it stashes the return
//  registers, allocates a Komodo object and widens each C field back into
//  its slot.

mut X86Backend::ffiStructMarshal(totalSize: int, slots: [int], coffs: [int], sizes: [int], flts: [int])
    m_usesFfiStruct = true
    ins("mov r10, rax")                      // r10 = Komodo struct handle
    ins("xor rcx, rcx")                      // clear the destination bytes
    let z = 0
    while z < totalSize do
        ins("mov [km_ffi_marshal + " + string(z) + "], rcx")
        z += 8
    let i = 0
    while i < #slots do
        let src = "[r10 + " + string(8 + slots[i] * 8) + "]"
        let dst = "km_ffi_marshal + " + string(coffs[i])
        if flts[i] == 1 then
            ins("movsd xmm0, " + src)
            if sizes[i] == 4 then
                ins("cvtsd2ss xmm0, xmm0")
                ins("movss [" + dst + "], xmm0")
            else
                ins("movsd [" + dst + "], xmm0")
        else
            ins("mov rcx, " + src)
            if sizes[i] == 1 then
                ins("mov [" + dst + "], cl")
            else if sizes[i] == 2 then
                ins("mov [" + dst + "], cx")
            else if sizes[i] == 4 then
                ins("mov [" + dst + "], ecx")
            else
                ins("mov [" + dst + "], rcx")
        i += 1

// Widen a 32-bit C `float` result (in xmm0) to a 64-bit double.
void X86Backend::cvtF32ToDouble()
    ins("cvtss2sd xmm0, xmm0")

void X86Backend::ffiStructLoadWord(off: int, cls: string)
    if cls == "float" then
        ins("movsd xmm0, [km_ffi_marshal + " + string(off) + "]")
    else
        ins("mov rax, [km_ffi_marshal + " + string(off) + "]")

mut X86Backend::ffiStructRet(typeId: int, nFields: int, slots: [int], coffs: [int], sizes: [int], flts: [int], usig: [int], ebClasses: [string])
    m_usesFfiStruct = true
    // Stash the return registers before malloc clobbers them.  Eightbytes
    // are consumed in order; INTEGER ones use rax then rdx, SSE ones
    // xmm0 then xmm1.
    let gpRet = 0
    let sseRet = 0
    let e = 0
    while e < #ebClasses do
        let slot = "km_ffi_marshal + " + string(e * 8)
        if ebClasses[e] == "int" then
            if gpRet == 0 then
                ins("mov [" + slot + "], rax")
            else
                ins("mov [" + slot + "], rdx")
            gpRet += 1
        else
            if sseRet == 0 then
                ins("movsd [" + slot + "], xmm0")
            else
                ins("movsd [" + slot + "], xmm1")
            sseRet += 1
        e += 1

    objNew(typeId, nFields)                  // fresh zeroed object, handle pushed
    ins("pop rax")                           // rax = handle

    let i = 0
    while i < #slots do
        let dst = "[rax + " + string(8 + slots[i] * 8) + "]"
        let bsrc = "km_ffi_marshal + " + string(coffs[i])
        if flts[i] == 1 then
            if sizes[i] == 4 then
                ins("movss xmm0, [" + bsrc + "]")
                ins("cvtss2sd xmm0, xmm0")
            else
                ins("movsd xmm0, [" + bsrc + "]")
            ins("movsd " + dst + ", xmm0")
        else
            if sizes[i] == 1 then
                if usig[i] == 1 then
                    ins("movzx rcx, byte [" + bsrc + "]")
                else
                    ins("movsx rcx, byte [" + bsrc + "]")
            else if sizes[i] == 2 then
                if usig[i] == 1 then
                    ins("movzx rcx, word [" + bsrc + "]")
                else
                    ins("movsx rcx, word [" + bsrc + "]")
            else if sizes[i] == 4 then
                if usig[i] == 1 then
                    ins("mov ecx, [" + bsrc + "]")
                else
                    ins("movsxd rcx, dword [" + bsrc + "]")
            else
                ins("mov rcx, [" + bsrc + "]")
        if flts[i] != 1 then
            ins("mov " + dst + ", rcx")
        i += 1

// `data(arr)` — element pointer of an array handle (skip len/cap).
void X86Backend::arrayDataPtr()
    ins("add rax, 16")

// ── C callbacks ───────────────────────────────────────────────────
//
//  A Komodo function passed to C rides in as `&km_tramp_<sym>`.  The
//  trampoline is a native System V AMD64 entry point that repackages its
//  integer-register arguments as the Komodo call ABI (rdi = argc,
//  rsi = &KmArg[argc]; each KmArg is {tag, value}, tag 0 = int) and tail-
//  logically calls the real function, whose result is already in rax.
//  Integer/pointer arguments only, up to 6 — the analyser enforces it.

void X86Backend::loadFnPtr(sym: string)
    ins("lea rax, [rel km_tramp_" + sym + "]")

mut X86Backend::emitTrampoline(sym: string, argc: int)
    let n = argc
    if n < 0 then
        n = 0
    if n > 6 then
        n = 6
    label("km_tramp_" + sym)
    ins("push rbp")
    ins("mov rbp, rsp")
    if n > 0 then
        // n * 16 keeps rsp 16-aligned for the call below
        ins("sub rsp, " + string(n * 16))
    let regs = ["rdi", "rsi", "rdx", "rcx", "r8", "r9"]
    let i = 0
    while i < n do
        ins("mov qword [rsp + " + string(i * 16) + "], 0")
        ins("mov [rsp + " + string(i * 16 + 8) + "], " + regs[i])
        i += 1
    ins("mov rdi, " + string(n))
    ins("mov rsi, rsp")
    ins("call " + sym)
    ins("mov rsp, rbp")
    ins("pop rbp")
    ins("ret")
    emit("")

// ── error handling ────────────────────────────────────────────────
//
//  `throw msg` — the message pointer is in rax.  `km_throw` never
//  returns: it _longjmps to the innermost protected call site, or prints
//  the message and exits when there is none.
mut X86Backend::throwErr()
    ins("mov rdi, rax")
    recordExtern("km_throw")
    emitCall("km_throw")

//  `f(args)?` brackets — `tryBegin` reserves a jmp_buf on the stack
//  (glibc's is 200 bytes; 256 keeps 16-alignment parity), registers it
//  with the runtime and arms it with `_setjmp`.  The guarded call is
//  emitted by the caller between the two.  `_longjmp` restores rsp and
//  rbx to their `_setjmp`-time values, so emitCall's trailing
//  `mov rsp, rbx` still runs correctly on the caught return.
mut X86Backend::tryBegin()
    let catchL = newLabel()
    let doneL = newLabel()
    m_tryCatch += [catchL]
    m_tryDone += [doneL]
    ins("sub rsp, 256")
    ins("lea rdi, [rsp]")
    recordExtern("km_try_push")
    emitCall("km_try_push")
    ins("lea rdi, [rsp]")
    recordExtern("_setjmp")
    emitCall("_setjmp")
    ins("test eax, eax")
    ins("jnz " + catchL)

mut X86Backend::tryEnd()
    let catchL = m_tryCatch[#m_tryCatch - 1]
    let doneL = m_tryDone[#m_tryDone - 1]
    m_tryCatch = m_tryCatch[0 to (#m_tryCatch - 1)]
    m_tryDone = m_tryDone[0 to (#m_tryDone - 1)]
    // normal path: pop the landing pad, preserving the call's result
    // (km_try_pop is a C call and would otherwise clobber rax)
    ins("push rax")
    recordExtern("km_try_pop")
    emitCall("km_try_pop")
    ins("pop rax")
    ins("jmp " + doneL)
    // caught path: km_throw already popped the pad; yield null
    label(catchL)
    ins("xor eax, eax")
    label(doneL)
    ins("add rsp, 256")

// ── final assembly ─────────────────────────────────────────────────

mut X86Backend::finish(): string
    return header() + join(m_lines, "\n") + "\n" + footer()

mut X86Backend::header(): string
    let h = "; generated by the Komodo compiler — NASM x86-64\n"
    h = h + "default rel\n\n"
    // The C runtime provides `main` (it marshals argv into a Komodo
    // string array); the program's own entry point is `km_program_main`.
    h = h + "global km_program_main\n\n"
    if m_usesMalloc then
        h = h + "extern malloc\n"
    if m_usesAppend then
        h = h + "extern km_array_append\n"
        h = h + "extern km_array_grow\n"
    if m_usesStr then
        h = h + "extern km_str_concat\n"
        h = h + "extern km_str_repeat\n"
        h = h + "extern km_str_len\n"
        h = h + "extern km_str_eq\n"
        h = h + "extern km_str_join\n"
    let i = 0
    while i < #m_externs do
        h = h + "extern " + m_externs[i] + "\n"
        i += 1
    h = h + "\nsection .text\n\n"
    return h

fn X86Backend::footer(): string
    let r = ""
    if #m_globals > 0 or m_usesFfiStruct then
        r = r + "\nsection .bss\n"
        let gi = 0
        while gi < #m_globals do
            r = r + "KG_" + m_globals[gi] + ": resq 1\n"
            gi += 1
        if m_usesFfiStruct then
            r = r + "align 16\nkm_ffi_marshal: resb 256\n"
    r = r + "\nsection .rodata\n" + join(m_rodata, "")
    if m_vtabCount > 0 then
        r = r + join(m_vtblText, "")
        r = r + "__km_vtab: dq "
        let i = 0
        while i < m_vtabCount do
            if i > 0 then
                r = r + ", "
            if i in m_vtabSet then
                r = r + "__vt_" + string(i)
            else
                r = r + "0"
            i += 1
        r = r + "\n"
    return r + "\nsection .note.GNU-stack noalloc noexec nowrite progbits\n"
