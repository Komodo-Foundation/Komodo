module km_compiler

// ═══════════════════════════════════════════════════════════════════════
//  StackVMBackend — a second target, to keep the Backend seam honest.
//
//  Emits a flat, human-readable bytecode listing for a hypothetical
//  stack machine (no registers): every value lives on an operand stack,
//  locals are addressed by their frame byte-offset, control flow is
//  label + JMP / JZ / JNZ.  Nothing here assembles or runs yet — the
//  point is that a target with a completely different shape from x86
//  drops in by implementing the same operation names, with no change to
//  the lexer, parser, AST, frame layout, type inference or AST walk.
//
//  Because the machine is already a stack, the walker's explicit spill
//  points (`pushAcc` / `pushAccFloat`) and the call-buffer protocol
//  (`callFrameBegin` / `callArgTag` / `callArgStore`) emit nothing —
//  operands are simply left on the stack in evaluation order.
// ═══════════════════════════════════════════════════════════════════════

class StackVMBackend : Backend
private
    m_text: string = ""
    m_forInVi: int = 0     // frame offsets of the current for-in loop's
    m_forInVa: int = 0     // hidden cursor / handle locals
    m_dispEnd: string = ""  // overload dispatch: shared exit label
    m_dispNext: string = "" // overload dispatch: current case's skip label
    m_tryCatch: [string] = []  // protected-call: catch labels (nesting stack)
    m_tryDone: [string] = []   // protected-call: done labels (nesting stack)

// ── line buffer ────────────────────────────────────────────────────

void StackVMBackend::emit(line: string)
    m_text = m_text + line + "\n"

void StackVMBackend::op(text: string)
    emit("    " + text)

// ── lifecycle ──────────────────────────────────────────────────────

void StackVMBackend::begin()
    m_text = "; generated by the Komodo compiler — stack-VM bytecode\n\n"

mut StackVMBackend::finish(): string
    return m_text

void StackVMBackend::beginFunction(name: string, frame: int, paramOffsets: [int], isMain: bool)
    emit("FUNC " + name + " frame=" + string(frame) + " params=" + string(#paramOffsets))
    if not isMain then
        // Arguments arrive on the operand stack, last on top.
        let i = #paramOffsets - 1
        while i >= 0 do
            op("STL " + string(paramOffsets[i]))
            i -= 1

void StackVMBackend::endFunction()
    op("PUSHI 0")
    op("RET")
    emit("ENDFUNC")
    emit("")

void StackVMBackend::epilogue()
    op("RET")

// ── constants ──────────────────────────────────────────────────────

void StackVMBackend::loadIntLit(text: string)
    op("PUSHI " + text)

void StackVMBackend::loadBoolLit(value: bool)
    if value then
        op("PUSHI 1")
    else
        op("PUSHI 0")

void StackVMBackend::loadFloatLit(literal: string)
    op("PUSHF " + literal)

void StackVMBackend::loadStrLit(literal: string)
    op("PUSHS " + literal)

// ── locals ─────────────────────────────────────────────────────────

void StackVMBackend::loadLocal(off: int, ty: string)
    op("LDL " + string(off))

void StackVMBackend::storeLocal(off: int, ty: string)
    op("STL " + string(off))

// ── top-level variables (named global cells) ──────────────────────

void StackVMBackend::declareGlobal(name: string, ty: string)
    emit("GLOBAL " + name)

void StackVMBackend::loadGlobal(name: string, ty: string)
    op("LDG " + name)

void StackVMBackend::storeGlobal(name: string, ty: string)
    op("STG " + name)

// ── operand-stack scratch — the machine is already a stack ──────────

void StackVMBackend::pushAcc()
    return

void StackVMBackend::pushAccFloat()
    return

// ── integer / bool ─────────────────────────────────────────────────

void StackVMBackend::binaryInt(op_: string)
    if op_ == "+" then
        op("ADD")
    else if op_ == "-" then
        op("SUB")
    else if op_ == "*" then
        op("MUL")
    else if op_ == "/" then
        op("DIV")
    else if op_ == "%" then
        op("MOD")
    else if op_ == "&" then
        op("AND")
    else if op_ == "|" then
        op("OR")
    else if op_ == "^" or op_ == "xor" then
        op("XOR")
    else if op_ == "<<" then
        op("SHL")
    else if op_ == ">>" then
        op("SHR")

void StackVMBackend::compareInt(op_: string)
    if op_ == "==" then
        op("EQ")
    else if op_ == "!=" then
        op("NE")
    else if op_ == "<" then
        op("LT")
    else if op_ == ">" then
        op("GT")
    else if op_ == "<=" then
        op("LE")
    else
        op("GE")

void StackVMBackend::negInt()
    op("NEG")

void StackVMBackend::notBool()
    op("NOT")

// ── float ──────────────────────────────────────────────────────────

void StackVMBackend::binaryFloat(op_: string)
    if op_ == "+" then
        op("FADD")
    else if op_ == "-" then
        op("FSUB")
    else if op_ == "*" then
        op("FMUL")
    else if op_ == "/" then
        op("FDIV")
    else if op_ == "%" then
        op("FMOD")

void StackVMBackend::compareFloat(op_: string)
    if op_ == "==" then
        op("FEQ")
    else if op_ == "!=" then
        op("FNE")
    else if op_ == "<" then
        op("FLT")
    else if op_ == ">" then
        op("FGT")
    else if op_ == "<=" then
        op("FLE")
    else
        op("FGE")

void StackVMBackend::negFloat()
    op("FNEG")

void StackVMBackend::cvtIntToFloat()
    op("I2F")

void StackVMBackend::cvtFloatToInt()
    op("F2I")

void StackVMBackend::floatToBits()
    return

void StackVMBackend::bitsToFloat()
    return

// ── strings ────────────────────────────────────────────────────────

void StackVMBackend::strBinOp(helper: string)
    if helper == "km_str_repeat" then
        op("SREPEAT")
    else
        op("SCONCAT")

void StackVMBackend::strEquals(negate: bool)
    op("SEQ")
    if negate then
        op("NOT")

void StackVMBackend::strIndexAcc()
    op("SIDX")

void StackVMBackend::strCompare(op_: string)
    op("SCMP " + op_)

void StackVMBackend::strLen()
    op("SLEN")

// ── arrays ─────────────────────────────────────────────────────────

void StackVMBackend::indexAcc()
    op("AGET")

void StackVMBackend::arrayLenField()
    op("ALEN")

void StackVMBackend::arrayBegin(n: int)
    op("NEWARR " + string(n))

void StackVMBackend::arrayStoreElem(i: int)
    op("ASET " + string(i))

void StackVMBackend::arrayEnd()
    return

void StackVMBackend::arrayAppendTo(off: int)
    op("AAPPEND " + string(off))

void StackVMBackend::arrayAppendToField(idx: int)
    op("AAPPENDF " + string(idx))

void StackVMBackend::arrayAppendAcc()
    op("AAPPENDX")

void StackVMBackend::arrayGrowAcc()
    op("AGROWX")

void StackVMBackend::arrayRepeat()
    op("AREPEATX")

void StackVMBackend::toStringOf(tag: int)
    op("TOSTR " + string(tag))

void StackVMBackend::subFromLocal(off: int)
    op("DECV " + string(off))

// ── control flow ───────────────────────────────────────────────────

void StackVMBackend::label(name: string)
    emit(name + ":")

void StackVMBackend::jump(name: string)
    op("JMP " + name)

void StackVMBackend::branchIfZero(name: string)
    op("JZ " + name)

void StackVMBackend::branchIfNonzero(name: string)
    op("JNZ " + name)

// The short-circuit forms keep the tested value on the stack.
void StackVMBackend::branchIfZeroKeep(name: string)
    op("DUP")
    op("JZ " + name)

void StackVMBackend::branchIfNonzeroKeep(name: string)
    op("DUP")
    op("JNZ " + name)

// stack: [loopvar, bound]  → exit once the loop is past the bound.
void StackVMBackend::forCompareExit(endL: string, descending: bool, inclusive: bool)
    if descending then
        if inclusive then
            op("LT")
        else
            op("LE")
    else
        if inclusive then
            op("GT")
        else
            op("GE")
    op("JNZ " + endL)

void StackVMBackend::stepLocal(off: int, desc: bool)
    if desc then
        op("DEC " + string(off))
    else
        op("INC " + string(off))

void StackVMBackend::forInInit(viOff: int, vaOff: int)
    op("STL " + string(vaOff))
    op("PUSHI 0")
    op("STL " + string(viOff))

void StackVMBackend::forInHead(viOff: int, vaOff: int, endL: string)
    m_forInVi = viOff
    m_forInVa = vaOff
    op("LDL " + string(viOff))
    op("LDL " + string(vaOff))
    op("ALEN")
    op("GE")
    op("JNZ " + endL)

void StackVMBackend::forInElem(xOff: int)
    op("LDL " + string(m_forInVa))
    op("LDL " + string(m_forInVi))
    op("AGET")
    op("STL " + string(xOff))

void StackVMBackend::forInStep(viOff: int)
    op("INC " + string(viOff))

// ── calls — operands are already stacked in argument order ──────────

void StackVMBackend::call0(name: string)
    op("CALL " + mangle(name) + " 0")

void StackVMBackend::callFrameBegin(n: int)
    return

void StackVMBackend::callArgTag(j: int, tag: int)
    return

void StackVMBackend::callArgStore(j: int)
    return

void StackVMBackend::callFrameEnd(name: string, n: int)
    op("CALL " + mangle(name) + " " + string(n))

// ── overload dispatch ─────────────────────────────────────────────
//  The argument buffer is already built.  Each candidate tests argument
//  tags / type ids and skips to its `next` label on a mismatch; a full
//  match CALLs the overload and jumps to the shared exit.

mut StackVMBackend::dispatchBegin()
    m_dispEnd = newLabel()

mut StackVMBackend::dispatchCaseBegin()
    m_dispNext = newLabel()

void StackVMBackend::dispatchTestTag(j: int, tag: int)
    op("DTAG " + string(j) + " " + string(tag) + " " + m_dispNext)

mut StackVMBackend::dispatchTestType(j: int, ids: [int])
    let s = "DTYPE " + string(j) + " " + m_dispNext
    for id in ids do
        s = s + " " + string(id)
    op(s)

void StackVMBackend::dispatchCall(sym: string, n: int)
    op("CALL " + mangle(sym) + " " + string(n))
    op("JMP " + m_dispEnd)

void StackVMBackend::dispatchCaseEnd()
    emit(m_dispNext + ":")

mut StackVMBackend::dispatchEnd(n: int)
    op("ABORT")
    emit(m_dispEnd + ":")

// C FFI — operands are already stacked in argument order; a distinct
// opcode marks it as a native C call rather than a Komodo one.
void StackVMBackend::cCallBegin(n: int)
    return

void StackVMBackend::cCallArg(i: int, cls: string)
    return

void StackVMBackend::cCallEnd(name: string, classes: [string])
    op("CCALL " + name + " " + string(#classes))

// Passing / returning a C struct by value needs the native register file;
// the stack-VM has no C ABI to model it against.
void StackVMBackend::ffiStructMarshal(totalSize: int, slots: [int], coffs: [int], sizes: [int], flts: [int])
    throw "by-value struct arguments (copy(x) to an extern fn) require the x86 backend"

void StackVMBackend::ffiStructLoadWord(off: int, cls: string)
    throw "by-value struct arguments (copy(x) to an extern fn) require the x86 backend"

void StackVMBackend::cvtF32ToDouble()
    return

void StackVMBackend::ffiStructRet(typeId: int, nFields: int, slots: [int], coffs: [int], sizes: [int], flts: [int], usig: [int], ebClasses: [string])
    throw "by-value struct return from an extern fn requires the x86 backend"

void StackVMBackend::arrayDataPtr()
    op("ADATA")

// `needle in haystack` (strings) — both on the stack.
void StackVMBackend::strIn()
    op("SIN")

// `v in arr` — arr and candidate on the stack; leaf tag as an operand.
void StackVMBackend::arrayIn(leaf: int)
    op("AIN " + string(leaf))

// C callbacks — the stack VM has no native-ABI story yet; emit a marker
// so a future interpreter can bind it, and keep codegen target-agnostic.
void StackVMBackend::loadFnPtr(sym: string)
    op("PUSHFN " + sym)

mut StackVMBackend::emitTrampoline(sym: string, argc: int)
    op("; trampoline " + sym + " / " + string(argc) + " args")

// Conservative auto-free — no-ops for the VM (a future GC / interpreter
// owns object lifetime); codegen stays target-agnostic.
void StackVMBackend::zeroFreeableSlots(offsets: [int])
    return

mut StackVMBackend::emitScopeReleases(objOffsets: [int], arrOffsets: [int], preserveAcc: bool, accIsFloat: bool)
    return

mut StackVMBackend::releaseStoreLocal(off: int, isArray: bool)
    op("STL " + string(off))

// ── error handling ────────────────────────────────────────────────
//
//  A VM interpreter must keep a stack of landing pads.  `TRY <catch>`
//  pushes one targeting the catch label; `THROW` pops to the nearest pad
//  (popping it) and jumps there; `ENDTRY` pops the pad on the normal
//  path.  On the caught path a null (PUSHI 0) stands in for the call's
//  result.
void StackVMBackend::throwErr()
    op("THROW")

mut StackVMBackend::tryBegin()
    let catchL = newLabel()
    let doneL = newLabel()
    m_tryCatch += [catchL]
    m_tryDone += [doneL]
    op("TRY " + catchL)

mut StackVMBackend::tryEnd()
    let catchL = m_tryCatch[#m_tryCatch - 1]
    let doneL = m_tryDone[#m_tryDone - 1]
    m_tryCatch = m_tryCatch[0 to (#m_tryCatch - 1)]
    m_tryDone = m_tryDone[0 to (#m_tryDone - 1)]
    op("ENDTRY")
    op("JMP " + doneL)
    emit(catchL + ":")
    op("PUSHI 0")
    emit(doneL + ":")

// ── objects (structs + classes) ───────────────────────────────────

void StackVMBackend::objNew(typeId: int, nFields: int)
    op("ONEW " + string(typeId) + " " + string(nFields))

// handle on stack → its integer type id on stack
void StackVMBackend::objTypeId()
    op("OTID")

// `s[a to b]` / `arr[a to b]` — object, start, end on the stack
void StackVMBackend::sliceStr()
    op("STRSLICE")

void StackVMBackend::sliceArray()
    op("ARRSLICE")

// handle on stack → 1 if its type id is one of `ids`, else 0
mut StackVMBackend::isTypeCheck(ids: [int])
    let s = "ISTYPE"
    for id in ids do
        s = s + " " + string(id)
    op(s)

// virtual dispatch through the receiver's class vtable
void StackVMBackend::vcall(slot: int, n: int)
    op("VCALL " + string(slot) + " " + string(n))

void StackVMBackend::beginVtables(nTypes: int)
    op("; vtables for " + string(nTypes) + " types")

mut StackVMBackend::setVtable(typeId: int, labels: [string])
    let s = ".vtable " + string(typeId)
    for l in labels do
        s = s + " " + l
    op(s)

void StackVMBackend::objSetField(idx: int)
    op("OSET " + string(idx))

void StackVMBackend::objInitArg0(total: int)
    op("OARG0 " + string(total))

void StackVMBackend::objFinishNew()
    op("OFIN")

void StackVMBackend::loadField(idx: int)
    op("OGET " + string(idx))

void StackVMBackend::storeField(idx: int)
    op("OPUT " + string(idx))

void StackVMBackend::indexAssign()
    op("ASET")
