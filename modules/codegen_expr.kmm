module km_compiler

// ═══════════════════════════════════════════════════════════════════════
//  Codegen — expression lowering.  Target-independent: each node is
//  lowered to a short sequence of `m_backend` operations that leave the
//  result on the backend's operand stack (see backend.kmm).
// ═══════════════════════════════════════════════════════════════════════

void Codegen::genExpr(e: Expression?)
    if e is IntLiteral then
        m_backend.loadIntLit(e.value)
    else if e is BoolLiteral then
        m_backend.loadBoolLit(e.value)
    else if e is FloatLiteral then
        m_backend.loadFloatLit(e.value)
    else if e is Identifier then
        if not hasLocal(e.name) and isCurField(e.name) then
            m_backend.loadLocal(slotOf("self"), "int")
            m_backend.loadField(fieldIndexOf(m_curClass, e.name))
            // a raw field read lands in rax; a float field must ride xmm0
            if fieldTypeOf(m_curClass, e.name) == "float" then
                m_backend.bitsToFloat()
        else if not hasLocal(e.name) and isMacro(e.name) then
            genExpr(macroExprOf(e.name))
        else if not hasLocal(e.name) and isGlobalVar(e.name) then
            m_backend.loadGlobal(e.name, globalTypeOf(e.name))
        else if not hasLocal(e.name) and isEnumVariant(e.name) then
            m_backend.loadIntLit(string(enumOrdinal(e.name)))
        else if not hasLocal(e.name) then
            throw ("undefined variable '" + e.name + "'")
        else
            m_backend.loadLocal(slotOf(e.name), typeOf(e.name))
    else if e is NewExpr then
        if e.protected then
            m_backend.tryBegin()
            genNew(e)
            m_backend.tryEnd()
        else
            genNew(e)
    else if e is MemberExpr then
        let mt = exprType(e.object)
        if not isObjType(mt) then
            throw (string(e.line) + ": field access '." + e.member + "' on a non-object (type '" + mt + "')")
        genExpr(e.object)
        m_backend.loadField(fieldIndexOf(mt, e.member))
        if fieldTypeOf(mt, e.member) == "float" then
            m_backend.bitsToFloat()
    else if e is UnaryOp then
        genUnary(e)
    else if e is BinaryOp then
        genBinary(e)
    else if e is IndexExpr then
        let objT = exprType(e.object)
        let strIdx = objT == "string"
        genExpr(e.object)
        m_backend.pushAcc()
        genExpr(e.index)
        if strIdx then
            m_backend.strIndexAcc()
        else
            m_backend.indexAcc()
            // a raw element read lands in rax; a float element rides xmm0
            if elemTypeOf(objT) == "float" then
                m_backend.bitsToFloat()
    else if e is SliceExpr then
        genSlice(e)
    else if e is ArrayExpr then
        genArray(e)
    else if e is CallExpr then
        if e.protected then
            m_backend.tryBegin()
            genCall(e)
            m_backend.tryEnd()
        else
            genCall(e)
    else if e is ThrowExpr then
        genThrow(e.message)
    else if e is NullLiteral then
        // `null` is the zero handle / value; also the result of a
        // protected call (`f()?`) that caught an error.
        m_backend.loadIntLit("0")
    else if e is StringLiteral then
        m_backend.loadStrLit(e.value)
    else if e is CharLiteral then
        // a char literal is a one-character string; `'a'` → `"a"`
        m_backend.loadStrLit("\"" + e.value[1 to (#e.value - 1)] + "\"")

// `throw expr` — evaluate the message string into the accumulator and
// hand it to the runtime, which longjmps to the innermost protected call
// site or, with none, prints the message and exits.
void Codegen::genThrow(msg: Expression?)
    if msg == null then
        m_backend.loadStrLit("\"\"")
    else
        genExpr(msg)
    m_backend.throwErr()

// `obj[start to end]` — a fresh string or array holding the half-open
// range.  A missing start is 0; a missing end is passed as -1 and the
// runtime helper clamps it to the length.
void Codegen::genSlice(e: SliceExpr)
    let isStr = exprType(e.object) == "string"
    genExpr(e.object)
    m_backend.pushAcc()
    if e.start == null then
        m_backend.loadIntLit("0")
    else
        genExpr(e.start)
    m_backend.pushAcc()
    if e.end == null then
        m_backend.loadIntLit("-1")
    else
        genExpr(e.end)
    if isStr then
        m_backend.sliceStr()
    else
        m_backend.sliceArray()

// `expr is TypeName` — evaluate the handle, then let the backend load its
// header type id and test it against `TypeName` + every descendant id.
// A null handle is never an instance of anything.
void Codegen::genIsCheck(e: BinaryOp)
    let rn = ""
    if e.right is Identifier then
        rn = e.right.name
    else
        throw "`is` expects a type name on the right"
    if not isObjType(rn) then
        throw ("`is` of unknown type '" + rn + "'")
    genExpr(e.left)
    m_backend.isTypeCheck(descendantIds(rn))

void Codegen::genUnary(e: UnaryOp)
    if e.op == "#" then
        genExpr(e.operand)
        if exprType(e.operand) == "string" then
            m_backend.strLen()
        else
            m_backend.arrayLenField()
    else if e.op == "-" then
        genExpr(e.operand)
        if exprType(e.operand) == "float" then
            m_backend.negFloat()
        else
            m_backend.negInt()
    else if e.op == "not" then
        genExpr(e.operand)
        m_backend.notBool()

void Codegen::genBinary(e: BinaryOp)
    if e.op == "is" then
        genIsCheck(e)
        return
    // A float-valued `A and B or C` needs the real branch lowering
    // (xmm0 arms); the integer idiom keeps its short-circuit `genLogical`
    // path, whose Lua "B falsy ⇒ C" semantics some code may rely on.
    if isTernary(e) and exprType(e) == "float" then
        genTernary(e)
        return
    if e.op == "and" or e.op == "or" then
        genLogical(e)
        return
    let ls = exprType(e.left) == "string"
    let rs = exprType(e.right) == "string"
    let la = isArrayType(exprType(e.left))
    if (e.op == "==" or e.op == "!=") and (ls or rs) then
        genStrEquals(e)
    else if isCompareOp(e.op) and (ls or rs) then
        genStrCompare(e)
    else if isCompareOp(e.op) then
        genCompare(e)
    else if e.op == "+" and (ls or rs) then
        genStrOp(e, "km_str_concat")
    else if e.op == "*" and ls then
        genStrOp(e, "km_str_repeat")
    else if e.op == "+" and la then
        genExpr(e.left)
        m_backend.pushAcc()
        genExpr(e.right)
        m_backend.arrayAppendAcc()
    else if e.op == "*" and la then
        genExpr(e.left)
        m_backend.pushAcc()
        genExpr(e.right)
        m_backend.arrayRepeat()
    else if exprType(e.left) == "float" or exprType(e.right) == "float" then
        genFloatArith(e)
    else
        genIntArith(e)

// `a + b` (concat) and `s * n` (repeat) share a shape: evaluate both
// operands, then hand the runtime-helper name to the backend.
void Codegen::genStrOp(e: BinaryOp, helper: string)
    genExpr(e.left)
    m_backend.pushAcc()
    genExpr(e.right)
    m_backend.strBinOp(helper)

void Codegen::genStrEquals(e: BinaryOp)
    genExpr(e.left)
    m_backend.pushAcc()
    genExpr(e.right)
    m_backend.strEquals(e.op == "!=")

void Codegen::genCompare(e: BinaryOp)
    // a float on either side ⇒ compare in the SSE unit; an int operand is
    // widened first so `2 < 3.5` works.
    if exprType(e.left) == "float" or exprType(e.right) == "float" then
        genOperandAsFloat(e.left)
        m_backend.pushAccFloat()
        genOperandAsFloat(e.right)
        m_backend.compareFloat(e.op)
        return
    genExpr(e.left)
    m_backend.pushAcc()
    genExpr(e.right)
    m_backend.compareInt(e.op)

// `s1 < s2` etc. — lexicographic, via km_str_cmp (like C strcmp).
void Codegen::genStrCompare(e: BinaryOp)
    genExpr(e.left)
    m_backend.pushAcc()
    genExpr(e.right)
    m_backend.strCompare(e.op)

// Short-circuit `and` / `or`: the right operand is only evaluated when
// the left doesn't already decide the result.  (Integer / pointer / bool
// operands.  A float-valued select goes through `genTernary`.)
void Codegen::genLogical(e: BinaryOp)
    let endL = m_backend.newLabel()
    genExpr(e.left)
    if e.op == "and" then
        m_backend.branchIfZeroKeep(endL)
    else
        m_backend.branchIfNonzeroKeep(endL)
    genExpr(e.right)
    m_backend.label(endL)

// `A and B or C` — the Lua conditional-value idiom — lowered as a real
// `A ? B : C` so the two arms may leave a float in xmm0 without the
// truthiness plumbing that `genLogical` does on rax.  `isTernary` gates
// this in `genBinary`.
mut Codegen::isTernary(e: BinaryOp): bool
    if e.op != "or" then
        return false
    let l = e.left
    return l is BinaryOp and l.op == "and"

void Codegen::genTernary(e: BinaryOp)
    let cond = e.left
    if not (cond is BinaryOp) then
        genLogical(e)
        return
    let wantFloat = exprType(e) == "float"
    let elseL = m_backend.newLabel()
    let endL = m_backend.newLabel()
    genExpr(cond.left)
    m_backend.branchIfZero(elseL)
    genTernaryArm(cond.right, wantFloat)
    m_backend.jump(endL)
    m_backend.label(elseL)
    genTernaryArm(e.right, wantFloat)
    m_backend.label(endL)

void Codegen::genTernaryArm(v: Expression?, wantFloat: bool)
    genExpr(v)
    if wantFloat and exprType(v) != "float" then
        m_backend.cvtIntToFloat()

void Codegen::genIntArith(e: BinaryOp)
    genExpr(e.left)
    m_backend.pushAcc()
    genExpr(e.right)
    m_backend.binaryInt(e.op)

void Codegen::genFloatArith(e: BinaryOp)
    genOperandAsFloat(e.left)
    m_backend.pushAccFloat()
    genOperandAsFloat(e.right)
    m_backend.binaryFloat(e.op)

void Codegen::genOperandAsFloat(e: Expression?)
    genExpr(e)
    if exprType(e) != "float" then
        m_backend.cvtIntToFloat()

// Array literal → target-defined  [ len | cap | elems… ]  handle.
// A `[float]` literal widens any integer element (`[1, 2.5]` ⇒ [float]).
void Codegen::genArray(e: ArrayExpr)
    let n = #e.elements
    let floatElems = elemTypeOf(exprType(e)) == "float"
    m_backend.arrayBegin(n)
    let i = 0
    for elem in e.elements do
        genExpr(elem)
        if floatElems and exprType(elem) != "float" then
            m_backend.cvtIntToFloat()
        if floatElems or exprType(elem) == "float" then
            m_backend.floatToBits()
        m_backend.arrayStoreElem(i)
        i += 1
    m_backend.arrayEnd()

// Runtime type tag for a call argument (see km_runtime.h):
//   0 int / pointer   1 float   2 string   3 bool   4+ array (packed,
//   see arrayTag) — lets `print`/`string(x)` pretty-print array values.
mut Codegen::argTag(a: Expression?): int
    if a is BoolLiteral then
        return 3
    let t = exprType(a)
    if isArrayType(t) then
        return arrayTag(t)
    if t == "float" then
        return 1
    if t == "string" then
        return 2
    return 0

// Packs an array type's leaf scalar tag and nesting depth into one
// runtime tag: KM_TAG_ARRAY in the low byte, leaf tag in the next byte,
// depth in the byte above that (mirrors km_runtime.h's contract;
// `km_array_to_string` in stdlib/runtime.c unpacks the same way).
// Types are homogeneous, so a single leaf + depth describes any uniform
// nesting, e.g. `[[int]]` is leaf=int, depth=2.
mut Codegen::arrayTag(t: string): int
    let depth = 0
    let leafType = t
    while isArrayType(leafType) do
        depth += 1
        leafType = elemTypeOf(leafType)
    let leaf = 9
    if leafType == "int" then
        leaf = 0
    else if leafType == "float" then
        leaf = 1
    else if leafType == "string" then
        leaf = 2
    return 4 + leaf * 256 + depth * 65536

// Every Komodo call is lowered the same way: an argc-long (tag, value)[]
// buffer, filled one pair at a time.  `print`, `algorithm.sort`, … are
// just calls whose symbol is resolved by the target's linker / loader.
void Codegen::genCall(e: CallExpr)
    // `data(arr)` — the element pointer of a Komodo array (handle + 16),
    // for handing a writable buffer to an `extern fn` (out-params, event
    // structs, …).  Read results back with ordinary `arr[i]`.
    if e.name == "data" then
        if #e.args != 1 then
            throw "data(arr) takes exactly one argument"
        genExpr(e.args[0])
        m_backend.arrayDataPtr()
        return

    // `join(parts, sep)` — concatenate a [string] with `sep` between,
    // in one pass (avoids O(n^2) `s = s + line` when building big text).
    if e.name == "join" then
        if #e.args != 2 then
            throw "join(parts, sep) takes exactly two arguments"
        genExpr(e.args[0])
        m_backend.pushAcc()
        genExpr(e.args[1])
        m_backend.strBinOp("km_str_join")
        return

    // `copy(x)` — a deep copy.  A value type delegates to its synthesised
    // `km_deepcopy_<T>` helper; an array is buffer-cloned; anything else
    // (scalar, string, enum, opaque handle) is already a value copy.
    if e.name == "copy" then
        if #e.args != 1 then
            throw "copy(x) takes exactly one argument"
        let a = e.args[0]
        let t = exprType(a)
        if deepCopierExists(t) then
            genCall(new CallExpr("km_deepcopy_" + t, [a]))
            return
        if isArrayType(t) then
            let sl = new SliceExpr()
            sl.object = a
            genSlice(sl)
            return
        genExpr(a)
        return

    // `string(x)` — convert any tagged value to its text form.
    if e.name == "string" then
        if #e.args != 1 then
            throw "string(x) takes exactly one argument"
        let tg = argTag(e.args[0])
        genExpr(e.args[0])
        if exprType(e.args[0]) == "float" then
            m_backend.floatToBits()
        m_backend.toStringOf(tg)
        return

    // `recv.method(args)` where `recv` is an object-typed local, a field
    // of the enclosing class, or `self` — a method call: the receiver
    // rides in as implicit argument 0.
    let dot = dotIndex(e.name)
    if dot > 0 then
        let recv = e.name[0 to dot]
        let meth = e.name[(dot + 1) to e.name.length]
        if isMethodReceiver(recv) then
            genMethodCall(recv, meth, e.args)
            return

    // an unqualified call inside a method that names a sibling method —
    // `foo(x)` means `self.foo(x)`.
    if dot < 0 and m_curClass != "" and not hasFn(e.name) then
        let owner = resolveMethodOwner(m_curClass, e.name)
        if owner != "" then
            genMethodCall("self", e.name, e.args)
            return

    // Generic (implicit-type) free function — monomorphize it for the
    // static argument types and call the specialized instance.
    if isTemplate(e.name) then
        let tpl = templateDeclOf(e.name)
        if #tpl.params != #e.args then
            throw ("function '" + e.name + "' takes " + string(#tpl.params) + " argument(s), got " + string(#e.args))
        let gsym = ensureInstance(e.name, tplArgTypes(e.args))
        if m_curKind == "fn" and fnKind(gsym) == "void" then
            throw ("a pure `fn` cannot call the void procedure '" + e.name + "'")
        genDirectCall(gsym, e.args)
        return

    // Overloaded free function — pick the overload from the static
    // argument types, falling back to a runtime dispatch when more than
    // one candidate survives.
    if countSourceName(e.name) >= 2 then
        let sel = selectOverload(e.name, e.args)
        if sel == 0 - 2 then
            genOverloadDispatch(m_ovOrder, e.args)
        else
            if m_curKind == "fn" and m_fnKinds[sel] == "void" then
                throw ("a pure `fn` cannot call the void procedure '" + e.name + "'")
            genDirectCall(m_fnLink[sel], e.args)
        return

    let kind = fnKind(e.name)

    // `extern fn` — call through the native System V AMD64 C ABI.
    // Integer / pointer / string args fill rdi, rsi, rdx, rcx, r8, r9
    // then spill to the stack; float args fill xmm0..7 then spill; the
    // backend places each one from the class list built here.
    if kind == "extern" then
        if fnArity(e.name) != #e.args then
            throw ("extern '" + e.name + "' takes " + string(fnArity(e.name)) + " argument(s), got " + string(#e.args))
        // Classify every argument up front — an argument may itself be a
        // nested extern call, so nothing stateful can live in the backend
        // across the evaluation loop.
        let classes: [string] = []
        for a in e.args do
            if a is Identifier and isCallbackArg(a) then
                classes += ["int"]
            else if exprType(a) == "float" then
                classes += ["float"]
            else
                classes += ["int"]
        m_backend.cCallBegin(#e.args)
        let ci = 0
        for a in e.args do
            if a is Identifier and isCallbackArg(a) then
                // pass C a pointer to this Komodo function's trampoline
                recordTramp(a.name)
                m_backend.loadFnPtr(m_backend.mangle(a.name))
            else
                genExpr(a)
            m_backend.cCallArg(ci, classes[ci])
            ci += 1
        m_backend.cCallEnd(e.name, classes)
        return

    // Enforcements for calls to functions defined in this program.
    if kind != "" then
        if fnArity(e.name) != #e.args then
            throw ("function '" + e.name + "' takes " + string(fnArity(e.name)) + " argument(s), got " + string(#e.args))
        if m_curKind == "fn" and kind == "void" then
            throw ("a pure `fn` cannot call the void procedure '" + e.name + "'")

    let n = #e.args
    if n == 0 then
        m_backend.call0(e.name)
        return

    m_backend.callFrameBegin(n)
    let j = 0
    for a in e.args do
        m_backend.callArgTag(j, argTag(a))
        genExpr(a)
        if exprType(a) == "float" then
            m_backend.floatToBits()
        m_backend.callArgStore(j)
        j += 1
    m_backend.callFrameEnd(e.name, n)

// Build the (tag,value)[] frame and call `sym` directly — the shared tail
// of a plain call and of every statically-resolved overload / generic
// instance.
void Codegen::genDirectCall(sym: string, args: [Expression])
    let n = #args
    if n == 0 then
        m_backend.call0(sym)
        return
    m_backend.callFrameBegin(n)
    let j = 0
    for a in args do
        m_backend.callArgTag(j, argTag(a))
        genExpr(a)
        if exprType(a) == "float" then
            m_backend.floatToBits()
        m_backend.callArgStore(j)
        j += 1
    m_backend.callFrameEnd(sym, n)

// Runtime overload dispatch: build the frame once, then for each
// candidate (most specific first) test the argument tags / header type
// ids and, on a full match, call that overload.  No candidate matching at
// runtime aborts.
void Codegen::genOverloadDispatch(order: [int], args: [Expression])
    let n = #args
    m_backend.callFrameBegin(n)
    let j = 0
    for a in args do
        m_backend.callArgTag(j, argTag(a))
        genExpr(a)
        if exprType(a) == "float" then
            m_backend.floatToBits()
        m_backend.callArgStore(j)
        j += 1
    m_backend.dispatchBegin()
    for idx in order do
        m_backend.dispatchCaseBegin()
        let sig = m_fnSigs[idx]
        let pi = 0
        while pi < #sig do
            let pt = sig[pi]
            if pt == "int" then
                m_backend.dispatchTestTag(pi, 0)
            else if pt == "float" then
                m_backend.dispatchTestTag(pi, 1)
            else if pt == "string" then
                m_backend.dispatchTestTag(pi, 2)
            else if pt == "bool" then
                m_backend.dispatchTestTag(pi, 3)
            else if pt != "any" then
                m_backend.dispatchTestType(pi, descendantIds(pt))
            pi += 1
        m_backend.dispatchCall(m_fnLink[idx], n)
        m_backend.dispatchCaseEnd()
    m_backend.dispatchEnd(n)

// ── objects: `new`, method calls ──────────────────────────────────

mut Codegen::dotIndex(s: string): int
    let i = 0
    while i < s.length do
        if s[i] == "." then
            return i
        i += 1
    return 0 - 1

// `new T(args)` — allocate a zeroed handle, then either run the class
// constructor (receiver as implicit arg 0) or store the args positionally
// into the fields (struct / constructor-less class).  Result: the handle.
void Codegen::genNew(e: NewExpr)
    if not isObjType(e.typeName) then
        throw ("`new` of unknown type '" + e.typeName + "'")
    if isAbstractType(e.typeName) then
        throw ("cannot instantiate abstract type '" + e.typeName + "'")
    let nfields = objFieldCount(e.typeName)
    m_backend.objNew(typeIdOf(e.typeName), nfields)

    let ctor = resolveCtorSym(e.typeName)
    let hasCtor = typeIsClass(e.typeName) and hasFn(ctor)

    // Positional `new T(a, b, …)` on a struct / ctor-less class binds args
    // to fields in *constructor order* (required fields first, then this
    // type's own defaulted fields, then inherited defaulted ones — the
    // interpreter's `reorder_constructible_fields`), not raw declaration
    // order.
    let order = ctorFieldOrder(e.typeName)
    let filled: [bool] = []
    let fi = 0
    while fi < nfields do
        filled += [false]
        fi += 1
    if not hasCtor then
        let k = 0
        while k < #e.args and k < #order do
            filled[order[k]] = true
            k += 1

    // Field default initializers run first (interpreter order): before the
    // constructor for a class, and for the slots a positional `new` on a
    // struct / ctor-less class doesn't fill.
    let di = 0
    while di < nfields do
        let dflt = fieldDefaultAt(e.typeName, di)
        if dflt != null and not filled[di] then
            genExpr(dflt)
            if fieldTypeAt(e.typeName, di) == "float" then
                if exprType(dflt) != "float" then
                    m_backend.cvtIntToFloat()
                m_backend.floatToBits()
            m_backend.objSetField(di)
        di += 1

    if hasCtor then
        let total = 1 + #e.args
        if fnArity(ctor) != total then
            throw ("constructor '" + e.typeName + "' takes " + string(fnArity(ctor) - 1) + " argument(s), got " + string(#e.args))
        m_backend.callFrameBegin(total)
        m_backend.objInitArg0(total)
        let j = 1
        for a in e.args do
            m_backend.callArgTag(j, argTag(a))
            genExpr(a)
            if exprType(a) == "float" then
                m_backend.floatToBits()
            m_backend.callArgStore(j)
            j += 1
        m_backend.callFrameEnd(ctor, total)
    else
        if #e.args > nfields then
            throw ("`new " + e.typeName + "` given more values than it has fields")
        let i = 0
        for a in e.args do
            let slot = order[i]
            genExpr(a)
            // a float field is stored as raw bits; widen an int arg first
            if fieldTypeAt(e.typeName, slot) == "float" then
                if exprType(a) != "float" then
                    m_backend.cvtIntToFloat()
                m_backend.floatToBits()
            m_backend.objSetField(slot)
            i += 1
    m_backend.objFinishNew()

// Is `recv` a name we can call a method on — an object-typed local, an
// object-typed field of the enclosing class, or `self`?
mut Codegen::isMethodReceiver(recv: string): bool
    if hasLocal(recv) then
        return isObjType(typeOf(recv))
    if recv == "self" and m_curClass != "" then
        return true
    if m_curClass != "" and isCurField(recv) then
        return isObjType(fieldTypeOf(m_curClass, recv))
    return false

// Static type of such a receiver.
mut Codegen::receiverType(recv: string): string
    if hasLocal(recv) then
        return typeOf(recv)
    if recv == "self" then
        return m_curClass
    return fieldTypeOf(m_curClass, recv)

// Leave the receiver handle in the integer accumulator.
void Codegen::loadReceiver(recv: string)
    if hasLocal(recv) then
        m_backend.loadLocal(slotOf(recv), "int")
    else if recv == "self" then
        m_backend.loadLocal(slotOf("self"), "int")
    else
        m_backend.loadLocal(slotOf("self"), "int")
        m_backend.loadField(fieldIndexOf(m_curClass, recv))

void Codegen::genMethodCall(recv: string, meth: string, args)
    let objType = receiverType(recv)
    let owner = resolveMethodOwner(objType, meth)
    if owner == "" then
        throw ("type '" + objType + "' has no method '" + meth + "'")
    let sym = owner + "__" + meth
    let total = 1 + #args
    if fnArity(sym) != total then
        throw ("method '" + objType + "." + meth + "' takes " + string(fnArity(sym) - 1) + " argument(s), got " + string(#args))
    // Virtual when the static type carries a vtable slot for this method;
    // a plain direct call otherwise (structs, leaf classes).
    let slot = methodSlotOf(objType, meth)
    m_backend.callFrameBegin(total)
    m_backend.callArgTag(0, 0)
    loadReceiver(recv)
    m_backend.callArgStore(0)
    let j = 1
    for a in args do
        m_backend.callArgTag(j, argTag(a))
        genExpr(a)
        if exprType(a) == "float" then
            m_backend.floatToBits()
        m_backend.callArgStore(j)
        j += 1
    if slot >= 0 then
        m_backend.vcall(slot, total)
    else
        m_backend.callFrameEnd(sym, total)
