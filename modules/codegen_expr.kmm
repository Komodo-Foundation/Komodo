module km_compiler

// ═══════════════════════════════════════════════════════════════════════
//  Codegen — expression lowering.  Target-independent: each node is
//  lowered to a short sequence of `m_backend` operations that leave the
//  result on the backend's operand stack (see backend.kmm).
// ═══════════════════════════════════════════════════════════════════════

void Codegen::genExpr(e)
    if e is IntLiteral then
        m_backend.loadIntLit(e.value)
    else if e is BoolLiteral then
        m_backend.loadBoolLit(e.value)
    else if e is FloatLiteral then
        m_backend.loadFloatLit(e.value)
    else if e is Identifier then
        if not hasLocal(e.name) then
            throw ("undefined variable '" + e.name + "'")
        m_backend.loadLocal(slotOf(e.name), typeOf(e.name))
    else if e is UnaryOp then
        genUnary(e)
    else if e is BinaryOp then
        genBinary(e)
    else if e is TernaryOp then
        genTernary(e)
    else if e is IndexExpr then
        genExpr(e.object)
        m_backend.pushAcc()
        genExpr(e.index)
        m_backend.indexAcc()
    else if e is ArrayExpr then
        genArray(e)
    else if e is CallExpr then
        genCall(e)
    else if e is StringLiteral then
        m_backend.loadStrLit(e.value)

void Codegen::genUnary(e)
    if e.op == "#" then
        genExpr(e.operand)
        if exprType(e.operand) == "string" then
            m_backend.strLen()
        else
            m_backend.arrayLenField()
    else if e.op == "-" then
        genExpr(e.operand)
        if exprType(e.operand) == "float" then
            m_backend.negFloat()
        else
            m_backend.negInt()
    else if e.op == "not" then
        genExpr(e.operand)
        m_backend.notBool()

void Codegen::genBinary(e)
    if e.op == "and" or e.op == "or" then
        genLogical(e)
        return
    let ls = exprType(e.left) == "string"
    let rs = exprType(e.right) == "string"
    if (e.op == "==" or e.op == "!=") and (ls or rs) then
        genStrEquals(e)
    else if isCompareOp(e.op) then
        genCompare(e)
    else if e.op == "+" and (ls or rs) then
        genStrOp(e, "km_str_concat")
    else if e.op == "*" and ls then
        genStrOp(e, "km_str_repeat")
    else if exprType(e.left) == "float" or exprType(e.right) == "float" then
        genFloatArith(e)
    else
        genIntArith(e)

// `a + b` (concat) and `s * n` (repeat) share a shape: evaluate both
// operands, then hand the runtime-helper name to the backend.
void Codegen::genStrOp(e, helper: string)
    genExpr(e.left)
    m_backend.pushAcc()
    genExpr(e.right)
    m_backend.strBinOp(helper)

void Codegen::genStrEquals(e)
    genExpr(e.left)
    m_backend.pushAcc()
    genExpr(e.right)
    m_backend.strEquals(e.op == "!=")

void Codegen::genCompare(e)
    genExpr(e.left)
    m_backend.pushAcc()
    genExpr(e.right)
    m_backend.compareInt(e.op)

// Short-circuit `and` / `or`: the right operand is only evaluated when
// the left doesn't already decide the result.
void Codegen::genLogical(e)
    let endL = m_backend.newLabel()
    genExpr(e.left)
    if e.op == "and" then
        m_backend.branchIfZeroKeep(endL)
    else
        m_backend.branchIfNonzeroKeep(endL)
    genExpr(e.right)
    m_backend.label(endL)

void Codegen::genTernary(e)
    let elseL = m_backend.newLabel()
    let endL = m_backend.newLabel()
    genExpr(e.cond)
    m_backend.branchIfZero(elseL)
    genExpr(e.whenTrue)
    m_backend.jump(endL)
    m_backend.label(elseL)
    genExpr(e.whenFalse)
    m_backend.label(endL)

void Codegen::genIntArith(e)
    genExpr(e.left)
    m_backend.pushAcc()
    genExpr(e.right)
    m_backend.binaryInt(e.op)

void Codegen::genFloatArith(e)
    genOperandAsFloat(e.left)
    m_backend.pushAccFloat()
    genOperandAsFloat(e.right)
    m_backend.binaryFloat(e.op)

void Codegen::genOperandAsFloat(e)
    genExpr(e)
    if exprType(e) != "float" then
        m_backend.cvtIntToFloat()

// Array literal → target-defined  [ len | cap | elems… ]  handle.
void Codegen::genArray(e)
    let n = #e.elements
    m_backend.arrayBegin(n)
    let i = 0
    for elem in e.elements do
        genExpr(elem)
        m_backend.arrayStoreElem(i)
        i += 1
    m_backend.arrayEnd()

// Runtime type tag for a call argument (see km_runtime.h):
//   0 int / pointer   1 float   2 string   3 bool
mut Codegen::argTag(a): int
    if a is BoolLiteral then
        return 3
    let t = exprType(a)
    if t == "float" then
        return 1
    if t == "string" then
        return 2
    return 0

// Every Komodo call is lowered the same way: an argc-long (tag, value)[]
// buffer, filled one pair at a time.  `print`, `algorithm.sort`, … are
// just calls whose symbol is resolved by the target's linker / loader.
void Codegen::genCall(e)
    // Enforcements for calls to functions defined in this program.
    let kind = fnKind(e.name)
    if kind != "" then
        if fnArity(e.name) != #e.args then
            throw ("function '" + e.name + "' takes " + string(fnArity(e.name)) + " argument(s), got " + string(#e.args))
        if m_curKind == "fn" and kind == "void" then
            throw ("a pure `fn` cannot call the void procedure '" + e.name + "'")

    let n = #e.args
    if n == 0 then
        m_backend.call0(e.name)
        return

    m_backend.callFrameBegin(n)
    let j = 0
    for a in e.args do
        m_backend.callArgTag(j, argTag(a))
        genExpr(a)
        if exprType(a) == "float" then
            m_backend.floatToBits()
        m_backend.callArgStore(j)
        j += 1
    m_backend.callFrameEnd(e.name, n)
