module km_compiler

// GENERATED by tools/gen-diag.py from docs/errors/catalog.txt — do not edit.
// One entry per diagnostic: code, message pattern (`*` = any text), why, help, span.

fn diagCatalog(): [string]
    let c: [string] = []
    c += ["K0001\tundefined name '*'\tThe compiler looked for a variable, parameter, macro or function called '{1}' and found none in scope. Names must be declared with `let` (or as parameters) before the line that uses them.\tCheck the spelling, or declare '{1}' with `let {1} = ...` before this line.\t"]
    c += ["K0002\tundefined function '*::*'\tThe module '{1}' was imported, but it has no member named '{2}'. A `module::name` call can only reach members the module declares.\tCheck the spelling of '{2}' in the module, or add it to the module's `public` section.\t"]
    c += ["K0003\tassignment to undeclared variable '*'\tAn assignment can only change a variable that already exists. '{1}' was never declared, so there is nothing to assign to.\tDeclare it first with `let {1} = ...`.\t"]
    c += ["K0004\t`new` of unknown type '*'\t`new` builds a value of a struct or class, and the compiler has no struct, class or enum called '{1}'.\tCheck the spelling, or declare `struct {1}` (or `class {1}`) above `main`.\t"]
    c += ["K0005\ttype '*' has no field '*'\tThe struct or class '{1}' declares a fixed set of fields, and '{2}' is not one of them. Fields cannot be added to a value after the fact.\tCheck the spelling, or add a `{2}` field to '{1}'.\t"]
    c += ["K0006\ttype '*' has no method '*'\tA method call `value.name(...)` needs a method called 'name' on the value's class. '{1}' has no method '{2}'.\tCheck the spelling, or add `{2}` to the class '{1}'. Structs hold fields only.\t"]
    c += ["K0007\tstruct pattern names unknown type '*'\tA `case Type(...)` pattern names the struct it matches, and there is no struct called '{1}'.\tCheck the spelling of the type name.\t"]
    c += ["K0008\ttype '*' inherits unknown type '*'\tA type can only extend a struct or class that is declared somewhere in the program. '{2}' is not.\tCheck the spelling of the base type, or declare it.\t"]
    c += ["K0009\t`is` expects a known type name on the right\t`x is Type` tests the runtime type of x, so its right-hand side must be the name of a struct or class, not an expression.\tWrite a type name after `is`, for example `x is Circle`.\t"]
    c += ["K0010\t'*' is private to class '*'\tMembers in a class's `private` section can only be used by that class's own methods. This keeps the class free to change them without breaking callers.\tUse a public method of '{2}' instead, or move '{1}' to the `public` section.\t"]
    c += ["K0011\t'*' is private to module '*'\tMembers in a module's `private` section can be used only from inside that module. Callers see just the `public` section, so the module can change the rest freely.\tCall a `public` member of '{2}' instead, or move '{1}' to its `public` section.\t"]
    c += ["K0012\tcannot find module '*'\t`import {1}` loads a file called `{1}.kmm`. The compiler searched the importing file's directory tree and then its own standard library, and found neither.\tCheck the spelling, or create `{1}.kmm` next to your program. Standard modules include console, math, string, file and os.\t"]
    c += ["K0013\tfile not found: *\tThe file you asked the compiler to build does not exist at that path.\tCheck the path and the current directory.\t"]
    c += ["K0020\targument * to '*': type '*' is not assignable to '*'\tEach argument must have the type the function declared for that parameter. A value of type '{3}' cannot stand in for '{4}', because the function body would then treat it as the wrong kind of value.\tPass a value of type '{4}', or convert it first (for example `string(x)` or `int(x)`).\t"]
    c += ["K0021\targument * to extern '*': type '*' is not assignable to handle type '*'\tAn `extern type` is an opaque C handle. Handles are distinct types: a Window is not a Renderer, and neither is an int, so the compiler refuses to mix them up.\tPass a value of type '{4}', obtained from the C function that creates one.\t"]
    c += ["K0022\targument * to extern '*': '*' is not compatible with '*'\tArguments to a C function must match the C parameter's type, because the call passes the raw value across the C ABI.\tPass a value of type '{4}'.\t"]
    c += ["K0023\tfield '*' of '*': type '*' is not assignable to '*'\t`new Type(...)` fills the fields in order, and each value must have the type the field was declared with.\tGive '{2}.{1}' a value of type '{4}'.\t"]
    c += ["K0024\t*: type '*' is not assignable to '*'\tA value was used where a different type is required. Komodo does not convert between types silently, because that hides bugs.\tUse a value of type '{3}', or convert it explicitly (`string(x)`, `int(x)`).\t"]
    c += ["K0025\tcannot add '*' and '*' (use string(x) or an interpolated string)*\t`+` adds two numbers or joins two strings, but never mixes a string with a number. Joining them would need a conversion the compiler will not guess.\tConvert the number first with `string(x)`, or use an interpolated string such as `n = {n}`.\t"]
    c += ["K0026\toperator '*' is not defined for the opaque handle type '*'\tAn `extern type` handle is just an opaque pointer owned by C code, so arithmetic and ordering on it make no sense.\tPass the handle to the C function that works on it.\t"]
    c += ["K0027\t`in` on a string wants a string / char on the left, got '*'\t`x in \"text\"` asks whether x occurs inside the string, so x must itself be text or a single character.\tConvert the left side with `string(x)`.\t"]
    c += ["K0028\t`in`: '*' can't be an element of '*'\t`x in array` tests membership, so x must have the array's element type. Here the two types differ, so the answer could never be true.\tLook for a value of the array's element type.\t"]
    c += ["K0029\t`in` wants a string or an array on the right, got '*'\t`in` searches inside a collection. Its right-hand side must be a string (substring test) or an array (element test).\tPut an array or a string after `in`.\t"]
    c += ["K0030\tfield access on a non-object (type '*')\tThe `.name` syntax reads a field of a struct or class. Values of type '{1}' have no fields.\tCheck that the value in front of the `.` is a struct or class instance.\t"]
    c += ["K0031\tfield assignment on a non-object (type '*')\t`a.b = x` writes a field of a struct or class, but the value in front of the `.` has type '{1}', which has no fields.\tCheck that the value in front of the `.` is a struct or class instance.\t"]
    c += ["K0032\t'int' expects a number, got '*'\t`int(x)` converts a float to an integer, truncating toward zero. It does not parse text.\tPass a float or an int.\t"]
    c += ["K0040\t'*' takes at least * argument(s), got *\tA variadic function still needs all of its fixed parameters. Only the extra arguments after them are optional.\tPass at least {2} argument(s).\t"]
    c += ["K0041\t'*' takes * argument(s), got *\tA call must supply exactly the parameters the function declares (trailing parameters with a default value may be left out).\tPass {2} argument(s), as '{1}' declares.\t"]
    c += ["K0042\tmethod '*.*' takes * argument(s), got *\tA method call must supply exactly the parameters the method declares.\tPass {3} argument(s) to '{1}.{2}'.\t"]
    c += ["K0043\tconstructor '*' takes * argument(s), got *\t`new` calls the class's constructor, which declares how many values it needs.\tPass {2} argument(s) to `new {1}(...)`.\t"]
    c += ["K0044\t`new *` given more values than it has fields\t`new Type(a, b, ...)` fills the fields in declaration order. There are more values than fields, so some value has nowhere to go.\tRemove the extra values, or add fields to '{1}'.\t"]
    c += ["K0045\t'assert' takes a condition and an optional message, got * argument(s)\t`assert(cond)` and `assert(cond, \"message\")` are the only forms.\tWrite `assert(condition)` or `assert(condition, \"what went wrong\")`.\t"]
    c += ["K0046\t'*' takes exactly one argument\t`int(x)` and `copy(x)` convert or copy exactly one value.\tPass a single argument.\t"]
    c += ["K0047\tcannot `copy` the opaque handle type '*'\tAn `extern type` handle points at memory owned by C code, so a deep copy would not duplicate the real object.\tAsk the C library for a new handle instead.\t"]
    c += ["K0050\t* operand of '*' is possibly null\tThe operand has a nullable type (`T?`), so it may hold `null` at run time, and arithmetic on null is meaningless. The compiler makes you handle the null case before using the value.\tTest it first, for example `if x != null then ...`, or give it a default.\t"]
    c += ["K0051\t*possibly null — narrow it before calling '*'\tCalling a method on a nullable value would crash when the value is `null`. The compiler asks you to check first.\tWrap the call in `if value != null then ...`.\t"]
    c += ["K0052\tin '*': value of type '*' is possibly null — narrow it before reading '.*'\tReading a field of a nullable value would crash when the value is `null`.\tCheck `value != null` before reading '.{3}'.\t"]
    c += ["K0053\tvalue of type '*' is possibly null — narrow it before indexing\tIndexing a nullable array or string would crash when the value is `null`.\tCheck `value != null` before indexing it.\t"]
    c += ["K0060\t`break` outside a loop\t`break` leaves the nearest enclosing `while` or `for` loop, so it needs one around it.\tPut the `break` inside a loop, or use `return` to leave a function.\t"]
    c += ["K0061\t`continue` outside a loop\t`continue` jumps to the next iteration of the nearest enclosing `while` or `for` loop, so it needs one around it.\tPut the `continue` inside a loop.\t"]
    c += ["K0062\ta void function cannot return a value\tA function declared `void` returns nothing, so `return` may not carry a value in it.\tRemove the value, or declare the function with a return type, for example `fn f(): int`.\t"]
    c += ["K0063\ta value function must return a value\tA function declared with a return type must hand a value back on every `return`; a bare `return` is only for `void` functions.\tWrite `return <value>`.\t"]
    c += ["K0064\tfunction '*' must return a value on every path\tA function with a return type must end in a `return` (or `throw`) no matter which branch runs. Here control can reach the end of '{1}' without returning anything.\tAdd a final `return`, or an `else` branch that returns.\tblock"]
    c += ["K0070\tcannot assign to macro '*' (declared with be)\t`let NAME be value` declares a compile-time macro: every use of the name is replaced by the value, so there is no variable to assign to.\tDeclare it with `let {1} = ...` if it must change.\t"]
    c += ["K0071\tcannot reassign immutable binding '*' (declared with `be`)\tSome names are fixed once and cannot be assigned to: names declared with `be`, `self`, and the counter of a `for` loop, which the loop itself advances. Assigning to one would change something the language relies on.\tUse a separate variable for the value that changes: `let {1}2 = ...`.\t"]
    c += ["K0072\tpure `fn *` mutates state — declare it `mut`\tA `fn` promises not to change anything its caller can see, which lets callers rely on it. Writing a field or an array element breaks that promise.\tDeclare it `mut {1}` (or `void`) if it is meant to change state.\tblock"]
    c += ["K0073\ta pure `fn` cannot call the void procedure '*'\tA `fn` must not change anything visible, but a `void` procedure exists to cause effects. Calling one from a `fn` would hide those effects.\tMake the caller `void` or `mut`, or make '{1}' a `fn`.\t"]
    c += ["K0074\t`let * be` needs a value\t`let NAME be value` defines a macro and the value is what the name expands to.\tWrite `let {1} be <expression>`.\t"]
    c += ["K0080\tduplicate function '*'\tTwo functions share the name '{1}' and the compiler cannot tell them apart.\tRename one of them, or give them different parameter types to overload.\t"]
    c += ["K0081\tduplicate type '*'\tA struct, class or enum called '{1}' is declared more than once, so the name would mean two things.\tRename one of the types, or delete the duplicate.\t"]
    c += ["K0082\tduplicate macro '*'\tTwo top-level macros are both called '{1}', so uses of the name would be ambiguous.\tRename or delete one of them.\t"]
    c += ["K0083\tduplicate top-level name '*'\t'{1}' is declared at top level more than once, so the name would mean two things.\tRename or delete one of the declarations.\t"]
    c += ["K0084\ttemplate '*' cannot share its name with another '*' declaration (a template does not overload)\tA function without parameter types is a template: one body that is compiled once for every type it is called with. That cannot be combined with a typed function of the same name.\tRename one of the two, or give all of them parameter types.\t"]
    c += ["K0085\ttop-level '*' needs a type annotation or an initialiser\tA global variable needs either a starting value or a declared type, so the compiler can tell what it holds.\tWrite `let {1}: int = 0` or `let {1} = 0`.\t"]
    c += ["K0086\tcyclic or unresolved inheritance near '*'\tA type can only extend a struct or class that exists, and a chain of base types must end at one that extends nothing. Here a base type is missing (often a typo), or two types extend each other in a loop.\tCheck the spelling of the base type after the `:`, declare it, or break the cycle.\t"]
    c += ["K0087\tcannot instantiate abstract type '*'\tAn `abstract` type is only a base for other types and has no complete value of its own.\tCreate one of its concrete subtypes instead.\t"]
    c += ["K0088\tcannot construct `extern type *` — it is an opaque C handle; obtain one from a C function\tAn `extern type` stands for something C code creates and owns, so Komodo cannot build one with `new`.\tCall the C function that returns the handle.\t"]
    c += ["K0090\tdefault parameter values are only allowed on free functions with a body\tDefault values are filled in at the call site, which only works for plain functions that have a body. Methods, constructors and C prototypes cannot take them.\tRemove the default, or move the logic into a free function.\t"]
    c += ["K0091\toverloaded function '*' cannot have default parameter values\tOverloads are chosen by the number and types of the arguments. Defaults would make several overloads match the same call.\tRemove the defaults, or give the functions different names.\t"]
    c += ["K0092\tparameter '*' needs a default value, because it follows a parameter that has one\tWhen a call leaves arguments out, the missing ones must be the last ones. So once a parameter has a default, every parameter after it needs one too.\tGive '{1}' a default, or move the defaulted parameters to the end.\t"]
    c += ["K0093\tdefault value of parameter '*' must be a literal\tA default is copied into each call that omits the argument, so it must be a plain literal such as 3, \"x\" or true.\tUse a literal, or compute the value inside the function.\t"]
    c += ["K0100\t`export fn main` is not allowed*\t`main` is the entry point of a Komodo program, and the C runtime already calls it. Exporting a function with that name would clash.\tExport a function with a different name.\t"]
    c += ["K0101\texport fn '*' cannot be overloaded*\tEach exported function becomes one C symbol, and a C symbol names exactly one function.\tGive each exported function a different name.\t"]
    c += ["K0102\texport fn '*': parameter '*' needs a type annotation\tC callers must know every parameter's exact type, so an exported function cannot leave any untyped.\tWrite `{2}: int` (or the type it should have).\t"]
    c += ["K0103\texport fn '*': parameter '*' has type '*', which can't cross the C ABI*\tOnly machine-sized values can be passed to C directly: int and sized ints, bool, float, f32, string, or an `extern type` handle. Arrays and Komodo structs have a layout C does not know.\tUse one of the supported types.\t"]
    c += ["K0104\texport fn '*' cannot have default parameter values*\tC has no default arguments: a C caller always passes every argument.\tRemove the default values.\t"]
    c += ["K0105\texport fn '*': return type '*' can't cross the C ABI*\tOnly machine-sized values can be returned to C directly: int and sized ints, bool, float, f32, string, or an `extern type` handle.\tReturn one of the supported types.\t"]
    c += ["K0106\textern*: character '*' is not allowed in the C symbol \"*\"\tThe name after `=` is handed to the linker as a C symbol, and C identifiers may only contain letters, digits and underscores.\tUse a valid C identifier, for example \"my_name\".\t"]
    c += ["K0107\textern '*': the C symbol \"*\" cannot start with a digit\tC identifiers cannot start with a digit.\tStart the symbol with a letter or an underscore.\t"]
    c += ["K0108\textern variable '*': type '*' is not supported*\tAn `extern let` names a C global, and only machine-sized types can be read from one directly.\tUse int, sized ints, bool, float, f32, string or an `extern type` handle.\t"]
    c += ["K0109\t'*' cannot be a C callback: parameter type '*' is not a plain machine word\tA Komodo function passed to C is called by C code, so its parameters must be plain machine words or doubles.\tChange the parameter to int, bool, float or a handle.\t"]
    c += ["K0110\t'*' cannot be a C callback: return type '*' is not a plain machine word\tC code calling back into Komodo expects a plain machine word or double as the result.\tReturn int, bool, float or a handle.\t"]
    c += ["K0111\t`export` needs a free function with a body: '*'\t`export fn` publishes Komodo code to C, so it needs a body. To use a C function from Komodo, write `extern fn` instead.\tAdd a body, or use `extern fn` to declare a C function.\t"]
    c += ["K0112\textern variable '*' needs a type*\tKomodo cannot read the type of a C global, so an `extern let` must say it.\tWrite `extern let {1}: int`.\t"]
    c += ["K0113\texpected a string literal after `=` (the C symbol name) in extern*\t`extern fn name(...) = \"c_symbol\"` binds a Komodo name to a C symbol, and the symbol is written as a string literal.\tPut the C symbol in quotes after the `=`.\t"]
    c += ["K0114\texport fn is not supported on target '*' yet*\tExporting Komodo functions to C is implemented by the x86 backend only.\tBuild with the default x86 target.\t"]
    c += ["K0120\tno overload of '*' takes * argument(s)\t'{1}' has several definitions, but none of them accepts {2} argument(s).\tCall it with the number of arguments one of the overloads declares.\t"]
    c += ["K0121\tambiguous overloaded call to '*'\tMore than one overload of '{1}' fits these arguments equally well, so the compiler cannot choose.\tMake the argument types more specific.\t"]
    c += ["K0122\tno overload of '*' matches the argument types\t'{1}' has several definitions, but none of them accepts arguments of these types.\tConvert the arguments, or add an overload for these types.\t"]
    c += ["K0123\tduplicate function '*' — two overloads have identical parameter types\tOverloads are chosen by their parameter types, so two definitions with the same parameter types could never be told apart.\tChange a parameter type, or rename one function.\t"]
    c += ["K0130\tuse of moved value '*' — *\tA `unique` value has exactly one owner. Binding it to another name, or passing it on, moves ownership, and the old name is left with nothing.\tUse the new owner, or `copy(x)` to keep a second value.\t"]
    c += ["K0131\tcannot move `unique` value out of '*' — it is not a locally owned binding\tOnly a variable that owns the value can give it away. Parameters and globals do not own theirs.\tUse `copy(x)` instead, or take ownership with a local `let`.\t"]
    c += ["K0132\tcannot move `unique` value of type '*' out of field '*' — *\tA field is owned by the struct that holds it. Taking it out would leave the struct with a hole.\tMove the whole owning value, or use `copy(...)`.\t"]
    c += ["K0133\tcannot move `unique` value of type '*' out of an array element\tAn array owns its elements, so one cannot be taken out and leave a hole behind.\tUse `copy(...)` to get a second value.\t"]
    c += ["K0140\tstruct pattern '*(…)' used on non-struct subject of type '*'\t`case Type(field: ...)` takes a struct apart, so the value being matched must itself be a struct.\tMatch on a struct value, or use plain `case` values.\t"]
    c += ["K0141\tstruct pattern type '*' is unrelated to subject type '*'\tA pattern can only match a type that the subject can actually be: the same struct, or a struct that extends it.\tUse a pattern type related to '{2}'.\t"]
    c += ["K0142\tfield '*' named twice in pattern '*'\tEach field can be matched once in a pattern.\tRemove the duplicate.\t"]
    c += ["K0143\tstruct pattern cannot match on `float` field '*' yet\tExact comparison of floating-point values is rarely what you want, so patterns do not support it yet.\tBind the field to a name and compare it in an `if`.\t"]
    c += ["K0144\tpattern for field '*': literal of type '*' is not comparable to field type '*'\tA literal in a pattern is compared with the field's value, so the two must have the same type.\tUse a literal of the field's type.\t"]
    c += ["K0145\tcannot destructure the opaque handle type '*' in a pattern\tAn `extern type` handle is a pointer owned by C code. Komodo cannot see inside it.\tPass the handle to a C function instead.\t"]
    c += ["K0146\tmatch on enum '*' is not exhaustive — missing: *\tUnder `--strict`, a `match` on an enum must name every variant or end with `else`, so adding a variant later cannot slip through unhandled.\tAdd a `case` for {2}, or an `else` branch.\tblock"]
    c += ["K0160\tunreachable code\tThe statement follows a `return`, `break`, `continue` or `throw`, so it can never run. It is usually a leftover or a mistake.\tDelete it, or move it before the jump.\t"]
    c += ["K0161\tself-assignment of '*' has no effect\tAssigning a variable to itself changes nothing, so it is nearly always a typo for a different name.\tCheck which variable you meant to assign.\t"]
    c += ["K0162\t`if` condition is always *\tThe condition is a literal that is always true or always false, so one branch can never run.\tRemove the `if`, or use a real condition.\t"]
    c += ["K0163\tdivision by zero\tDividing by a literal zero fails at run time.\tDivide by a non-zero value.\t"]
    c += ["K0164\t'*' compares a value with itself\tComparing a value with itself always gives the same answer, so it is almost always a typo.\tCompare against a different value.\t"]
    c += ["K0165\t'*' is declared but never used\tUnder `--strict`, a local that is never read is reported: it is usually a leftover or a misspelt name.\tUse '{1}', or delete it.\t"]
    c += ["K0166\tparameter '*' has no type annotation (implicit any)\tUnder `--strict`, method parameters must say their type, so mistakes are caught where the method is called.\tWrite `{1}: int` (or the type it should have).\t"]
    c += ["K0167\t`mut *` has no mutating code — could be `fn` or `void`\t`mut` says a function changes something, but this one changes nothing. A plain `fn` is a stronger promise to its callers.\tDeclare it `fn`.\t"]
    c += ["K0168\t'*' has no type annotation and no initialiser\tWith neither a type nor a starting value, the compiler cannot tell what the variable holds.\tWrite `let {1}: int` or `let {1} = 0`.\t"]
    c += ["K0169\t'*' is already declared in this function; this `let` reuses it\tKomodo locals are function-scoped, so a second `let {1}` in an inner block does not make a new variable: it assigns the existing one, and the new value is still there after the block.\tGive the inner variable a different name, or drop `let` if reassigning '{1}' is intended.\t"]
    c += ["K0170\tcomparison with a bool literal; use the value or `not` directly\t`x == true` is the same as `x`, and `x == false` is the same as `not x`; the longer form only adds noise.\tWrite the bool value itself, or `not` it.\t"]
    c += ["K0180\tunexpected 'else': a one-line `if c then X else Y` is not supported*\tThe one-line `if c then X` form takes no `else`, to keep the grammar unambiguous.\tWrite the branches on separate indented lines.\t"]
    c += ["K0181\ta range `a to b` is only valid in a `for` loop or a slice, not as a value\tRanges are syntax for `for` headers and slices such as `a[1:3]`. They are not values you can store.\tUse `for i = a to b`, or make an array with `[a, b]`.\t"]
    c += ["K0182\t'?' applies to calls, not indexing\tA trailing `?` catches an error thrown by a call. Indexing is not a call.\tCheck `#a` first, or wrap the indexing in a function and call that with `?`.\t"]
    c += ["K0183\t'?' applies to calls and `new` expressions only\tA trailing `?` catches an error thrown by a call or a `new`, and gives `null` instead.\tRemove the `?`, or apply it to a call.\t"]
    c += ["K0184\tstruct bodies hold fields only; use a class for methods\tA `struct` is plain data. Behaviour belongs in a `class`.\tChange `struct` to `class`, or move the method into a free function.\t"]
    c += ["K0185\t`link` may only be used inside a module*\t`link` tells the linker about a C library, and that declaration belongs in a module file (`.kmm` starting with `module name`).\tMove the `link` line into a module file.\t"]
    c += ["K0186\texpected `case` or `else` in match, got *\tInside a `match`, the indented lines must be `case` arms or a final `else`.\tStart each arm with `case value`.\t"]
    c += ["K0187\tunexpected '*'*\tThe parser found a token that cannot start or continue an expression or statement at this position.\tCheck the line for a missing operator, a stray character or a wrong indent.\t"]
    c += ["K0188\tUnexpected top-level token*\tOnly declarations (`fn`, `void`, `mut`, `struct`, `class`, `enum`, `let`, `import`, `extern`, `link`) may appear at the top of a file.\tCheck for a stray character, or an indent that closed the function too early.\t"]
    c += ["K0189\texpected `struct` or `class` after type modifier\t`abstract` and `unique` modify a struct or class declaration, so one must follow.\tWrite `abstract struct Name` or `unique struct Name`.\t"]
    c += ["K0190\tmethod defined for unknown class '*'\tA method written as `Class::name` or in a class body needs the class to be declared.\tCheck the class name, or declare the class.\t"]
    c += ["K0191\tunknown target '*'*\tThe compiler can generate code for the targets x86, stackvm, c and wasm only.\tPass one of: x86, stackvm, c, wasm.\t"]
    c += ["K0200\t*not supported yet*\tThe program is valid Komodo, but the chosen target backend cannot generate code for this feature yet. The x86 backend supports all of the language.\tBuild with the default x86 target.\t"]
    c += ["K0201\tinternal: *\tThe compiler reached a state it believes is impossible. This is a bug in the compiler, not in your program.\tPlease report it with the smallest program that triggers it.\t"]
    return c
