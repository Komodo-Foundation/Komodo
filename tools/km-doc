def e(text):
    return html.escape(text, quote=True)


def html_page(title, body, search=False):
    search_box = ('<input type="search" id="q" placeholder="Search names" '
                  'aria-label="Search names">') if search else ''
    return ('<!doctype html>\n<html lang="en">\n<head>\n<meta charset="utf-8">\n'
            '<meta name="viewport" content="width=device-width,initial-scale=1">\n'
            '<title>%s</title>\n<style>%s</style>\n</head>\n<body>\n%s%s\n'
            '<script>%s</script>\n</body>\n</html>\n') % (
                e(title), CSS, search_box, body, JS if search else '')


def html_sig(sig, own, mod, ctx):
    """Escaped signature with type names linked to their entries."""
    out = []
    pos = 0
    for m in TOKEN_RE.finditer(sig):
        out.append(e(sig[pos:m.start()]))
        tok = m.group(0)
        target = ctx.href(tok, mod) if tok != own else None
        if target:
            out.append('<a href="%s">%s</a>' % (e(target), e(tok)))
        else:
            out.append(e(tok))
        pos = m.end()
    out.append(e(sig[pos:]))
    return ''.join(out)


def html_doc(text):
    parts = re.split(r'`([^`]+)`', text)
    out = []
    for i, part in enumerate(parts):
        out.append('<code>%s</code>' % e(part) if i % 2 else e(part))
    return ''.join(out)


def html_entry(it, mod, ctx, tag):
    search = ' '.join([it.name, it.kind, mod.name, it.doc]).lower()
    out = ['<section class="sym" id="%s" data-s="%s">' % (e(it.anchor), e(search)),
           '<%s>%s</%s>' % (tag, e(it.name), tag)]
    if it.kind not in ('field', 'variant'):
        out.append('<pre>%s</pre>' % html_sig(it.sig, it.name, mod, ctx))
    if it.doc:
        out.append('<p class="doc">%s</p>' % html_doc(it.doc))
    out.append('</section>')
    return out


def html_type(it, mod, ctx):
    search = ' '.join([it.name, it.kind, mod.name, it.doc]).lower()
    out = ['<section class="sym" id="%s" data-s="%s">' % (e(it.anchor), e(search)),
           '<h2>%s</h2>' % e(it.name), '<pre>%s</pre>' % html_sig(it.sig, it.name, mod, ctx)]
    facts = []
    if it.parent:
        target = ctx.href(it.parent, mod)
        if target:
            facts.append('Extends <a href="%s">%s</a>.' % (e(target), e(it.parent)))
        else:
            facts.append('Extends %s.' % e(it.parent))
    subs = ctx.subtypes.get(it.name, [])
    if subs:
        links = []
        for m, sit in subs:
            href = ('#' + sit.anchor) if m is mod else page_name(m, 'html') + '#' + sit.anchor
            links.append('<a href="%s">%s</a>' % (e(href), e(sit.name)))
        facts.append('Subtypes: ' + ', '.join(links) + '.')
    if it.kind == 'enum':
        facts.append('Variants are written <code>%s::Name</code>.' % e(it.name))
    if it.abstract:
        facts.append('Abstract: it cannot be instantiated.')
    if facts:
        out.append('<p class="meta">%s</p>' % ' '.join(facts))
    if it.doc:
        out.append('<p class="doc">%s</p>' % html_doc(it.doc))
    fields = [c for c in it.children if c.kind == 'field']
    variants = [c for c in it.children if c.kind == 'variant']
    members = [c for c in it.children if c.kind in ('ctor', 'method')]
    if fields:
        out.append('<h3>Fields</h3><ul class="sub">')
        for c in fields:
            out.append('<li id="%s" data-s="%s"><code>%s</code>%s</li>' % (
                e(c.anchor), e((it.name + ' ' + c.name + ' ' + c.doc).lower()), e(c.sig),
                (' &mdash; ' + html_doc(c.doc)) if c.doc else ''))
        out.append('</ul>')
    if variants:
        out.append('<h3>Variants</h3><ul class="sub">')
        for c in variants:
            out.append('<li id="%s" data-s="%s"><code>%s</code>%s</li>' % (
                e(c.anchor), e((it.name + ' ' + c.name + ' ' + c.doc).lower()), e(c.name),
                (' &mdash; ' + html_doc(c.doc)) if c.doc else ''))
        out.append('</ul>')
    for c in members:
        out.extend(html_entry(c, mod, ctx, 'h4'))
    out.append('</section>')
    return out


def html_module(mod, ctx):
    body = ['<p><a href="index.html">&larr; All modules</a></p>',
            '<h1><code>%s</code></h1>' % e(mod.name)]
    if mod.doc:
        body.append('<p class="doc">%s</p>' % html_doc(mod.doc))
    body.append('<p class="meta">Source: <code>%s</code></p>' % e(mod.path))
    for title, kinds in GROUPS:
        group = [it for it in mod.items if it.kind in kinds]
        if not group:
            continue
        body.append('<h2>%s</h2>' % title)
        for it in group:
            if it.kind in TYPE_KINDS:
                body.extend(html_type(it, mod, ctx))
            else:
                body.extend(html_entry(it, mod, ctx, 'h3'))
    return html_page(mod.name + ' - Komodo API', '\n'.join(body), search=True)


def html_index(mods, ctx):
    body = ['<h1>Komodo API reference</h1>',
            '<p class="meta">One page per module. Private members are not listed. '
            'Type in the box to filter the symbol list.</p>',
            '<h2>Modules</h2>', '<ul class="sub">']
    for mod in mods:
        summary = (' &mdash; ' + html_doc(first_sentence(mod.doc))) if mod.doc else ''
        body.append('<li><a href="%s"><code>%s</code></a>%s</li>' % (
            e(page_name(mod, 'html')), e(mod.name), summary))
    body.append('</ul><h2>All public symbols</h2><ul class="sub">')
    for mod in mods:
        for it in mod.items:
            label = it.name
            body.append('<li data-s="%s"><a href="%s#%s"><code>%s</code></a> <span class="meta">%s, %s</span></li>' % (
                e((it.name + ' ' + it.kind + ' ' + mod.name).lower()), e(page_name(mod, 'html')),
                e(it.anchor), e(label), e(it.kind), e(mod.name)))
            for c in it.children:
                body.append('<li data-s="%s"><a href="%s#%s"><code>%s</code></a> <span class="meta">%s, %s</span></li>' % (
                    e((c.name + ' ' + it.name + ' ' + mod.name).lower()), e(page_name(mod, 'html')),
                    e(c.anchor), e(it.name + '.' + c.name), e(c.kind), e(mod.name)))
    body.append('</ul>')
    return html_page('Komodo API reference', '\n'.join(body), search=True)


# -------------------------------------------------------------------- main

def write(path, text):
    with open(path, 'w', encoding='utf-8') as fh:
        fh.write(text)


def main(argv=None):
    ap = argparse.ArgumentParser(
        prog='km-doc',
        description='Generate API reference pages for Komodo modules.')
    ap.add_argument('-o', '--out', default='doc', metavar='outdir',
                    help='output directory (default: ./doc)')
    ap.add_argument('--format', choices=('md', 'html'), default='md',
                    help='page format (default: md)')
    ap.add_argument('paths', nargs='+', help='.kmm/.km files or directories')
    args = ap.parse_args(argv)

    modules = []
    names = {}
    try:
        files = discover(args.paths)
    except IOError as err:
        sys.stderr.write('km-doc: %s\n' % err)
        return 1
    for path in files:
        try:
            mod = load_module(path)
        except (IOError, OSError) as err:
            sys.stderr.write('km-doc: cannot read %s: %s\n' % (path, err))
            return 1
        if mod.name in names:
            sys.stderr.write('km-doc: warning: module %s from %s repeats %s; skipped\n'
                             % (mod.name, path, names[mod.name]))
            continue
        names[mod.name] = path
        modules.append(mod)
    modules.sort(key=lambda m: m.name)
    if not modules:
        sys.stderr.write('km-doc: no modules found\n')
        return 1

    ctx = Context(modules, args.format)
    os.makedirs(args.out, exist_ok=True)
    for mod in modules:
        fname = os.path.join(args.out, page_name(mod, args.format))
        if args.format == 'html':
            write(fname, html_module(mod, ctx))
        else:
            write(fname, md_module(mod, modules, ctx))
    if args.format == 'html':
        write(os.path.join(args.out, 'index.html'), html_index(modules, ctx))
    else:
        write(os.path.join(args.out, 'index.md'), md_index(modules, ctx))
    return 0


if __name__ == '__main__':
    sys.exit(main())
