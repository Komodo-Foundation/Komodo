{
  "main": {
    "prefix": "main",
    "description": "Program entry point",
    "body": [
      "import console",
      "",
      "void main()",
      "    console.print(\"$1\")"
    ]
  },
  "class": {
    "prefix": "class",
    "description": "Class with constructor and a method",
    "body": [
      "class ${1:Name}",
      "    constructor(${2:value}: ${3:int})",
      "        m_${2:value} = ${2:value}",
      "",
      "    fn ${4:get}(): ${3:int}",
      "        return m_${2:value}",
      "",
      "    m_${2:value}: ${3:int}"
    ]
  },
  "for": {
    "prefix": "for",
    "description": "Counted loop over a range",
    "body": [
      "for ${1:i} = ${2:0} to ${3:9}",
      "    $0"
    ]
  },
  "forin": {
    "prefix": "forin",
    "description": "Loop over an array",
    "body": [
      "for ${1:x} in ${2:xs}",
      "    $0"
    ]
  },
  "match": {
    "prefix": "match",
    "description": "match with cases and an else",
    "body": [
      "match ${1:value}",
      "    case ${2:Case}",
      "        $0",
      "    else",
      "        "
    ]
  },
  "fn": {
    "prefix": "fn",
    "description": "Pure function (may not change its arguments)",
    "body": [
      "fn ${1:name}(${2:x}: ${3:int}): ${4:int}",
      "    return $0"
    ]
  },
  "if": {
    "prefix": "if",
    "description": "if / else on separate lines",
    "body": [
      "if ${1:cond} then",
      "    $2",
      "else",
      "    $0"
    ]
  },
  "while": {
    "prefix": "while",
    "description": "While loop",
    "body": [
      "while ${1:cond}",
      "    $0"
    ]
  },
  "ifelse": {
    "prefix": "ifelse",
    "description": "if / else",
    "body": [
      "if ${1:cond}",
      "    $2",
      "else",
      "    $0"
    ]
  },
  "fnvoid": {
    "prefix": "void",
    "description": "Function with no return value",
    "body": [
      "void ${1:name}(${2})",
      "    $0"
    ]
  },
  "mut": {
    "prefix": "mut",
    "description": "Mutating method",
    "body": [
      "mut ${1:name}(${2})",
      "    $0"
    ]
  },
  "struct": {
    "prefix": "struct",
    "description": "Struct",
    "body": [
      "struct ${1:Name}",
      "    ${2:field}: ${3:int}$0"
    ]
  },
  "enum": {
    "prefix": "enum",
    "description": "Enum",
    "body": [
      "enum ${1:Name}",
      "    ${2:First}",
      "    ${3:Second}$0"
    ]
  },
  "module": {
    "prefix": "module",
    "description": "Module file (.kmm) with public and private sections",
    "body": [
      "module ${1:name}",
      "",
      "public",
      "    fn ${2:hello}(): ${3:string}",
      "        $0",
      "",
      "private",
      "    fn ${4:helper}()",
      "        return"
    ]
  },
  "import": {
    "prefix": "import",
    "description": "Import a module",
    "body": [
      "import ${1:console}"
    ]
  },
  "macro": {
    "prefix": "letbe",
    "description": "Compile-time macro",
    "body": [
      "let ${1:NAME} be ${2:value}"
    ]
  },
  "constructor": {
    "prefix": "constructor",
    "description": "Class constructor",
    "body": [
      "constructor(${1:value}: ${2:int})",
      "    m_${1:value} = ${1:value}"
    ]
  },
  "protected": {
    "prefix": "try",
    "description": "Protected call: null on error",
    "body": [
      "let ${1:result} = ${2:call}()?",
      "if ${1:result} == null then",
      "    $0"
    ]
  },
  "test": {
    "prefix": "test",
    "description": "Test file body (name it *_test.km)",
    "body": [
      "void main()",
      "    assert(${1:1 + 1 == 2}, \"${2:arithmetic works}\")$0"
    ]
  }
}
