{
  "main": {
    "prefix": "main",
    "description": "Program entry point",
    "body": [
      "import console",
      "",
      "void main()",
      "    console.print(\"$1\")"
    ]
  },
  "class": {
    "prefix": "class",
    "description": "Class with constructor and a method",
    "body": [
      "class ${1:Name}",
      "    constructor(${2:value}: ${3:int})",
      "        m_${2:value} = ${2:value}",
      "",
      "    fn ${4:get}(): ${3:int}",
      "        return m_${2:value}",
      "",
      "    m_${2:value}: ${3:int}"
    ]
  },
  "for": {
    "prefix": "for",
    "description": "Counted loop over a range",
    "body": [
      "for ${1:i} = ${2:0} to ${3:9}",
      "    $0"
    ]
  },
  "forin": {
    "prefix": "forin",
    "description": "Loop over an array",
    "body": [
      "for ${1:x} in ${2:xs}",
      "    $0"
    ]
  },
  "match": {
    "prefix": "match",
    "description": "match with cases and an else",
    "body": [
      "match ${1:value}",
      "    case ${2:Case}",
      "        $0",
      "    else",
      "        "
    ]
  },
  "fn": {
    "prefix": "fn",
    "description": "Pure function (may not change its arguments)",
    "body": [
      "fn ${1:name}(${2:x}: ${3:int}): ${4:int}",
      "    return $0"
    ]
  },
  "if": {
    "prefix": "if",
    "description": "if / else on separate lines",
    "body": [
      "if ${1:cond} then",
      "    $2",
      "else",
      "    $0"
    ]
  }
}
