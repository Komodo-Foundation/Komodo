{
  "name": "Komodo Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#08090a",
    "editor.foreground": "#d6dcd7",
    "editorLineNumber.foreground": "#3a403c",
    "editorLineNumber.activeForeground": "#8a948d",
    "editorCursor.foreground": "#6fff0f",
    "editor.selectionBackground": "#1f3a14",
    "editor.lineHighlightBackground": "#101211",
    "editorIndentGuide.background1": "#161a17",
    "editorIndentGuide.activeBackground1": "#2a322c",
    "activityBar.background": "#050606",
    "sideBar.background": "#050606",
    "statusBar.background": "#050606",
    "statusBar.foreground": "#8a948d",
    "statusBar.debuggingBackground": "#6fff0f",
    "statusBar.debuggingForeground": "#08090a",
    "tab.activeBackground": "#08090a",
    "tab.inactiveBackground": "#050606",
    "button.background": "#6fff0f",
    "button.foreground": "#08090a",
    "focusBorder": "#6fff0f"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7d8a80",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "comment.line.double-slash.documentation",
        "comment.block.doc",
        "comment.block.documentation.komodo"
      ],
      "settings": {
        "foreground": "#8f9a86",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.other.todo",
        "comment.line.todo",
        "keyword.codetag",
        "storage.type.class.todo",
        "comment keyword.todo"
      ],
      "settings": {
        "foreground": "#6fff0f",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.import",
        "keyword.control.return",
        "keyword.control.komodo"
      ],
      "settings": {
        "foreground": "#ff6b6b"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.declaration",
        "keyword.other.komodo",
        "storage.modifier.komodo",
        "storage.type.komodo"
      ],
      "settings": {
        "foreground": "#ff8fc8"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator.key-value",
        "punctuation.accessor",
        "keyword.operator.komodo"
      ],
      "settings": {
        "foreground": "#c4b5a5"
      }
    },
    {
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.word",
        "keyword.operator.logical.word",
        "keyword.operator.word.komodo"
      ],
      "settings": {
        "foreground": "#ff8fc8"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call entity.name.function",
        "support.function",
        "variable.function",
        "entity.name.function.call.komodo",
        "support.function.builtin.komodo"
      ],
      "settings": {
        "foreground": "#ffd866"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.interface",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "storage.type.builtin",
        "entity.name.type.komodo",
        "support.type.komodo"
      ],
      "settings": {
        "foreground": "#4fd6be"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.package",
        "support.module",
        "storage.modifier.import",
        "storage.modifier.package",
        "entity.name.namespace.komodo"
      ],
      "settings": {
        "foreground": "#c8c08a"
      }
    },
    {
      "scope": [
        "variable.other.member",
        "variable.other.property",
        "variable.other.object.property",
        "meta.member",
        "entity.name.field",
        "support.variable.property",
        "variable.other.member.komodo"
      ],
      "settings": {
        "foreground": "#e8d8c0"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "support.variable"
      ],
      "settings": {
        "foreground": "#d6dcd7"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameter variable"
      ],
      "settings": {
        "foreground": "#ffb37a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.self.komodo"
      ],
      "settings": {
        "foreground": "#ff8fc8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex"
      ],
      "settings": {
        "foreground": "#d4a0ff"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language",
        "constant.other",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember",
        "entity.name.constant",
        "constant.language.komodo"
      ],
      "settings": {
        "foreground": "#d4a0ff"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#f3b27a"
      }
    },
    {
      "scope": [
        "constant.character",
        "constant.character.escape",
        "constant.other.placeholder",
        "string.regexp",
        "punctuation.definition.template-expression",
        "constant.character.escape.komodo"
      ],
      "settings": {
        "foreground": "#ff9f5a",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#ff6b6b"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#ffb37a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "support.type.property-name.json",
        "meta.object-literal.key",
        "meta.mapping.key string",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#4fd6be"
      }
    },
    {
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "meta.annotation",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#ff9f5a"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section",
        "markup.heading punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#ff8fc8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "markup.link",
        "string.other.link",
        "meta.link"
      ],
      "settings": {
        "foreground": "#4fd6be"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw",
        "fenced_code.block.language"
      ],
      "settings": {
        "foreground": "#f3b27a"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#ffd866",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#e8d8c0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.quote",
        "punctuation.definition.list",
        "beginning.punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#c8c08a"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#8fe07a"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#ff6b6b"
      }
    },
    {
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "foreground": "#ffd866"
      }
    },
    {
      "scope": [
        "meta.diff.range",
        "meta.diff.header",
        "meta.separator"
      ],
      "settings": {
        "foreground": "#d4a0ff",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff4d4d",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ff9f5a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.section",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#a89f95"
      }
    }
  ]
}
