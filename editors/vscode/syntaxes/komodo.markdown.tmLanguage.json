{
  "scopeName": "markdown.komodo.codeblock",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [{ "include": "#komodo-code-block" }],
  "repository": {
    "komodo-code-block": {
      "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(km|kmm|komodo)(\\s+[^`~]*)?$)",
      "name": "markup.fenced_code.block.markdown",
      "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
      "beginCaptures": {
        "3": { "name": "punctuation.definition.markdown" },
        "4": { "name": "fenced_code.block.language.markdown" }
      },
      "endCaptures": {
        "3": { "name": "punctuation.definition.markdown" }
      },
      "patterns": [
        {
          "begin": "(^|\\G)(\\s*)(.*)",
          "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
          "contentName": "meta.embedded.block.komodo",
          "patterns": [{ "include": "source.komodo" }]
        }
      ]
    }
  }
}
