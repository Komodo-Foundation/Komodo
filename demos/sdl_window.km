// Calling a real C library (SDL2) straight from Komodo through the
// `sdl2` module — an ordinary Komodo import, not a special case.
//
// Build & run:
//   komodo demos/sdl_window.km
//
// No `-lSDL2` on the command line: `stdlib/sdl2.kmm` declares
// `link SDL2` (a real keyword, valid only inside a module), and `komodo`
// links it automatically. Only the shared library needs to be installed,
// not the -dev headers. Write the same kind of file — `extern fn`
// prototypes + one `link` line — to wire up any other C library the same
// way; see stdlib/sdl2.kmm and docs/language/reference.md's "Standard library" section.
//
// Opens an 800x600 window and runs a real event loop — pumping SDL_Event
// records through a Komodo array with `data()` — until the window is
// closed or a key is pressed.

import sdl2

extern fn puts(s: string): int

void main()
    if sdl2::SDL_Init(SDL_INIT_VIDEO) != 0 then
        puts("SDL_Init failed")
        return

    let window = SDL_CreateWindow("Komodo + SDL2", SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, 800, 600, SDL_WINDOW_SHOWN)
    if window == 0 then
        puts("CreateWindow failed")
        SDL_Quit()
        return

    let renderer = SDL_CreateRenderer(window, 0 - 1, 0)

    // SDL_Event is 56 bytes; 8 int slots (64 B) is room to spare.
    let ev: [int] = [0, 0, 0, 0, 0, 0, 0, 0]
    let running = 1
    let frame = 0

    while running == 1 do
        while SDL_PollEvent(data(ev)) == 1 do
            let kind = ev[0] & 4294967295          // low 32 bits = event type
            if kind == SDL_EVENT_QUIT or kind == SDL_EVENT_KEYDOWN then
                running = 0

        // also bail after ~5s so the demo ends on a headless box
        if frame > 300 then
            running = 0

        // pulse the background colour so the window is visibly alive
        let g = frame % 256
        SDL_SetRenderDrawColor(renderer, 20, g, 170, 255)
        SDL_RenderClear(renderer)
        SDL_RenderPresent(renderer)
        SDL_Delay(16)
        frame = frame + 1

    SDL_DestroyRenderer(renderer)
    SDL_DestroyWindow(window)
    SDL_Quit()
    puts("closed cleanly")
