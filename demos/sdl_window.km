// Calling a real C library (SDL2) straight from Komodo through `extern fn`.
//
// Build & run (only the shared library is needed, not the -dev headers):
//   ./build.sh demos/sdl_window.km x86 ./sdl_window  -lSDL2
//
// Opens an 800x600 window and runs a real event loop — pumping SDL_Event
// records through a Komodo array with `data()` — until the window is
// closed or a key is pressed.
//
// `extern fn` uses the native C ABI: ints/pointers in rdi..r9, floats in
// xmm0..7, the rest spill to the stack, float results come back in xmm0.
// `data(arr)` yields an array's element pointer for writable C buffers.

extern fn SDL_Init(flags: int): int
extern fn SDL_CreateWindow(title: string, x: int, y: int, w: int, h: int, flags: int): int
extern fn SDL_CreateRenderer(window: int, index: int, flags: int): int
extern fn SDL_SetRenderDrawColor(renderer: int, r: int, g: int, b: int, a: int): int
extern fn SDL_RenderClear(renderer: int): int
extern void SDL_RenderPresent(renderer: int)
extern fn SDL_PollEvent(event: int): int
extern void SDL_Delay(ms: int)
extern void SDL_DestroyRenderer(renderer: int)
extern void SDL_DestroyWindow(window: int)
extern void SDL_Quit()

extern fn puts(s: string): int

let SDL_INIT_VIDEO be 32
let CENTERED be 805240832        // SDL_WINDOWPOS_CENTERED
let SHOWN be 4                   // SDL_WINDOW_SHOWN
let SDL_QUIT be 256              // 0x100
let SDL_KEYDOWN be 768           // 0x300

void main()

    if SDL_Init(SDL_INIT_VIDEO) != 0 then
        puts("SDL_Init failed")
        return

    let window = SDL_CreateWindow("Komodo + SDL2", CENTERED, CENTERED, 800, 600, SHOWN)
    if window == 0 then
        puts("CreateWindow failed")
        SDL_Quit()
        return

    let renderer = SDL_CreateRenderer(window, 0 - 1, 0)

    // SDL_Event is 56 bytes; 8 int slots (64 B) is room to spare.
    let ev: [int] = [0, 0, 0, 0, 0, 0, 0, 0]
    let running = 1
    let frame = 0

    while running == 1 do
        while SDL_PollEvent(data(ev)) == 1 do
            let kind = ev[0] & 4294967295          // low 32 bits = event type
            if kind == SDL_QUIT or kind == SDL_KEYDOWN then
                running = 0

        // also bail after ~5s so the demo ends on a headless box
        if frame > 300 then
            running = 0

        // pulse the background colour so the window is visibly alive
        let g = frame % 256
        SDL_SetRenderDrawColor(renderer, 20, g, 170, 255)
        SDL_RenderClear(renderer)
        SDL_RenderPresent(renderer)
        SDL_Delay(16)
        frame = frame + 1

    SDL_DestroyRenderer(renderer)
    SDL_DestroyWindow(window)
    SDL_Quit()
    puts("closed cleanly")
