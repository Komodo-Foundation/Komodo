// Passing a Komodo function to C as a native callback.
// (c: skip — C callbacks need the native trampoline; the c target lacks it.)
// (wasm: skip — C callbacks are not supported by the wasm target.)
//
// `atexit` is plain libc — no library to link, no companion C file.  The
// compiler emits a System V ABI trampoline for `farewell` and hands its
// address to `atexit`; the C runtime calls it back after `main` returns.

import console

extern fn atexit(callback: int): int

void farewell()
    console.print("farewell, from a Komodo callback")

void main()
    atexit(farewell)
    console.print("main running")
