// Direct calls to free functions: up to six arguments, floats, nested
// calls in argument position, recursion, and an overload pair.
import console

fn sum6(a: int, b: int, c: int, d: int, e: int, f: int): int
    return a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6

fn scale(x: float, k: int): float
    return x * k

fn fib(n: int): int
    if n < 2 then
        return n
    return fib(n - 1) + fib(n - 2)

fn twice(x: int): int
    return x + x

fn twice(s: string): string
    return s + s

fn pick(flag: bool, a: int, b: int): int
    if flag then
        return a
    return b

void main()
    console.print(sum6(1, 2, 3, 4, 5, 6))
    console.print(sum6(twice(1), twice(2), twice(3), twice(4), twice(5), twice(6)))
    console.print(scale(1.5, 4))
    console.print(fib(20))
    console.print(twice("ab"))
    console.print(pick(true, fib(5), 99))
    console.print(pick(false, 1, sum6(0, 0, 0, 0, 0, 1)))
