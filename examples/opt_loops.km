// Optimizer: code after a `while true` with no `break` is unreachable and
// may be dropped; a `while true` that does break must keep what follows.
// Output must be identical at -O none and -O max.

fn firstOver(limit: int): int
    let i = 0
    while true do
        i += 1
        if i * i > limit then
            return i
    return 0

fn countUntil(stop: int): int
    let i = 0
    while true do
        i += 1
        if i == stop then
            break
    return i

fn main()
    print(firstOver(50))
    print(countUntil(5))
    let total = 0
    let k = 0
    while k < 4 do
        total += k
        k += 1
    print(total)
