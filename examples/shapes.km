// Shapes as structs under one abstract base.  `match` picks the case by
// runtime type and binds fields by name, with literal patterns to
// narrow a case.  An untyped (generic) helper works on any numeric
// type the call site passes.

import console

abstract struct Shape
struct Circle : Shape
    r: int
struct Rect : Shape
    w: int
    h: int

// pi is approximated as 3, as in the other demos.
fn area(s: Shape) : int
    match s
        case Circle(r)
            return 3 * r * r
        case Rect(w, h)
            return w * h
    return 0

void report(s: Shape)
    match s
        case Circle(r: 0)
            console.print("a point, no circle")
        case Circle(r)
            console.print("circle, radius", r)
        case Rect(w, h)
            console.print("rect", w, "x", h)

// Untyped parameters make this a template: one copy per argument type.
fn larger(a, b)
    if a > b then
        return a
    return b

void main()
    let shapes = [new Circle(0), new Circle(2), new Rect(3, 5)]
    let biggest = 0
    for s in shapes
        report(s)
        biggest = larger(biggest, area(s))
    console.print("largest area:", biggest)
    console.print("larger floats:", larger(2.5, 1.25))
