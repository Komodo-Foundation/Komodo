import file
import km_compiler

// Komodo compiler driver.
//
//   source + every module it reaches  ──▶ merge  ──▶ compile
//
// Module loading mirrors the interpreter: `import X` is resolved to
// `X.kmm` by searching the directory tree of the file being compiled
// (and, as a fallback, the compiler's own directory for the standard
// library); then *every* sibling `.km` / `.kmm` in that file's directory
// that declares the same `module` is pulled in too.  All resolved
// sources are concatenated into one translation unit — the parser
// tolerates the repeated `module` / `import` lines.

void main(args)
    let selfPath = args[0]
    let path = args[1]
    let fileName: string = path or throw "File name not provided"

    if not file::exists(fileName) then
        km_fail("error: file not found: " + fileName)

    // Trailing arguments, in any order:
    //   x86 | stackvm | c | wasm  code-generation target      (default x86)
    //   strict                   analyser lint-level checks   (default off)
    //   none | low | medium | max   optimisation level        (default none)
    let target = "x86"
    let strict = false
    let opt = "none"
    let ai = 2
    while ai < #args do
        let a = args[ai]
        if a == "x86" or a == "x86pic" or a == "stackvm" or a == "c" or a == "wasm" then
            target = a
        else if a == "header" then
            target = a              // C header for the `export fn`s -> <file>.h
        else if a == "strict" then
            strict = true
        else if a == "none" or a == "low" or a == "medium" or a == "max" then
            opt = a
        ai += 1

    // The standard library ships as `.kmm` declaration files under the
    // compiler's own directory (stdlib/console.kmm, …); probe that tree
    // so `import console` resolves no matter where the user's file is.
    // `file::find` walks recursively, so the executable's directory is
    // enough whether `stdlib/` is a subdirectory or holds kmc itself.
    let stdlibProbe = dirOf(selfPath) + "/probe.km"

    let gathered = gather(fileName, stdlibProbe)
    file::write_all(fileName + ".deps", join(gathered.deps, "\n"))
    file::write_all(fileName + ".links", join(gathered.links, "\n"))
    let compiled = km_compiler::compileMapped(gathered.source, target, strict, opt, gathered.deps, gathered.starts)?
    if compiled == null then
        // report as `file:line:col: error: …`, against the file the
        // problem is actually in rather than the merged unit
        let raw = km_error_message() or "compilation failed"
        km_fail(km_compiler::locate(errorLine(raw), gathered.deps, gathered.starts))
    let asm = compiled or ""          // km_fail above does not return

    let outputPath = fileName + ".asm"
    if target == "header" then
        outputPath = fileName + ".h"
    km_compiler::save(asm, outputPath)

extern void km_fail(msg: string)

// "3:7: msg" → "3:7: error: msg" (the position is mapped to its file
// afterwards); a message with no leading position becomes "error: msg".
fn errorLine(msg: string) : string
    let n = msg.length
    // a node synthesised by the compiler has no real position
    if n > 5 and msg[0 to 5] == "0:0: " then
        return "error: " + msg[5 to n]
    let i = 0
    let fields = 0
    while fields < 2 do
        let d = i
        while i < n and msg[i] >= "0" and msg[i] <= "9" do
            i += 1
        if i == d or i >= n or msg[i] != ":" then
            return "error: " + msg
        i += 1
        fields += 1
    if i < n and msg[i] == " " then
        return msg[0 to i] + " error: " + msg[(i + 1) to n]
    return "error: " + msg

// `gather`'s result: the merged source, the exact file list it was built
// from, and every `link` target declared across those files, already
// resolved to a ready linker token ("-lname", or a quoted path as-is).
struct GatherResult
    source: string
    deps: [string]
    links: [string]
    starts: [int]       // merged-source line at which each of `deps` begins

// Everything in `path` before the last "/".  "." when there is none.
fn dirOf(path: string) : string
    let cut = 0 - 1
    let i = 0
    while i < path.length do
        if path[i] == "/" then
            cut = i
        i += 1
    if cut < 0 then
        return "."
    return path[0 to cut]

// True when `s` ends with `suffix`.
fn endsWith(s: string, suffix: string) : bool
    if suffix.length > s.length then
        return false
    return s[(s.length - suffix.length) to s.length] == suffix

// A Komodo source file? (`.km` / `.kmm`)
fn isSource(name: string) : bool
    return endsWith(name, ".km") or endsWith(name, ".kmm")

// The name on the first `module <name>` line of `src`, or "".
fn moduleOf(src: string) : string
    let i = 0
    let lineStart = 0
    let n = src.length              // a strlen — measure once, not per char
    while i <= n do
        if i == n or src[i] == "\n" then
            let m = moduleOnLine(src[lineStart to i])
            if m != "" then
                return m
            lineStart = i + 1
        i += 1
    return ""

fn moduleOnLine(line: string) : string
    let a = 0
    while a < line.length and (line[a] == " " or line[a] == "\t") do
        a += 1
    let rest = line[a to line.length]
    if rest.length < 8 then
        return ""
    if rest[0 to 7] != "module " then
        return ""
    let b = 7
    while b < rest.length and rest[b] == " " do
        b += 1
    let s = b
    while s < rest.length and rest[s] != " " and rest[s] != "\r" and rest[s] != "\n" do
        s += 1
    return rest[b to s]

// Read `rootPath`, everything reachable from its `import` lines, and —
// for every module file pulled in — every sibling file declaring that
// same module (breadth-first, each file once).  Returns the sources
// joined, the exact file list that went into that (for `<rootPath>.deps`),
// and every `link` target declared across those files (for
// `<rootPath>.links`) — see `linkTargets` for what that keyword does and
// design.md's "Standard library" section for the full picture.
// `stdlibProbe` is a throwaway path inside the compiler's own directory,
// a second search root for the standard library.
fn gather(rootPath: string, stdlibProbe: string) : GatherResult
    let seen: [string] = []
    let queue: [string] = [rootPath]
    let parts: [string] = []        // joined once at the end (no O(n²) +)
    let starts: [int] = []
    let nextLine = 1
    let links: [string] = []
    // `module` name per file already scanned, so a sibling search does
    // not re-read and re-scan every file of the tree once per module file
    let modPaths: [string] = []
    let modNames: [string] = []

    while #queue > 0 do
        let p = queue[0]
        queue = queue[1 to #queue]
        if (p in seen) then
            continue
        seen += [p]

        let src = file::read_all(p)
        starts += [nextLine]
        nextLine += newlines(src) + 1   // + the "\n" that joins the parts
        parts += [src]

        // 1. follow `import` lines to other modules
        for name in importNames(src) do
            let resolved = file::find(name, rootPath)
            if resolved == null then
                resolved = file::find(name, stdlibProbe)
            if resolved != null and not (resolved in seen) then
                queue += [resolved]

        // 1b. a block `extern "lib"` links its library automatically, in
        //     any file (unlike the `link` keyword it needs no `module`).
        //     A quoted path is relative to the file that names it, as for
        //     `link "x.c"`; when that file does not exist there, the path is
        //     kept as given (relative to the working directory).
        for t in externLinkTargets(src) do
            let tok = t
            if tok.length > 0 and tok[0 to 1] != "-" and tok[0 to 1] != "/" then
                if file::exists(dirOf(p) + "/" + tok) then
                    tok = dirOf(p) + "/" + tok
            if not (tok in links) then
                links += [tok]

        // 2. a module file: merge its siblings, and collect its `link`s
        //    (the parser enforces `link` is module-only too — see
        //    parser.kmm's `parseLink` — this check is just the driver's
        //    own, file-precise way to find the same declarations without
        //    threading the AST back out of the compile).
        let mod = moduleOf(src)
        modPaths += [p]
        modNames += [mod]
        if mod != "" then
            let base = dirOf(p)
            for t in linkTargets(src) do
                // `link name` is already a ready `-lname` token; a quoted
                // `link "path"` (anything not starting `-`) names a
                // companion source file and is resolved against the
                // directory of the module that declared it, unless it is
                // already absolute — so a library can ship its C shim
                // next to its .kmm and still be `import`ed from anywhere.
                let tok = t
                if tok.length > 0 and tok[0 to 1] != "-" and tok[0 to 1] != "/" then
                    tok = base + "/" + tok
                if not (tok in links) then
                    links += [tok]

            // Sibling files declaring the same module — searched through
            // the whole subtree of this file's directory, so the compiler
            // sources may be grouped into folders (frontend/, codegen/, …).
            for sib in sourceTree(dirOf(p)) do
                if not (sib in seen) and not (sib in queue) then
                    let k = 0
                    let sm = ""
                    let known = false
                    while k < #modPaths do
                        if modPaths[k] == sib then
                            sm = modNames[k]
                            known = true
                            break
                        k += 1
                    if not known then
                        sm = moduleOf(file::read_all(sib))
                        modPaths += [sib]
                        modNames += [sm]
                    if sm == mod then
                        queue += [sib]

    return new GatherResult(join(parts, "\n") + "\n", seen, links, starts)

fn newlines(src: string) : int
    let c = 0
    let i = 0
    let n = src.length
    while i < n do
        if src[i] == "\n" then
            c += 1
        i += 1
    return c

// Every `.km` / `.kmm` under `dir`, recursively.
fn sourceTree(dir: string) : [string]
    let out: [string] = []
    for entry in file::list_dir(dir) do
        let full = dir + "/" + entry
        if file::is_dir(full) != 0 then
            for nested in sourceTree(full) do
                out += [nested]
        else if isSource(entry) then
            out += [full]
    return out

// `link <name>` (a bare identifier → the linker flag `-lname`) or
// `link "path/to/file.c"` (a quoted path, kept as-is — relative to
// wherever the compiler is invoked from, exactly like any other gcc
// argument) on lines of `src`, resolved to ready linker tokens.  Mirrors
// how the real keyword is parsed (parser.kmm's `parseLink`).
fn linkTargets(src: string) : [string]
    let out: [string] = []
    let i = 0
    let lineStart = 0
    let n = src.length              // a strlen — measure once, not per char
    while i <= n do
        if i == n or src[i] == "\n" then
            let t = linkOnLine(src[lineStart to i])
            if t != "" then
                out += [t]
            lineStart = i + 1
        i += 1
    return out

fn linkOnLine(line: string) : string
    let a = 0
    while a < line.length and (line[a] == " " or line[a] == "\t") do
        a += 1
    let rest = line[a to line.length]
    if rest.length < 6 then
        return ""
    if rest[0 to 5] != "link " then
        return ""
    let b = 5
    while b < rest.length and rest[b] == " " do
        b += 1
    if b >= rest.length then
        return ""
    if rest[b] == "\"" then
        let s = b + 1
        while s < rest.length and rest[s] != "\"" do
            s += 1
        return rest[(b + 1) to s]
    let s = b
    while s < rest.length and rest[s] != " " and rest[s] != "\r" and rest[s] != "\n" do
        s += 1
    return "-l" + rest[b to s]

// Linker tokens from block-`extern "..."` headers.  A bare name becomes
// `-lname`; a path or flag (contains `/` or `.`, or starts `-`) passes
// through unchanged, exactly like `link "..."`.  Mirrors the parser's
// `externLibIsPath`.
fn externLinkTargets(src: string) : [string]
    let out: [string] = []
    let i = 0
    let lineStart = 0
    let n = src.length              // a strlen — measure once, not per char
    while i <= n do
        if i == n or src[i] == "\n" then
            let t = externOnLine(src[lineStart to i])
            if t != "" then
                out += [t]
            lineStart = i + 1
        i += 1
    return out

fn externOnLine(line: string) : string
    let a = 0
    while a < line.length and (line[a] == " " or line[a] == "\t") do
        a += 1
    let rest = line[a to line.length]
    if rest.length < 9 then
        return ""
    if rest[0 to 7] != "extern " then
        return ""
    let b = 7
    while b < rest.length and rest[b] == " " do
        b += 1
    if b >= rest.length or rest[b] != "\"" then
        return ""
    let s = b + 1
    while s < rest.length and rest[s] != "\"" do
        s += 1
    let name = rest[(b + 1) to s]
    if name.length == 0 then
        return ""
    if name[0] == "-" then
        return name
    let k = 0
    while k < name.length do
        if name[k] == "/" or name[k] == "." then
            return name
        k += 1
    return "-l" + name

// Names on `import <name>` lines, in source order.
fn importNames(src: string) : [string]
    let names: [string] = []
    let i = 0
    let lineStart = 0
    let n = src.length              // a strlen — measure once, not per char
    while i <= n do
        if i == n or src[i] == "\n" then
            let name = importOnLine(src[lineStart to i])
            if name != "" then
                names += [name]
            lineStart = i + 1
        i += 1
    return names

fn importOnLine(line: string) : string
    let a = 0
    while a < line.length and (line[a] == " " or line[a] == "\t") do
        a += 1
    let rest = line[a to line.length]
    if rest.length < 8 then
        return ""
    if rest[0 to 7] != "import " then
        return ""
    let b = 7
    while b < rest.length and rest[b] == " " do
        b += 1
    let s = b
    while s < rest.length and rest[s] != " " and rest[s] != "\r" and rest[s] != "\n" do
        s += 1
    return rest[b to s]
