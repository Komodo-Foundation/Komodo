import file
import km_compiler

void main(args)
    let path = args[2]
    let fileName: string = path or throw "File name not provided"

    if not file::exists(fileName) then
        throw "File not found"

    let source = file::read_all(fileName)

    // Optional 3rd argument selects the code-generation target
    // ("x86", the default, or "stackvm").
    let target = "x86"
    if #args > 3 then
        target = args[3]
    let asm = km_compiler::compile(source, target)

    let outputPath = fileName + ".asm"
    km_compiler::save(asm, outputPath)
