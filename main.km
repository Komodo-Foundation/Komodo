import file
import km_compiler

// Komodo compiler driver.
//
//   source (+ every .kmm it imports, transitively) ──▶ merge ──▶ compile
//
// `import X` is resolved by searching the directory tree of the file
// being compiled for `X.kmm` (via file::find); modules with no Komodo
// source — `console`, `math`, `file`, … — resolve to nothing here and are
// left for the linker.  All resolved sources are concatenated and handed
// to the compiler as one translation unit (namespaces are flat).

void main(args)
    let selfPath = args[0]
    let path = args[1]
    let fileName: string = path or throw "File name not provided"

    if not file::exists(fileName) then
        throw "File not found"

    // Optional 3rd argument selects the code-generation target
    // ("x86", the default, or "stackvm").
    let target = "x86"
    if #args > 2 then
        target = args[2]

    // Optional 4th argument "strict" turns on the analyser's lint-level
    // diagnostics on top of the always-on static type checks.
    let strict = false
    if #args > 3 and args[3] == "strict" then
        strict = true

    // The standard library ships as `.kmm` declaration files under the
    // compiler's own directory (stdlib/console.kmm, …); probe that tree
    // so `import console` resolves no matter where the user's file is.
    // `file::find` walks recursively, so the executable's directory is
    // enough whether `stdlib/` is a subdirectory or holds kmc itself.
    let stdlibProbe = dirOf(selfPath) + "/probe.km"

    let source = gather(fileName, stdlibProbe)
    let asm = km_compiler::compileWith(source, target, strict)

    let outputPath = fileName + ".asm"
    km_compiler::save(asm, outputPath)

fn listHas(xs: [string], v: string) : bool
    for x in xs do
        if x == v then
            return true
    return false

// Everything in `path` before the last "/".  "" when there is none.
fn dirOf(path: string) : string
    let cut = 0 - 1
    let i = 0
    while i < path.length do
        if path[i] == "/" then
            cut = i
        i += 1
    if cut < 0 then
        return "."
    return path[0 to cut]

// Read `rootPath` and every `.kmm` reachable from its `import` lines
// (breadth-first, each file once); return all their sources joined.
// `stdlibProbe` is a throwaway path inside the standard-library
// directory, used as a second search root for unresolved imports.
fn gather(rootPath: string, stdlibProbe: string) : string
    let seen: [string] = []
    let queue: [string] = [rootPath]
    let out = ""

    while #queue > 0 do
        let p = queue[0]
        queue = queue[1 to #queue]
        if listHas(seen, p) then
            continue
        seen += [p]

        let src = file::read_all(p)
        out = out + src + "\n"

        for name in importNames(src) do
            let resolved = file::find(name, rootPath)
            if resolved == null then
                resolved = file::find(name, stdlibProbe)
            if resolved != null and not listHas(seen, resolved) then
                queue += [resolved]

    return out

// Names on `import <name>` lines, in source order.
fn importNames(src: string) : [string]
    let names: [string] = []
    let i = 0
    let lineStart = 0
    while i <= src.length do
        if i == src.length or src[i] == "\n" then
            let name = importOnLine(src[lineStart to i])
            if name != "" then
                names += [name]
            lineStart = i + 1
        i += 1
    return names

fn importOnLine(line: string) : string
    let a = 0
    while a < line.length and (line[a] == " " or line[a] == "\t") do
        a += 1
    let rest = line[a to line.length]
    if rest.length < 8 then
        return ""
    if rest[0 to 7] != "import " then
        return ""
    let b = 7
    while b < rest.length and rest[b] == " " do
        b += 1
    let s = b
    while s < rest.length and rest[s] != " " and rest[s] != "\r" and rest[s] != "\n" do
        s += 1
    return rest[b to s]
