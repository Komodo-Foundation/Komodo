// bind: string.h -m c_string -o c_string.kmm
// bind: ctype.h -m c_ctype -o c_ctype.kmm
import c_string
import c_ctype

void main()
    console.print(c_string::strlen("hello"))
    console.print(c_string::strcmp("abc", "abc"))
    console.print(c_ctype::isdigit(55) != 0)
    console.print(c_ctype::toupper(97))
    console.print(c_ctype::tolower(65))
