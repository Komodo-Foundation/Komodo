// bind: @here@/shapes.h -l shapes.c -m shapes -o shapes.kmm
import shapes

fn visit(v: int, label: string): int
    return v * 10

void main()
    let c = shapes::canvas_new(3, 4)
    console.print(shapes::canvas_area(c))
    console.print(shapes::canvas_name(c))
    shapes::canvas_free(c)
    console.print(shapes::point_dist(copy(new shapes::Point(1.0, 2.0)), copy(new shapes::Point(4.0, 6.0))))
    let p = shapes::point_scale(copy(new shapes::Point(1.5, -2.0)), 2.0)
    console.print(`{p.x} {p.y}`)
    console.print(shapes::size_area(copy(new shapes::Size(2.0, 3.0, 4))))
    let xs = [0, 0, 0, 0]
    shapes::fill_squares(data(xs), #xs)
    console.print(xs)
    console.print(shapes::sum_array(data(xs), #xs))
    console.print(shapes::shapes_count(shapes::SHAPE_RECT))
    console.print(shapes::each(visit, 3))
    console.print(shapes::SH_FLAG_ALL + shapes::COLOR_BLUE + shapes::SH_NEG)
    console.print(shapes::SH_NAME)
    console.print(shapes::SH_PI)
    let m = shapes::raw_alloc(16)
    shapes::raw_free(m)
    let pal = shapes::palette_new()
    console.print(shapes::palette_size(pal))
    shapes::palette_free(pal)
    console.print(shapes::sh_counter)
    shapes::sh_counter += 1
    console.print(shapes::sh_counter)
