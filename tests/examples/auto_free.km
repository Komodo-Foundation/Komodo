// Automatic memory.  Every struct / array lives on the collected heap and
// is reclaimed once nothing refers to it — so this loop allocates a
// million short-lived points without growing the heap, and nothing is
// ever freed by hand.

import console

shared struct Point
    x: int = 0
    y: int = 0

void main()
    let acc = 0
    let i = 0
    while i < 1000000 do
        let p = new Point(i, i)          // garbage after each iteration
        acc = acc + (p.x - p.y)
        i = i + 1
    console.print("acc =", acc)

    let scratch = [0, 0, 0]
    let k = 0
    while k < 4 do
        scratch = [k, k + 1, k + 2]      // previous buffer becomes garbage
        k = k + 1
    console.print("scratch sum =", scratch[0] + scratch[1] + scratch[2])
