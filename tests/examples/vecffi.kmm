module vecffi

// Mirror structs for vecffi.c — field-for-field, `f32` for C `float`.
link "vecffi.c"

struct Vec2
    x: f32 = 0.0
    y: f32 = 0.0

struct Vec3
    x: f32 = 0.0
    y: f32 = 0.0
    z: f32 = 0.0

struct Rgba
    r: u8 = 0
    g: u8 = 0
    b: u8 = 0
    a: u8 = 255

struct Mix
    id: i32 = 0
    w: f32 = 0.0

struct Big
    a: float = 0.0
    b: float = 0.0
    c: float = 0.0
    n: int = 0

extern fn vf_scale2(v: Vec2, k: f32): Vec2
extern fn vf_dot3(a: Vec3, b: Vec3): f32
extern fn vf_cross3(a: Vec3, b: Vec3): Vec3
extern fn vf_pack(c: Rgba): int
extern fn vf_invert(c: Rgba): Rgba
extern fn vf_mix(m: Mix): float
extern fn vf_big(pre: int, b: Big, post: int): float
