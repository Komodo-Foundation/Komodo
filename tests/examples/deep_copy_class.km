// `copy(x)` on a constructor-based class is a deep copy too: the nested
// object and the array field belong to the copy, so changing them does not
// touch the original.  The constructor is not run for the copy.

import console

shared struct Inner
    tag: int = 0

class Box
public
    constructor(label: string, inner: Inner)
        m_label = label
        m_inner = inner
        console.print("constructed", label)

    mut relabel(s: string)
        m_label = s
        m_inner.tag = m_inner.tag + 10
        m_nums[0] = 99

    fn describe(): string
        return m_label + " tag=" + string(m_inner.tag) + " nums0=" + string(m_nums[0])
private
    m_label: string = ""
    m_inner: Inner = new Inner(0)
    m_nums: [int] = [1, 2]

void main()
    let box = new Box("orig", new Inner(1))
    let dup = copy(box)
    dup.relabel("dup")
    console.print(box.describe())
    console.print(dup.describe())
