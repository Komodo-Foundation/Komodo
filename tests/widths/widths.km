void t_u8()
    let vs: [u8] = [0, 1, 2, 127, 128, 200, 254, 255]
    for a in vs do
        for b in vs do
            print(a + b)
            print(a - b)
            print(a * b)
            print(a & b)
            print(a | b)
            print(a ^ b)
            print(-a)
            print(a << 3)
            print(a >> 2)
            print(a << (b & 3))
            print(a >> (b & 3))
            print(a < b)
            print(a <= b)
            print(a > b)
            print(a >= b)
            print(a == b)
            print(a != b)
            let w = a
            w += b
            print(w)
            w *= b
            print(w)
            w -= a
            print(w)
            w = w + 1
            print(w)
            if b != 0 then
                print(a / b)
                print(a % b)

