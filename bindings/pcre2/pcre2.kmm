// pcre2.kmm -- Komodo bindings for /usr/include/pcre2.h
//
// GENERATED by tools/km-bind. The helpers at the end of this file are hand-written.
//   command: km-bind /usr/include/pcre2.h -p libpcre2-8 -D PCRE2_CODE_UNIT_WIDTH=8 -m pcre2 -o bindings/pcre2/pcre2.kmm
//
// Conventions used in this file:
//   * Komodo `int` is 64-bit. C int/long/size_t/uint*_t/int*_t/char map to it. A C
//     `int` RETURN is not sign-extended (negative results can read as 2^32+n);
//     such functions carry a note. Arguments are fine.
//   * double -> float, float -> f32, bool -> bool, const char * -> string
//     (a returned char * is `string?`, test it against null).
//   * pointers to structs are opaque handles (`extern type`), compared with
//     `== 0` for NULL; `void *` is `<module>_Ptr` when returned, `int` when passed
//     (so it accepts any handle or data(arr)).
//   * scalar pointers (int *, double *, ...) are `int`: pass data(arr); the
//     array holds 64-bit slots, so only 64-bit C element types line up.
//   * structs by value are mirrored as Komodo structs; pass copy(x).
//   * callbacks (function pointers) are passed as a bare Komodo function name.

