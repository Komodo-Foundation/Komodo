// ── TrueType fonts ───────────────────────────────────────────────────
// Font (48 B) and Texture2D (20 B) are MEMORY-class structs.  Passing them
// *by value* works with the normal FFI; *returning* one uses SysV's hidden
// result pointer in rdi, so LoadFontEx is declared with that pointer as an
// explicit first argument and rl_load_font rebuilds the struct from it.
struct Texture2D
    id: u32 = 0
    width: i32 = 0
    height: i32 = 0
    mipmaps: i32 = 0
    format: i32 = 0

struct Font
    baseSize: i32 = 0
    glyphCount: i32 = 0
    glyphPadding: i32 = 0
    texId: u32 = 0
    texWidth: i32 = 0
    texHeight: i32 = 0
    texMipmaps: i32 = 0
    texFormat: i32 = 0
    recs: int = 0
    glyphs: int = 0

extern fn   LoadFontEx(sret: int, fileName: string, fontSize: int, codepoints: int, codepointCount: int): int
extern void DrawTextEx(font: Font, text: string, position: Vector2, fontSize: f32, spacing: f32, tint: Color)
extern fn   MeasureTextEx(font: Font, text: string, fontSize: f32, spacing: f32): Vector2
extern void SetTextureFilter(texture: Texture2D, filter: int)
extern fn   FileExists(fileName: string): int
extern void DrawRectangleRounded(rec: Rectangle, roundness: f32, segments: int, color: Color)
extern void DrawRectangleRoundedLines(rec: Rectangle, roundness: f32, segments: int, color: Color)
extern void DrawRectangleGradientV(posX: int, posY: int, width: int, height: int, top: Color, bottom: Color)
extern void DrawCircleV(center: Vector2, radius: f32, color: Color)
extern void DrawLineEx(startPos: Vector2, endPos: Vector2, thick: f32, color: Color)
extern void DrawCircleLinesV(center: Vector2, radius: f32, color: Color)
extern void DrawRing(center: Vector2, innerRadius: f32, outerRadius: f32, startAngle: f32, endAngle: f32, segments: int, color: Color)
extern void DrawTriangle(v1: Vector2, v2: Vector2, v3: Vector2, color: Color)
extern void DrawRectangleLinesEx(rec: Rectangle, lineThick: f32, color: Color)
extern void DrawEllipseLines(centerX: int, centerY: int, radiusH: f32, radiusV: f32, color: Color)

let TEXTURE_FILTER_BILINEAR be 1

// Load a TTF at `size` px with bilinear filtering.  baseSize == 0 means
// the file could not be loaded.
mut fn rl_load_font(path: string, size: int): Font
    let buf: [int] = [0, 0, 0, 0, 0, 0]
    LoadFontEx(data(buf), path, size, 0, 0)
    let f = new Font()
    f.baseSize = buf[0] & 4294967295
    f.glyphCount = (buf[0] >> 32) & 4294967295
    f.glyphPadding = buf[1] & 4294967295
    f.texId = (buf[1] >> 32) & 4294967295
    f.texWidth = buf[2] & 4294967295
    f.texHeight = (buf[2] >> 32) & 4294967295
    f.texMipmaps = buf[3] & 4294967295
    f.texFormat = (buf[3] >> 32) & 4294967295
    f.recs = buf[4]
    f.glyphs = buf[5]
    if f.texId != 0 then
        SetTextureFilter(copy(new Texture2D(f.texId, f.texWidth, f.texHeight, f.texMipmaps, f.texFormat)), TEXTURE_FILTER_BILINEAR)
    return f

fn rl_rect(x: f32, y: f32, w: f32, h: f32): Rectangle
    return new Rectangle(x, y, w, h)

// ── UI text helpers (fonts live here so other modules never have to
// name the Font type).  Weight 0 = regular, 1 = bold.  Falls back to
// the built-in bitmap font if the TTFs are missing.
let rl_font_reg = new Font()
let rl_font_bold = new Font()
let rl_font_big = new Font()
let rl_font_ok = 0

void rl_ui_fonts(regular: string, bold: string)
    if (FileExists(regular) & 255) != 0 then
        rl_font_reg = rl_load_font(regular, 22)
        rl_font_big = rl_load_font(regular, 44)
        rl_font_bold = rl_font_reg
        rl_font_ok = 1
    if (FileExists(bold) & 255) != 0 and rl_font_ok == 1 then
        rl_font_bold = rl_load_font(bold, 22)

void rl_text(t: string, x: int, y: int, size: int, weight: int, r: int, g: int, b: int, a: int)
    if rl_font_ok == 0 then
        DrawText(t, x, y, size - 3, copy(rl_rgba(r, g, b, a)))
        return
    if size > 20 then
        DrawTextEx(copy(rl_font_big), t, copy(rl_vec2(x * 1.0, y * 1.0)), size * 1.0, 0.0, copy(rl_rgba(r, g, b, a)))
    else if weight == 1 then
        DrawTextEx(copy(rl_font_bold), t, copy(rl_vec2(x * 1.0, y * 1.0)), size * 1.0, 0.0, copy(rl_rgba(r, g, b, a)))
    else
        DrawTextEx(copy(rl_font_reg), t, copy(rl_vec2(x * 1.0, y * 1.0)), size * 1.0, 0.0, copy(rl_rgba(r, g, b, a)))

mut fn rl_measure(t: string, size: int, weight: int): int
    if rl_font_ok == 0 then
        return MeasureText(t, size - 3)
    if size > 20 then
        let m = MeasureTextEx(copy(rl_font_big), t, size * 1.0, 0.0)
        return int(m.x)
    if weight == 1 then
        let m2 = MeasureTextEx(copy(rl_font_bold), t, size * 1.0, 0.0)
        return int(m2.x)
    let m3 = MeasureTextEx(copy(rl_font_reg), t, size * 1.0, 0.0)
    return int(m3.x)

// Rounded rectangle in pixels with a pixel corner radius.
void rl_round(x: int, y: int, w: int, h: int, radius: int, r: int, g: int, b: int, a: int)
    let m = w
    if h < m then
        m = h
    if m <= 0 then
        return
    let rn = (radius * 2.0) / (m * 1.0)
    if rn > 1.0 then
        rn = 1.0
    DrawRectangleRounded(copy(rl_rect(x * 1.0, y * 1.0, w * 1.0, h * 1.0)), rn, 6, copy(rl_rgba(r, g, b, a)))

void rl_round_line(x: int, y: int, w: int, h: int, radius: int, r: int, g: int, b: int, a: int)
    let m = w
    if h < m then
        m = h
    if m <= 0 then
        return
    let rn = (radius * 2.0) / (m * 1.0)
    if rn > 1.0 then
        rn = 1.0
    DrawRectangleRoundedLines(copy(rl_rect(x * 1.0, y * 1.0, w * 1.0, h * 1.0)), rn, 6, copy(rl_rgba(r, g, b, a)))
