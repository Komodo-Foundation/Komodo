// ── 3D drawing ──────────────────────────────────────────────────────
// Every `f32` below is a C `float` — declaring it `float` (a 64-bit
// double) would put the wrong bit pattern in the register.
extern void DrawCube(position: Vector3, width: f32, height: f32, length: f32, color: Color)
extern void DrawCubeWires(position: Vector3, width: f32, height: f32, length: f32, color: Color)
extern void DrawSphere(centerPos: Vector3, radius: f32, color: Color)
extern void DrawSphereEx(centerPos: Vector3, radius: f32, rings: int, slices: int, color: Color)
extern void DrawPlane(centerPos: Vector3, size: Vector2, color: Color)
extern void DrawLine3D(startPos: Vector3, endPos: Vector3, color: Color)
extern void DrawTriangle3D(v1: Vector3, v2: Vector3, v3: Vector3, color: Color)
extern void DrawSphereWires(centerPos: Vector3, radius: f32, rings: int, slices: int, color: Color)
extern void DrawPoint3D(position: Vector3, color: Color)
extern void DrawCylinderEx(startPos: Vector3, endPos: Vector3, startRadius: f32, endRadius: f32, sides: int, color: Color)
extern void DrawCircle3D(center: Vector3, radius: f32, rotationAxis: Vector3, rotationAngle: f32, color: Color)
extern void DrawGrid(slices: int, spacing: f32)

// rlgl (linked in with raylib) — render-state + the immediate-mode
// batch.  Building a mesh with rlVertex3f between one rlBegin/rlEnd is
// far cheaper than a DrawTriangle3D call per face (no struct marshalling
// at all), which is what keeps a subdivided model interactive.
extern void rlDisableBackfaceCulling()
extern void rlEnableBackfaceCulling()
extern void rlDrawRenderBatchActive()
extern void rlSetLineWidth(width: f32)
extern void rlBegin(mode: int)
extern void rlEnd()
extern void rlVertex3f(x: f32, y: f32, z: f32)
extern void rlNormal3f(x: f32, y: f32, z: f32)
extern void rlColor4ub(r: int, g: int, b: int, a: int)
extern fn   rlCheckRenderBatchLimit(vCount: int): int

// Textures straight through rlgl (Texture2D/Image are by-value structs
// larger than 16 bytes; these take/return plain ids and pointers).
// `data` is `data(arr)` of a Komodo [int] holding packed RGBA8 pixels.
extern fn   rlLoadTexture(data: int, width: int, height: int, format: int, mipmapCount: int): int
extern void rlUnloadTexture(id: int)
extern void rlSetTexture(id: int)
extern void rlTexCoord2f(x: f32, y: f32)

let PIXELFORMAT_UNCOMPRESSED_R8G8B8A8 be 7

let RL_LINES be 1
let RL_TRIANGLES be 4
let RL_QUADS be 7

