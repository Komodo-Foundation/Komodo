module raylib

// raylib bindings — **shim-free**.  `import raylib` plus the one `link`
// line below is all it takes; `komodo` runs `pkg-config raylib` for the
// include/lib paths and transitive `-l` flags automatically.
//
// This binding calls raylib's real entry points directly.  It relies on
// two Komodo features that remove the C shim the old binding needed:
//
//   • `f32` — a 32-bit float type.  raylib's `Vector*` / `Rectangle`
//     fields are C `float`, so the mirror structs below declare `f32`.
//     Inside Komodo an `f32` is still a 64-bit double; it is only
//     narrowed at the FFI boundary.
//
//   • `copy(x)` in an `extern` argument position — passes the struct
//     *by value*, marshalling Komodo's one-slot-per-field layout into
//     the tight C layout and placing it per the System V AMD64 ABI
//     (Vector2 → one XMM, Vector3 → two XMM, Color → one GP reg,
//     Camera3D → the stack).  A struct returned by an `extern fn`
//     (Vector2, Vector3, Color, …) is unpacked back into a fresh object.
//
// So a call reads almost exactly like the C one:
//
//     import raylib
//     raylib::InitWindow(1280, 720, "hi")
//     raylib::DrawSphere(copy(raylib::rl_vec3(0.0, 1.0, 0.0)), 0.5, copy(raylib::rl_rgb(230, 120, 90)))
//
// The `rl_vec* / rl_rgb* / rl_camera3d` helpers build the mirror structs;
// `copy(new raylib::Vector3(...))` works too.  Only aggregates of 192
// bytes or less, built from scalar fields, cross by value — that covers
// the whole draw / input surface here.  `Matrix` and mesh/model handles
// still need their own helpers and are left out.

link raylib

// ── mirror structs (field-for-field with <raylib.h>) ─────────────────
struct Vector2
    x: f32 = 0.0
    y: f32 = 0.0

struct Vector3
    x: f32 = 0.0
    y: f32 = 0.0
    z: f32 = 0.0

struct Vector4
    x: f32 = 0.0
    y: f32 = 0.0
    z: f32 = 0.0
    w: f32 = 0.0

struct Color
    r: u8 = 0
    g: u8 = 0
    b: u8 = 0
    a: u8 = 255

struct Rectangle
    x: f32 = 0.0
    y: f32 = 0.0
    width: f32 = 0.0
    height: f32 = 0.0

// raylib's `Camera3D` is `{ Vector3 position; Vector3 target; Vector3 up;
// float fovy; int projection; }` — 44 bytes, no padding (all 4-byte
// fields).  Flattened here because a by-value struct can't nest another
// struct handle.  Field order and widths match exactly, so the 44 bytes
// marshal 1:1.
struct Camera3D
    px: f32 = 0.0
    py: f32 = 0.0
    pz: f32 = 0.0
    tx: f32 = 0.0
    ty: f32 = 0.0
    tz: f32 = 0.0
    ux: f32 = 0.0
    uy: f32 = 1.0
    uz: f32 = 0.0
    fovy: f32 = 60.0
    projection: i32 = 0        // 0 = CAMERA_PERSPECTIVE, 1 = ORTHOGRAPHIC

// ── constructors / helpers ──────────────────────────────────────────
fn rl_vec2(x: f32, y: f32): Vector2
    return new Vector2(x, y)

fn rl_vec3(x: f32, y: f32, z: f32): Vector3
    return new Vector3(x, y, z)

fn rl_rgb(r: int, g: int, b: int): Color
    return new Color(r, g, b, 255)

fn rl_rgba(r: int, g: int, b: int, a: int): Color
    return new Color(r, g, b, a)

mut rl_camera3d(px: f32, py: f32, pz: f32, tx: f32, ty: f32, tz: f32, fovy: f32): Camera3D
    let c = new Camera3D()
    c.px = px
    c.py = py
    c.pz = pz
    c.tx = tx
    c.ty = ty
    c.tz = tz
    c.fovy = fovy
    return c

